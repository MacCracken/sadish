# @public — sadish rasterizer: path -> coverage buffer -> blit.
#
# raster.cyr — an SdCanvas owns a width*height coverage buffer (one byte
# of anti-aliased coverage per pixel, 0..255). The fill entry takes a
# flattened path and a winding rule and accumulates coverage; the blit
# entry hands that coverage to a destination framebuffer (the kernel
# blit#39 on AGNOS, or a host framebuffer under test).
#
# The coverage buffer is a separate, format-neutral stage on purpose: a
# consumer (canvas/compositing/SVG/UI) chooses how to turn coverage +
# a paint (solid color / gradient) into destination pixels. sadish's job
# ends at coverage + a reference solid blit.

# ---- winding rules ----------------------------------------------
var SD_FILL_EVEN_ODD = 0;
var SD_FILL_NONZERO  = 1;

# ---- coverage engines -------------------------------------------
# SD_AA_SUBSCANLINE — the 0.4.0 engine: analytic in x, 4 sub-scanlines in y. THE DEFAULT, and
#   byte-identical forever: agnos's GPU rasteriser (tests/gpu/refagree.cyr) is gated on it.
# SD_AA_AREA — exact in both axes (signed-area cell accumulation, src/coverage.cyr). Opt-in per
#   canvas with sd_canvas_set_aa.
var SD_AA_SUBSCANLINE = 0;
var SD_AA_AREA        = 1;

# ================================================================
# SdCanvas (48 bytes):
#   +0:  width      (i64 — pixels)
#   +8:  height     (i64 — pixels)
#   +16: coverage   (ptr — owned width*height bytes, one coverage per px)
#   +24: stride     (i64 — bytes per row OF THE COVERAGE BUFFER; == width for the packed buffer)
#   +32: clip       (ptr — top SdClip node, or 0 = unclipped)
#   +40: aa         (i64 — coverage engine, SD_AA_SUBSCANLINE | SD_AA_AREA)
# ⛔⛔ TWO PITCHES, AND ONLY ONE OF THEM IS THE STRIDE. The COVERAGE buffer at +16 is addressed
# `y * stride + x` — it may be a window into a wider buffer. The CLIP MASK hanging off +32 is a
# sadish-owned, never-wrapped `w * h` block and is addressed `y * w + x` — PACKED, ALWAYS, whatever
# the canvas stride says. Every producer already wrote it packed (sd_canvas_clip_push_rect,
# sd_clip_push_mask's intersection, the temp canvas behind sd_canvas_clip_push_path); since 0.6.1
# the three consumers read it packed too (sd_fill_impl, _sd_area_fill, _sd_sb_flush). Byte-identical
# on every canvas sd_canvas_new makes, where stride == width — the gate is programs/clip_pitch_test.cyr,
# which hand-builds the header sd_canvas_new cannot. Closed
# docs/development/issues/2026-09-15-clip-masks-written-packed-but-read-by-canvas-stride.md.
# ⚠ The canvas was 40 bytes through 0.5.5. Nothing in dhancha, rekha or agnos builds one by hand
# (checked by grep) — sd_canvas_new is the only constructor. But every canvas — and the temp mask
# canvas behind each sd_canvas_clip_push_path — now costs 8 B more on sd_alloc, which moves exact
# figures consumers have MEASURED (dhancha's text_arena_test, same checks passing: a 12-label frame
# 417,056 -> 417,144 B, its 64 KiB-arena spill 351,520 -> 351,608 B).
# ================================================================
var SD_CANVAS_WIDTH_OFFSET    = 0;
var SD_CANVAS_HEIGHT_OFFSET   = 8;
var SD_CANVAS_COVERAGE_OFFSET = 16;
var SD_CANVAS_STRIDE_OFFSET   = 24;
var SD_CANVAS_CLIP_OFFSET     = 32;
var SD_CANVAS_AA_OFFSET       = 40;
var SD_CANVAS_SIZE            = 48;

# @public — allocate a w*h canvas with a zeroed coverage buffer.
# Returns the SdCanvas ptr, or 0 on OOM / bad dimensions.
fn sd_canvas_new(w, h): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    var cv = sd_alloc(SD_CANVAS_SIZE);
    if (cv == 0) { return 0; }
    var n = w * h;
    var cov = sd_alloc(n);
    if (cov == 0) { return 0; }
    # Zero the coverage buffer (alloc is not guaranteed zeroed).
    var i = 0;
    while (i < n) {
        store8(cov + i, 0);
        i = i + 1;
    }
    store64(cv + SD_CANVAS_WIDTH_OFFSET, w);
    store64(cv + SD_CANVAS_HEIGHT_OFFSET, h);
    store64(cv + SD_CANVAS_COVERAGE_OFFSET, cov);
    store64(cv + SD_CANVAS_STRIDE_OFFSET, w);
    store64(cv + SD_CANVAS_CLIP_OFFSET, 0);
    store64(cv + SD_CANVAS_AA_OFFSET, SD_AA_SUBSCANLINE);
    return cv;
}

# ---- accessors --------------------------------------------------
# @public
fn sd_canvas_width(cv): i64    { return load64(cv + SD_CANVAS_WIDTH_OFFSET); }
# @public
fn sd_canvas_height(cv): i64   { return load64(cv + SD_CANVAS_HEIGHT_OFFSET); }
# @public
fn sd_canvas_coverage(cv): i64 { return load64(cv + SD_CANVAS_COVERAGE_OFFSET); }
# @public
fn sd_canvas_stride(cv): i64   { return load64(cv + SD_CANVAS_STRIDE_OFFSET); }
# @public — the canvas's coverage engine (SD_AA_SUBSCANLINE unless sd_canvas_set_aa changed it).
fn sd_canvas_aa(cv): i64       { return load64(cv + SD_CANVAS_AA_OFFSET); }

# @public — choose the coverage engine every fill into `cv` uses: sd_canvas_fill_path,
# sd_canvas_fill_union (and so sd_canvas_stroke_path), and the mask sd_canvas_clip_push_path
# builds. SD_AA_SUBSCANLINE (the default) or SD_AA_AREA. Coverage already in the buffer is not
# touched. Returns SADISH_OK, or SADISH_ERR_BOUNDS for a null canvas or an unknown mode (the
# canvas is left unchanged).
fn sd_canvas_set_aa(cv, mode): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (mode != SD_AA_SUBSCANLINE) {
        if (mode != SD_AA_AREA) { return SADISH_ERR_BOUNDS; }
    }
    store64(cv + SD_CANVAS_AA_OFFSET, mode);
    return SADISH_OK;
}

# Coverage of one pixel (0 if out of bounds).
fn sd_canvas_coverage_at(cv, x, y): i64 {
    var w = load64(cv + SD_CANVAS_WIDTH_OFFSET);
    var h = load64(cv + SD_CANVAS_HEIGHT_OFFSET);
    if (x < 0) { return 0; }
    if (y < 0) { return 0; }
    if (x >= w) { return 0; }
    if (y >= h) { return 0; }
    var cov = load64(cv + SD_CANVAS_COVERAGE_OFFSET);
    var stride = load64(cv + SD_CANVAS_STRIDE_OFFSET);
    return load8(cov + y * stride + x);
}

# @public — zero the canvas's WINDOW of the coverage buffer (reuse a canvas across draws).
# ⛔ ROW BY ROW AT THE STRIDE, `w` bytes a row — not one flat `w * h` run. The coverage buffer is
# the strided side of the canvas (see the layout note): a flat run over a wrapped canvas would
# zero another row's padding and leave the window's last rows dirty. Byte-identical on every
# canvas sd_canvas_new makes, where stride == width and the two walks are the same 70 bytes in the
# same order. Gated by programs/clip_pitch_test.cyr.
fn sd_canvas_clear(cv): i64 {
    var w = load64(cv + SD_CANVAS_WIDTH_OFFSET);
    var h = load64(cv + SD_CANVAS_HEIGHT_OFFSET);
    var cov = load64(cv + SD_CANVAS_COVERAGE_OFFSET);
    var stride = load64(cv + SD_CANVAS_STRIDE_OFFSET);
    var y = 0;
    while (y < h) {
        var x = 0;
        while (x < w) {
            store8(cov + y * stride + x, 0);
            x = x + 1;
        }
        y = y + 1;
    }
    return SADISH_OK;
}

# ---- process-lifetime fill/stroke scratch (0.5.5) ---------------
# ⭐ Before 0.5.5 every sd_fill_impl call allocated ectx + edges + fbuf + fctx + accrow + cross
# FRESH, and every sd_canvas_stroke_path call its run + fbuf + fctx — on a bump allocator with no
# free(). MEASURED on 0.5.4, 8x8 canvas, one call: fill 327,824 B, stroke of a closed 4-vertex
# rect 2,789,016 B (8 fill_union passes underneath it), per call, forever. dhancha filed it
# (2026-09-13, scalable text allocates per call outside the frame arena); crab's zero-heap
# frame gate is what it blocks. The capacity was FIXED (SD_FLATTEN_CAP) and did not depend on
# the path, so it is one process-wide set, allocated lazily ONCE and reused by every call (and
# since 0.6.1 grown in place when a path outgrows it — GROWTH, below).
#
# ⛔ FROM THE GLOBAL `alloc`, NEVER `sd_alloc`. A consumer's hook is typically a per-frame arena
# that gets reset; a scratch drawn from it would be dangling on the second frame. The scratch
# outlives every hook by construction, so it must come from the one allocator that never rewinds.
# ⇒ This is also why fill/stroke are NOT on the seam's "everything" promise (see src/alloc.cyr):
# their one-time cost lands on the global heap at the first call, and never again.
#
# ⛔ TWO SETS, NOT ONE. sd_canvas_stroke_path holds `run` LIVE across the sd_canvas_fill_union
# calls sd_stroke_run makes, and each of those runs sd_fill_impl, which fills its own fbuf/fctx.
# Sharing a fbuf between the two would have the fill's flatten overwrite the stroke's run
# mid-stroke. The stroker's run/fbuf/fctx are therefore its own globals, and non-aliasing is
# visible in the names rather than reasoned about per call.
#
# ⚠ SINGLE-THREADED ENTRY POINTS, said out loud. The rasterizer never had a lock anywhere and was
# never thread-safe; a shared scratch makes sd_fill_impl / sd_canvas_stroke_path explicitly
# single-threaded. Checked: every consumer in the ecosystem (dhancha, rekha, agnos's refagree
# test) rasterizes from one thread.
#
# Flatten MID-POINTS (sd_pt_mid -> sd_point_new) are deliberately NOT here: they are
# proportional to the curve work, not fixed-capacity, so they stay on the seam and the hook
# decides where they live (MEASURED ON 0.7.1, 8x8 canvas, warm scratch: the CHANGELOG's one-quad
# fill — moveto (0,0), quadto ctrl (8,0) → (8,8), lineto back, closed — costs 48 B of them = 3
# EMITTED mid-points x 16 B in 3 allocations, and the same 48 B on the next identical call; a
# single quad only ever costs 16 x (2^d - 1) B because both de Casteljau halves carry the parent's
# second difference / 4 and so split to the same depth).
# ⚠ THAT COEFFICIENT WAS 48, NOT 16, THROUGH 0.7.0, and the figure above was 144 B: the recursion
# allocated every subdivision node's three mid-points on the seam and threw two of them away. 0.7.1
# takes the throwaways onto a fixed per-depth scratch (src/path.cyr), so only EMITTED points are
# allocated — rekha's filing, and the reason any older MEASURED mid-point figure reads 3x high.
var _sd_fill_ectx = 0;         # edge builder ctx (24 B): +0 edges  +8 count  +16 cap
var _sd_fill_edges = 0;        # _sd_fill_edges_cap * 32 — GROWS (0.6.1)
var _sd_fill_edges_cap = 0;    # edges the current block holds (SD_FLATTEN_CAP until a path needs more)
var _sd_fill_trunc = 0;        # 1 if THIS fill's edge list dropped an edge (a growth failed)
var _sd_fill_fbuf = 0;         # SD_FLATTEN_CAP * 8 — flatten output for one curve verb (FIXED, below)
var _sd_fill_fctx = 0;         # flatten ctx (24 B)
var _sd_fill_cross = 0;        # _sd_fill_cross_cap * 16 — (x, dir) crossings — GROWS (0.6.1)
var _sd_fill_cross_cap = 0;    # >= every edge list that is walked: the fill's AND the stroke batch's
var _sd_fill_accrow = 0;       # w * 8 — per-row 16.16 accumulator, sized to the widest canvas seen
var _sd_fill_accrow_cap = 0;   # pixels the current accrow block can hold
var _sd_stroke_run = 0;        # _sd_stroke_run_cap * 8 — the stroker's polyline run — GROWS (0.6.1)
var _sd_stroke_run_cap = 0;    # points the current run block holds
var _sd_stroke_fbuf = 0;       # SD_FLATTEN_CAP * 8 — the stroker's OWN flatten output (FIXED)
var _sd_stroke_fctx = 0;       # the stroker's OWN flatten ctx (24 B)
# ⚠ The SD_AA_AREA engine's accumulator (_sd_area_acc, (w+1)*8) is the same kind of scratch but
# lives with its engine in src/coverage.cyr, allocated on the first AREA fill — NOT here, so a
# process that never opts in pays nothing and the first-fill figures below stay exact.
#
# ⭐ GROWTH (0.6.1). Through 0.6.0 the edge list, the crossings and the stroker's run held
# SD_FLATTEN_CAP = 8,192 entries and DROPPED the rest: a path of more edges filled wrong (its
# contours left open), a longer run stroked only its first 8,192 points. Now each grows by
# doubling when full — from the GLOBAL alloc, for the reason above — copying its live entries and
# abandoning the old block (no free()), exactly like _sd_fill_accrow_for. The INITIAL capacities
# are unchanged, so every first-use figure stays exact, and growth is monotone: a process pays for
# its largest path once, then 0 B a call. MEASURED (programs/grow_edges_test.cyr): the first fill
# past 8,192 edges costs 786,432 B (edges 16,384 * 32 + crossings 16,384 * 16); a repeat 0 B.
# ⚠ The two per-curve buffers (_sd_fill_fbuf, _sd_stroke_fbuf) stay FIXED: they hold ONE curve
# verb's flattening, which sd_flatten_quad / sd_flatten_cubic bound by 2^SD_FLATTEN_MAX_DEPTH = 256
# points (every leaf of the depth-8 recursion emits exactly one) — a 32nd of their capacity.
# ⚠ OUT OF MEMORY: a failed growth keeps the old block and drops, as 0.6.0 did, and RECORDS it
# (_sd_fill_trunc here; _sd_sb_trunc / _sd_run_trunc in stroke.cyr) — so the SD_AA_AREA dispatch,
# which streaks on an open contour, falls back only for a list that is really incomplete.

# ================================================================
# THE GROWTH CEILING — the largest single growth request, in bytes, that is attempted. A request
# above it fails exactly as `alloc` failing would: the store keeps its old block, drops what does
# not fit, and RECORDS the truncation (the flags above), which is 0.6.0's behaviour for a path this
# large. 0 = no bound of sadish's own (alloc itself refuses over 2 GiB).
#
# ⛔⛔ WHY THIS IS BOUNDED BY DEFAULT, AND WHY THAT IS A TRADE AND NOT A FREE WIN. Lifting
# SD_FLATTEN_CAP turned "a path over 8,192 edges renders WRONG" into "a path over 8,192 edges costs
# whatever it costs" — and the scratch is process-lifetime on an allocator with no free(), so ONE
# pathological path makes a process keep that memory for the rest of its life. MEASURED on this
# tree, rekha's hostile repro (4,096 maximally non-flat quads, one sd_canvas_fill_path on 64x64,
# the shape a font file can carry — docs/development/issues/2026-09-15-flatten-keeps-subdividing-…):
# unbounded, it grows the edge list and crossings to 1,048,576 entries and the fill costs
# 150,602,312 B of global heap, permanently. At the default below the same fill keeps its first
# 262,144 edges, flags the truncation, and the AREA dispatch falls back to the sub-scanline loop
# (which paints nothing past a row's last crossing) rather than streaking on an open contour.
# ⇒ Over the ceiling, sadish chooses BOUNDED MEMORY AND A FLAGGED, DEGRADED FILL over correct
# output at any price. A consumer that renders its own trusted geometry and wants the old
# behaviour sets 0; a consumer that fills untrusted outlines (rekha → dhancha → crab draw glyph
# paths from font files, every frame) should keep a bound.
# ⚠ THE PEAK IS ABOUT TWICE THE CEILING PER STORE. Growth doubles and abandons the old block, so a
# store that reaches the ceiling has also paid for every smaller block below it (8 MiB + 4 + 2 + …
# ≈ 16 MiB). The ceiling bounds one REQUEST, not a process's total.
# ⚠ It is also what lets programs/grow_edges_test.cyr drive the out-of-memory path a real failure
# takes — no honest test reaches alloc's own limit, which is 67 M edges.
# ================================================================
# 8 MiB: 262,144 edges (32 B each), 524,288 crossings (16 B) or 1,048,576 run points (8 B) in one
# request — far past any legitimate path this stack draws, and short of the hostile repro above.
var SD_GROW_LIMIT_DEFAULT = 8388608;
var _sd_grow_limit = 8388608;

# @public — set the growth ceiling in bytes (0 = unbounded); returns the PREVIOUS value, so a caller
# can scope it. SD_GROW_LIMIT_DEFAULT restores the default.
fn sd_grow_limit_set(n): i64 {
    var prev = _sd_grow_limit;
    if (n < 0) { return prev; }
    _sd_grow_limit = n;
    return prev;
}

# @public — the current growth ceiling in bytes (0 = unbounded).
fn sd_grow_limit_get(): i64 {
    return _sd_grow_limit;
}

# `alloc(n)` for a growth of the process-lifetime scratch, subject to _sd_grow_limit. 0 on failure.
fn _sd_grow_alloc(n): i64 {
    if (_sd_grow_limit > 0) {
        if (n > _sd_grow_limit) { return 0; }
    }
    return alloc(n);
}

# Allocate the fixed-capacity scratch once (idempotent). Called at the top of sd_fill_impl and
# sd_canvas_stroke_path; a second call is one load + compare. MEASURED one-time cost: 589,896 B
# (fill 458,800 + stroke 131,096), plus accrow on first use (w*8: 64 B at 8 px, 6,080 B at 760).
# ⇒ After it, a straight-line fill costs the heap 0 B (MEASURED, 8x8 and 760x300); a stroke of the
# closed 8x8 rect 34,432 B, all of it paths + points on the seam (was 2,789,016 B).
#
# Returns 1 when the scratch is ready, 0 when a block was refused.
# ⛔ ALL OR NOTHING, AND `_sd_fill_ectx != 0` IS THE FLAG. Through 0.7.0 the eight blocks were
# stored straight into the globals unchecked, so a refusal of the SECOND one left ectx non-zero and
# edges 0 — this function never ran again and EVERY fill for the rest of the process stored through
# a null edge list. The blocks now land in locals and are published together, so a partial set is
# abandoned (the bump allocator has no free()) and the next call retries from scratch.
# ⚠ These come from the GLOBAL `alloc`, never sd_alloc (the rule at the top of this block), so no
# consumer hook can refuse them: `alloc` refuses only over ALLOC_MAX = 2 GiB or when brk fails, and
# the largest block here is 262,144 B. ⇒ The one honest way to drive this path is the CAPACITY —
# SD_FLATTEN_CAP sizes five of the eight, so raising it past 268,435,456 makes each of those five a
# request the real allocator really refuses (programs/oom_test.cyr group J, the same device
# grow_edges_test uses on the growth ceiling).
# ⛔ WHAT THAT GATES, EXACTLY, because the eight 0-tests below are NOT eight gates. ALLOC_MAX
# refuses BY SIZE, and the capacity-sized five are CAP*32, CAP*16 and three of CAP*8: group J's
# 300,000,000 puts the SMALLEST of them over the 2 GiB line, so all five are refused together and
# nothing is mapped (MEASURED: exactly 3 * 24 B granted, five refused, nothing published). A
# capacity that isolated ONE — anything from 67,108,865 to 268,435,456 refuses only the CAP*32 edge
# list — would GRANT the other four, about 4.0 GB of mappings a consumer's machine would have to
# hand over for a test that never touches a byte of them, so it is not taken. The three 24 B ctx
# blocks are not drivable at any capacity: lib/alloc.cyr refuses 24 B only if mmap itself fails.
# ⇒ Deleting any ONE of the eight tests leaves the others setting `ok = 0`, so no suite can kill it:
# they are a CONTRACT on this function, not a gate, in the same sense as the 0 that
# _sd_fill_cross_for returns. What IS gated: that a refusal publishes nothing (check 124) and that a
# success publishes ALL ELEVEN globals (checks 128-138). And the shape a missing test would
# produce — a 0 published behind a status of 1 — cannot reach a store, because sd_fill_impl guards
# on _sd_fill_ectx itself rather than on this status.
# ⚠ The callers in stroke.cyr / dash.cyr discard this status, as they did when it was always 0; on
# this allocator a failure here means the process could not get 262,144 B and is over before it.
fn _sd_scratch_init(): i64 {
    if (_sd_fill_ectx != 0) { return 1; }
    var ectx = alloc(24);
    var edges = alloc(SD_FLATTEN_CAP * 32);
    var fbuf = alloc(SD_FLATTEN_CAP * 8);
    var fctx = alloc(24);
    var cross = alloc(SD_FLATTEN_CAP * 16);
    var srun = alloc(SD_FLATTEN_CAP * 8);
    var sfbuf = alloc(SD_FLATTEN_CAP * 8);
    var sfctx = alloc(24);
    var ok = 1;
    if (ectx == 0) { ok = 0; }
    if (edges == 0) { ok = 0; }
    if (fbuf == 0) { ok = 0; }
    if (fctx == 0) { ok = 0; }
    if (cross == 0) { ok = 0; }
    if (srun == 0) { ok = 0; }
    if (sfbuf == 0) { ok = 0; }
    if (sfctx == 0) { ok = 0; }
    if (ok == 0) { return 0; }
    _sd_fill_ectx = ectx;
    _sd_fill_edges = edges;
    _sd_fill_edges_cap = SD_FLATTEN_CAP;
    _sd_fill_fbuf = fbuf;
    _sd_fill_fctx = fctx;
    _sd_fill_cross = cross;
    _sd_fill_cross_cap = SD_FLATTEN_CAP;
    _sd_stroke_run = srun;
    _sd_stroke_run_cap = SD_FLATTEN_CAP;
    _sd_stroke_fbuf = sfbuf;
    _sd_stroke_fctx = sfctx;
    return 1;
}

# The crossings array for walking a list of `n` edges (a sub-scanline crosses each edge at most
# once, so n slots always suffice). Doubles from the current capacity until it holds n; the old
# block is abandoned and NOT copied — crossings are rebuilt per sub-scanline, and nothing grows it
# while a walk is reading it (the fill's edge list and the stroke batch grow while they are BUILT).
# ⛔ So every walk must read _sd_fill_cross AFTER its list is complete, never cache it across a
# growth. Returns the block, or 0 if the growth failed (the old block and capacity are kept).
#
# ⛔ THE INVARIANT IT EXISTS FOR: _sd_fill_cross_cap >= the capacity of EVERY list that is walked
# (the fill's _sd_fill_edges_cap and the stroke batch's _sd_sb_cap). Nothing checks it at run time —
# it holds because both growers reserve HERE first and abandon their own growth if this one fails,
# and because every capacity climbs the same power-of-two ladder from SD_FLATTEN_CAP. ⚠ A caller
# that ignored the 0 would raise its own capacity above the crossings and the next walk would write
# past this block; with lib/alloc.cyr that cannot be reached from here (a bump allocator that
# refuses nc * 16 refuses the caller's nc * 32 too, so the caller fails at its own allocation
# either way) — but a future allocator with size classes could, so the 0 is a contract, not a
# formality. programs/grow_edges_test.cyr asserts the invariant after every growth it drives.
fn _sd_fill_cross_for(n): i64 {
    if (n <= _sd_fill_cross_cap) { return _sd_fill_cross; }
    var nc = _sd_fill_cross_cap;
    while (nc < n) { nc = nc * 2; }
    var blk = _sd_grow_alloc(nc * 16);
    if (blk == 0) { return 0; }
    _sd_fill_cross = blk;
    _sd_fill_cross_cap = nc;
    return blk;
}

# Double the fill's edge list in `ectx` (the crossings first, so crossings >= edges always holds),
# copying its live edges. Returns 1, or 0 if either allocation failed — the list is then unchanged.
# ⛔ ONLY THE FILL'S OWN ctx GROWS. Success repoints the process-lifetime _sd_fill_edges /
# _sd_fill_edges_cap at the new block, so growing a ctx that is not _sd_fill_ectx would hand the
# fill's scratch bookkeeping to someone else's array. A foreign ctx therefore returns 0 here and its
# caller drops the edge, exactly as 0.6.0 did at the cap — the same guard _sd_flat_widen puts on
# sd_flat_emit's ctx, for the same reason. (Every in-tree caller passes _sd_fill_ectx.)
fn _sd_fill_edges_grow(ectx): i64 {
    if (ectx != _sd_fill_ectx) { return 0; }
    var count = load64(ectx + 8);
    var nc = load64(ectx + 16) * 2;
    if (_sd_fill_cross_for(nc) == 0) { return 0; }
    var blk = _sd_grow_alloc(nc * 32);
    if (blk == 0) { return 0; }
    memcpy(blk, load64(ectx + 0), count * 32);
    store64(ectx + 0, blk);
    store64(ectx + 16, nc);
    _sd_fill_edges = blk;
    _sd_fill_edges_cap = nc;
    return 1;
}

# The per-row accumulator for a canvas `w` pixels wide. Its size is the only part of the scratch
# that depends on the call, so it keeps a capacity and re-allocates from the GLOBAL alloc only
# when a wider canvas than ever seen arrives. ⚠ The old block is abandoned (no free()) — a
# monotone series of ever-wider canvases pays sum(w*8) once; a consumer at a fixed size pays once.
# Returns the block, or 0 if the growth failed — THE OLD BLOCK AND CAPACITY ARE KEPT, exactly as
# _sd_fill_cross_for keeps its own.
# ⛔ WHY THE ROLLBACK IS THE WHOLE POINT, not tidiness. Through 0.7.0 the result was stored
# unchecked and the capacity raised anyway, so ONE refused request POISONED the scratch for the
# life of the process: accrow 0 with a capacity of w, and the very next fill — on any narrower
# canvas, which now "fits" — wrote its accumulator through address 0. MEASURED on 0.7.0, a
# hand-built 536,870,912-px-wide header (w*8 = 4 GiB, over lib/alloc.cyr's ALLOC_MAX of 2 GiB):
# the fill of it SIGSEGVs, rc 139, and with the store moved past it the following 8x8 fill does.
# Now the refusal is reported, sd_fill_impl returns SADISH_ERR_OOM having touched no coverage, and
# every later fill still has the accumulator it had (programs/oom_test.cyr group H).
# ⚠ THE CALLER IN stroke.cyr (the styled span walk) STILL DOES NOT TEST THIS 0 — it faults on a
# refusal exactly as it did through 0.7.0, and that file is out of this change's scope. What it no
# longer does is fault on the NEXT, perfectly ordinary fill.
fn _sd_fill_accrow_for(w): i64 {
    if (w <= _sd_fill_accrow_cap) { return _sd_fill_accrow; }
    var blk = alloc(w * 8);
    if (blk == 0) { return 0; }
    _sd_fill_accrow = blk;
    _sd_fill_accrow_cap = w;
    return blk;
}

# ---- fill internals --------------------------------------------
# Vertical sub-scanlines per pixel row. Coverage is ANALYTIC in x (exact
# horizontal span overlap per sub-scanline) and sampled in y at SD_FILL_SS
# sub-scanlines — smoother AND far cheaper than the old SS*SS point sampling
# (edge crossings are computed per row, not per pixel). This is the SD_AA_SUBSCANLINE engine and
# stays the default; full 2-axis signed-area accumulation is SD_AA_AREA (src/coverage.cyr).
var SD_FILL_SS = 4;

# Edge builder ctx: +0 edges(ptr, 4 i64/edge: ax,ay,bx,by)  +8 count  +16 cap. `ectx` is the
# fill's _sd_fill_ectx: a full list grows (_sd_fill_edges_grow) — and ONLY that ctx does, so any
# other one keeps its own fixed capacity and drops at it, as every ctx did through 0.6.0.
# Horizontal edges (ay == by)
# contribute no crossings and are dropped. ⚠ An edge that does not fit after a FAILED growth is
# dropped and _sd_fill_trunc set — and once set, this fill stops trying to grow, so the list it
# keeps is a prefix of the path's edges (0.6.0's truncation) rather than a list with holes.
fn sd_edge_add(ectx, ax, ay, bx, by): i64 {
    if (ay == by) { return 0; }
    var count = load64(ectx + 8);
    if (count >= load64(ectx + 16)) {
        if (_sd_fill_trunc != 0) { return 0; }
        if (_sd_fill_edges_grow(ectx) == 0) {
            _sd_fill_trunc = 1;
            return 0;
        }
    }
    var e = load64(ectx + 0) + count * 32;
    store64(e + 0, ax);
    store64(e + 8, ay);
    store64(e + 16, bx);
    store64(e + 24, by);
    store64(ectx + 8, count + 1);
    return 0;
}

# Connect `cur` through the points a flatten ctx just emitted, as edges;
# returns the last point (the new current point).
fn sd_fill_edges_from(ectx, fctx, cur): i64 {
    var pts = load64(fctx + 0);
    var n = load64(fctx + 8);
    var prev = cur;
    var i = 0;
    while (i < n) {
        var p = load64(pts + i * 8);
        sd_edge_add(ectx, sd_point_x(prev), sd_point_y(prev), sd_point_x(p), sd_point_y(p));
        prev = p;
        i = i + 1;
    }
    return prev;
}

# Cast a +x ray from (sx, sy) and accumulate edge crossings to its right.
# `signed` = 1 -> signed winding number (nonzero rule); 0 -> crossing count
# (even-odd rule). Half-open [ylo, yhi) span test avoids double-counting a
# vertex shared by two edges.
fn sd_ray_cross(edges, n_edges, sx, sy, signed): i64 {
    var acc = 0;
    var ei = 0;
    while (ei < n_edges) {
        var e = edges + ei * 32;
        var ax = load64(e + 0);
        var ay = load64(e + 8);
        var bx = load64(e + 16);
        var by = load64(e + 24);
        var ylo = ay;
        var yhi = by;
        if (ay > by) { ylo = by; yhi = ay; }
        if (sy >= ylo) {
            if (sy < yhi) {
                var x = ax + ((bx - ax) * (sy - ay)) / (by - ay);
                if (x > sx) {
                    if (signed != 0) {
                        if (by > ay) { acc = acc + 1; } else { acc = acc - 1; }
                    } else {
                        acc = acc + 1;
                    }
                }
            }
        }
        ei = ei + 1;
    }
    return acc;
}

# Add analytic horizontal coverage for a covered span [xs, xe] (16.16 pixel-x)
# to the per-row accumulator `accrow`, weighted by `weight` (coverage per full
# pixel for one sub-scanline). Each touched pixel gets weight * overlap-width.
fn sd_span_add(accrow, w, xs, xe, weight): i64 {
    if (xe <= xs) { return 0; }
    var lo = xs;
    if (lo < 0) { lo = 0; }
    var wmax = w << SD_SHIFT;
    var hi = xe;
    if (hi > wmax) { hi = wmax; }
    if (hi <= lo) { return 0; }
    var px = lo >> SD_SHIFT;
    var stop = 0;
    while (stop == 0) {
        if (px >= w) {
            stop = 1;
        } else {
            var pl = px << SD_SHIFT;
            if (pl >= hi) {
                stop = 1;
            } else {
                var pr = (px + 1) << SD_SHIFT;
                var a = lo;
                if (a < pl) { a = pl; }
                var b = hi;
                if (b > pr) { b = pr; }
                if (b > a) {
                    var add = sd_fixed_mul(weight, b - a);
                    store64(accrow + px * 8, load64(accrow + px * 8) + add);
                }
                px = px + 1;
            }
        }
    }
    return 0;
}

# ================================================================
# sd_canvas_fill_path — rasterize `path` into the canvas coverage buffer
# under winding rule `rule` (SD_FILL_EVEN_ODD | SD_FILL_NONZERO), writing
# 0..255 anti-aliased coverage per pixel (overwrites the buffer).
#
# Pipeline: flatten curve verbs (de Casteljau) into a CLOSED edge list —
# each subpath is closed back to its moveto — then, per pixel, sample an
# SS*SS grid and cast a +x winding ray per sub-sample; coverage is the
# fraction of sub-samples inside.
# ================================================================
# @public — fill `path`'s AA coverage into `cv`, OVERWRITING the buffer.
fn sd_canvas_fill_path(cv, path, rule): i64 {
    return sd_fill_impl(cv, path, rule, 0);
}

# @public — fill `path`'s AA coverage, MAX-combined into the existing coverage
# (a union of shapes — orientation-independent for convex pieces; used by the
# stroker to accumulate overlapping segment rects + join discs).
fn sd_canvas_fill_union(cv, path, rule): i64 {
    return sd_fill_impl(cv, path, rule, 1);
}

# combine: 0 = overwrite the coverage buffer, 1 = max into it (union).
fn sd_fill_impl(cv, path, rule, combine): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (path == 0) { return SADISH_ERR_EMPTY_PATH; }
    var n_verbs = sd_path_verb_count(path);
    if (n_verbs == 0) { return SADISH_ERR_EMPTY_PATH; }

    var w = sd_canvas_width(cv);
    var h = sd_canvas_height(cv);
    var cov = sd_canvas_coverage(cv);
    var stride = sd_canvas_stride(cv);
    var tol = SD_ONE >> 2;

    # ---- build the closed-edge list (into the process-lifetime scratch) ----
    # ⚠ A refused scratch is SADISH_ERR_OOM before a byte of coverage is touched, so the canvas is
    # exactly as the caller left it. (Reachable only through the CAPACITY — see _sd_scratch_init.)
    # ⛔ THE GUARD IS ON THE POINTER, NOT ON _sd_scratch_init's STATUS, and that is deliberate.
    # _sd_fill_ectx is both the scratch's "already initialised" flag and the block the next line
    # stores through, so testing it covers the refusal (the publish is all-or-nothing, so a refused
    # set leaves it 0) AND anything that ever published a 0 behind a status of 1 — the one residual
    # shape _sd_scratch_init's own 0-tests cannot be driven to prove. A status check would catch
    # only the first. (programs/oom_test.cyr group J drives both through this line.)
    _sd_scratch_init();
    var ectx = _sd_fill_ectx;
    if (ectx == 0) { return SADISH_ERR_OOM; }
    store64(ectx + 0, _sd_fill_edges);      # the CURRENT block: a previous fill may have grown it
    store64(ectx + 8, 0);               # per-call reset: the edge count
    store64(ectx + 16, _sd_fill_edges_cap);
    _sd_fill_trunc = 0;
    var fbuf = _sd_fill_fbuf;
    var fctx = _sd_fill_fctx;           # fields are (re)set before every flatten below

    # ⛔ A STARVED FLATTEN IS REPORTED, NOT PAINTED OVER. sd_flatten_quad / _cubic emit their points
    # through sd_alloc, so a consumer hook that refuses mid-curve leaves the fill with FEWER points than
    # the curve needs — a silently wrong picture. Through 0.7.0 that case did not arise here (the
    # refusal dereferenced 0 and killed the process); 0.7.1 made it survivable, and this makes it
    # VISIBLE: the flatten's own truncation flag is scoped to this call, and if this fill lost a point
    # it returns SADISH_ERR_OOM. MEASURED (programs/flatten_bound_test.cyr group M): a 4-cubic circle
    # whose true ink is 312,280 coverage units paints 81,029 under a hook granting 5 allocations.
    # ⚠ The canvas still holds that partial picture — the caller decides whether to clear and retry.
    # ⚠ The flag is RESTORED for the caller afterwards (sd_flatten_truncated() is documented as sticky
    # until the next sd_path_flatten), so scoping it here cannot swallow a verdict the caller was
    # already holding.
    # ⚠ Strokes are NOT covered by this return: the styled path has its own flush and the round stroker
    # discards sd_canvas_fill_union's result, so sd_flatten_truncated() remains their only witness.
    # ⛔ A DRAWING VERB BEFORE ANY MOVETO IS SKIPPED, not drawn from (0, 0). `cur` is an SdPoint
    # POINTER, 0 until the first moveto, and every drawing verb dereferences it — so a path whose first
    # verb is a lineto/quadto/cubicto used to fault the process (MEASURED on 0.7.0 and 0.6.0 alike:
    # SIGSEGV, rc 139). SVG calls such a path an error and renders nothing of it; sadish now skips the
    # verbs (their points are still consumed, so the verb/point streams stay in step) until a moveto
    # arrives. ⚠ 0.7.1 made this easy to reach: a refused sd_path_moveto now returns SADISH_ERR_OOM
    # with the path untouched, so a caller that logs and carries on builds exactly this path.
    var flat_was = _sd_flat_trunc;      # the caller's standing verdict, restored below
    _sd_flat_trunc = 0;                 # scoped: from here it means "THIS fill lost points"
    var verbs = load64(path + SD_PATH_VERBS_OFFSET);
    var points = load64(path + SD_PATH_POINTS_OFFSET);
    var cur = 0;
    var sub_start = 0;
    var sub_open = 0;
    var vi = 0;
    var pi = 0;
    while (vi < n_verbs) {
        var verb = load64(verbs + vi * 8);
        if (verb == SD_VERB_MOVETO) {
            if (sub_open != 0) {
                sd_edge_add(ectx, sd_point_x(cur), sd_point_y(cur), sd_point_x(sub_start), sd_point_y(sub_start));
            }
            cur = load64(points + pi * 8);
            sub_start = cur;
            sub_open = 0;
            pi = pi + 1;
        }
        if (verb == SD_VERB_LINETO) {
            var lp = load64(points + pi * 8);
            if (cur != 0) {
                sd_edge_add(ectx, sd_point_x(cur), sd_point_y(cur), sd_point_x(lp), sd_point_y(lp));
                cur = lp;
                sub_open = 1;
            }
            pi = pi + 1;
        }
        if (verb == SD_VERB_QUADTO) {
            var qc = load64(points + pi * 8);
            var qe = load64(points + (pi + 1) * 8);
            if (cur == 0) { qe = 0; }       # no moveto yet: skip the curve, keep the streams in step
            store64(fctx + 0, fbuf);
            store64(fctx + 8, 0);
            store64(fctx + 16, SD_FLATTEN_CAP);
            if (qe != 0) {
                sd_flatten_quad(fctx, cur, qc, qe, tol, SD_FLATTEN_MAX_DEPTH);
                cur = sd_fill_edges_from(ectx, fctx, cur);
                sub_open = 1;
            }
            pi = pi + 2;
        }
        if (verb == SD_VERB_CUBICTO) {
            var k1 = load64(points + pi * 8);
            var k2 = load64(points + (pi + 1) * 8);
            var ke = load64(points + (pi + 2) * 8);
            if (cur == 0) { ke = 0; }       # no moveto yet: skip the curve, keep the streams in step
            store64(fctx + 0, fbuf);
            store64(fctx + 8, 0);
            store64(fctx + 16, SD_FLATTEN_CAP);
            if (ke != 0) {
                sd_flatten_cubic(fctx, cur, k1, k2, ke, tol, SD_FLATTEN_MAX_DEPTH);
                cur = sd_fill_edges_from(ectx, fctx, cur);
                sub_open = 1;
            }
            pi = pi + 3;
        }
        if (verb == SD_VERB_CLOSE) {
            if (cur != 0) {
                sd_edge_add(ectx, sd_point_x(cur), sd_point_y(cur), sd_point_x(sub_start), sd_point_y(sub_start));
                cur = sub_start;
                sub_open = 0;
            }
        }
        vi = vi + 1;
    }
    if (sub_open != 0) {
        sd_edge_add(ectx, sd_point_x(cur), sd_point_y(cur), sd_point_x(sub_start), sd_point_y(sub_start));
    }

    var flat_lost = _sd_flat_trunc;     # did THIS fill's flatten lose points?
    if (flat_was != 0) { _sd_flat_trunc = 1; }
    var flat_rc = SADISH_OK;
    if (flat_lost != 0) { flat_rc = SADISH_ERR_OOM; }

    var n_edges = load64(ectx + 8);
    var edges = load64(ectx + 0);
    if (n_edges == 0) { return flat_rc; }

    # ---- SD_AA_AREA: exact 2-axis coverage (src/coverage.cyr), opt-in per canvas ----
    # ⛔ Only a canvas holding exactly SD_AA_AREA branches here; every other value runs the 0.4.0
    # loop below, untouched — the bytes agnos's refagree oracle is gated on.
    # ⛔ AND ONLY WHEN THE EDGE LIST IS WHOLE. An edge dropped by sd_edge_add leaves a contour
    # OPEN. The loop below paints nothing right of a row's last crossing, so an open contour costs
    # it the shape and no more; the area engine's running sum would stay non-zero to the canvas's
    # right edge — a streak (MEASURED, 80x40, a triangle losing its closing edge: 28 of 40 rows lit
    # at x = 79, 255 at (60, 20)). Since 0.6.1 the list grows, so an edge is dropped only when a
    # growth FAILED, which sd_edge_add records: a truncated AREA fill runs the loop below instead
    # (programs/grow_edges_test.cyr) — ⚠ at that loop's cost, which for a list that large is steep
    # (MEASURED 256x256, 8,000 edges: 10.9 s a fill, against the area engine's 41 ms). Through
    # 0.6.0 a list cannot tell "exactly full" from "truncated", and ANY AREA fill of 8,192 edges ran
    # the loop.
    if (load64(cv + SD_CANVAS_AA_OFFSET) == SD_AA_AREA) {
        if (_sd_fill_trunc == 0) {
            var nonzero = 0;
            if (rule == SD_FILL_NONZERO) { nonzero = 1; }
            var mask = 0;
            var clipn = load64(cv + SD_CANVAS_CLIP_OFFSET);
            if (clipn != 0) { mask = load64(clipn + 0); }
            var arc = _sd_area_fill(edges, n_edges, w, h, cov, stride, mask, nonzero, combine);
            if (arc != SADISH_OK) { return arc; }
            return flat_rc;
        }
    }

    # ---- analytic-horizontal coverage, SD_FILL_SS vertical sub-scanlines ----
    var want_signed = 0;
    if (rule == SD_FILL_NONZERO) { want_signed = 1; }
    var ssy = SD_FILL_SS;
    var weight = SD_ONE / ssy;         # coverage per full pixel per sub-scanline
    var accrow = _sd_fill_accrow_for(w);   # per-row fractional coverage (16.16); zeroed per row below
    # ⚠ A refused accumulator is SADISH_ERR_OOM here, BEFORE the py/px loops — the coverage buffer
    # is untouched, so a caller that retries on a narrower canvas gets a clean fill (the capacity
    # was not raised; see _sd_fill_accrow_for).
    if (accrow == 0) { return SADISH_ERR_OOM; }
    var cross = _sd_fill_cross;            # (x, dir) crossings per sub-scanline; only [0, nc) is read
    # ^ read AFTER the list is built: a growth above replaced the block, and its capacity >= n_edges

    var py = 0;
    while (py < h) {
        var zi = 0;
        while (zi < w) {
            store64(accrow + zi * 8, 0);
            zi = zi + 1;
        }

        var s = 0;
        while (s < ssy) {
            var sy = (py << SD_SHIFT) + (s * SD_ONE + (SD_ONE >> 1)) / ssy;
            # gather crossings at this sub-scanline
            var nc = 0;
            var ei = 0;
            while (ei < n_edges) {
                var e = edges + ei * 32;
                var ay = load64(e + 8);
                var by = load64(e + 24);
                var ylo = ay;
                var yhi = by;
                var dir = 1;
                if (ay > by) { ylo = by; yhi = ay; dir = 0 - 1; }
                if (sy >= ylo) {
                    if (sy < yhi) {
                        var ax = load64(e + 0);
                        var bx = load64(e + 16);
                        var xx = ax + ((bx - ax) * (sy - ay)) / (by - ay);
                        store64(cross + nc * 16, xx);
                        store64(cross + nc * 16 + 8, dir);
                        nc = nc + 1;
                    }
                }
                ei = ei + 1;
            }
            # insertion sort crossings by x
            var a = 1;
            while (a < nc) {
                var kx = load64(cross + a * 16);
                var kd = load64(cross + a * 16 + 8);
                var b = a - 1;
                var stop = 0;
                while (stop == 0) {
                    if (b < 0) {
                        stop = 1;
                    } else {
                        if (load64(cross + b * 16) > kx) {
                            store64(cross + (b + 1) * 16, load64(cross + b * 16));
                            store64(cross + (b + 1) * 16 + 8, load64(cross + b * 16 + 8));
                            b = b - 1;
                        } else {
                            stop = 1;
                        }
                    }
                }
                store64(cross + (b + 1) * 16, kx);
                store64(cross + (b + 1) * 16 + 8, kd);
                a = a + 1;
            }
            # walk crossings -> covered spans -> analytic horizontal coverage
            var wind = 0;
            var ci = 0;
            while (ci < nc - 1) {
                if (want_signed != 0) {
                    wind = wind + load64(cross + ci * 16 + 8);
                } else {
                    wind = wind + 1;
                }
                var inside = 0;
                if (want_signed != 0) {
                    if (wind != 0) { inside = 1; }
                } else {
                    if ((wind & 1) != 0) { inside = 1; }
                }
                if (inside != 0) {
                    sd_span_add(accrow, w, load64(cross + ci * 16), load64(cross + (ci + 1) * 16), weight);
                }
                ci = ci + 1;
            }
            s = s + 1;
        }

        # accumulator row -> coverage bytes (with clip + combine)
        var px = 0;
        while (px < w) {
            var cvg = load64(accrow + px * 8);
            var c = (cvg * 255) >> SD_SHIFT;
            if (c > 255) { c = 255; }
            var clipnode = load64(cv + SD_CANVAS_CLIP_OFFSET);
            if (clipnode != 0) {
                # ⛔ PACKED `py * w + px` — the mask is a w*h block, NOT a window into a wider
                # buffer, so the canvas stride is not its pitch (see the SdCanvas layout note).
                c = (c * load8(load64(clipnode + 0) + py * w + px)) / 255;
            }
            if (combine != 0) {
                var oldc = load8(cov + py * stride + px);   # coverage: the STRIDE, not w
                if (c < oldc) { c = oldc; }
            }
            store8(cov + py * stride + px, c);
            px = px + 1;
        }
        py = py + 1;
    }
    return flat_rc;
}

# ================================================================
# sd_canvas_blit_at — composite the canvas coverage onto an SdSurface `surface`
# with the canvas's (0,0) placed at surface pixel (dx, dy), using the solid
# `color` (0x00RRGGBB), the per-pixel coverage acting as the source alpha
# (src-over): out = src*cov/255 + dst*(255-cov)/255. (dx, dy) may be negative
# or beyond the surface — the blit is clipped to the surface on every side.
#
# ⚠ Rows are addressed by `sd_surface_stride(surface)`, NOT width*4. A surface
# that WRAPS a wider buffer (dhancha's dh_surface_wrap over a framebuffer or a
# sub-rect of a pane) has stride != width*4, and the pre-0.5.5 sd_canvas_blit
# used `sw` as the pitch — right for every packed surface sadish makes itself,
# and one row's worth of shear per row on a wrapped one. Same src-over math
# as before, verbatim; only the addressing changed.
#
# Gradient paint (linear / radial, multi-stop) is sd_canvas_blit_paint_at in src/paint.cyr (0.6.0).
# TODO: a whole-canvas fast path routed through the AGNOS blit#39.
# ================================================================
# @public
fn sd_canvas_blit_at(cv, surface, color, dx, dy): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (surface == 0) { return SADISH_ERR_BOUNDS; }
    var cw = sd_canvas_width(cv);
    var ch = sd_canvas_height(cv);
    var covbuf = sd_canvas_coverage(cv);
    var covstride = sd_canvas_stride(cv);
    var sw = sd_surface_width(surface);
    var sh = sd_surface_height(surface);
    var spx = sd_surface_pixels(surface);
    var pitch = sd_surface_stride(surface);

    var sr = (color >> 16) & 255;
    var sg = (color >> 8) & 255;
    var sb = color & 255;

    # Clip the canvas rect [dx, dx+cw) x [dy, dy+ch) to the surface: x0..x1 / y0..y1
    # are CANVAS coordinates of the visible part.
    var x0 = 0;
    if (dx < 0) { x0 = 0 - dx; }
    var y0 = 0;
    if (dy < 0) { y0 = 0 - dy; }
    var x1 = cw;
    if (dx + x1 > sw) { x1 = sw - dx; }
    var y1 = ch;
    if (dy + y1 > sh) { y1 = sh - dy; }

    var y = y0;
    while (y < y1) {
        var x = x0;
        while (x < x1) {
            var a = load8(covbuf + y * covstride + x);
            if (a != 0) {
                var off = (y + dy) * pitch + (x + dx) * 4;
                if (a == 255) {
                    store8(spx + off, sb);
                    store8(spx + off + 1, sg);
                    store8(spx + off + 2, sr);
                    store8(spx + off + 3, 255);
                } else {
                    var ia = 255 - a;
                    var nb = (sb * a + load8(spx + off) * ia) / 255;
                    var ng = (sg * a + load8(spx + off + 1) * ia) / 255;
                    var nr = (sr * a + load8(spx + off + 2) * ia) / 255;
                    store8(spx + off, nb);
                    store8(spx + off + 1, ng);
                    store8(spx + off + 2, nr);
                    store8(spx + off + 3, 255);
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return SADISH_OK;
}

# @public — sd_canvas_blit_at with the canvas at the surface origin. On a packed
# surface (stride == width*4) the bytes are identical to the pre-0.5.5 blit
# (asserted pixel-for-pixel in programs/alloc_test.cyr).
fn sd_canvas_blit(cv, surface, color): i64 {
    return sd_canvas_blit_at(cv, surface, color, 0, 0);
}

# ================================================================
# sd_canvas_blit_gradient — like sd_canvas_blit, but the source color is a
# LINEAR GRADIENT from `c0` (at pixel (x0,y0)) to `c1` (at (x1,y1)): each
# pixel's color is c0..c1 lerped by its projection onto the axis (clamped to
# the endpoints), then src-over with coverage. Colors 0x00RRGGBB; endpoints in
# whole pixels. A degenerate axis (x0,y0 == x1,y1) paints solid c0.
# ⚠ Kept byte-identical for existing callers. Radial + multi-stop + spread, sampled at pixel
# CENTRES with 16.16 endpoints, is the SdGradient paint in src/paint.cyr (0.6.0).
# ================================================================
# @public
fn sd_canvas_blit_gradient(cv, surface, x0, y0, c0, x1, y1, c1): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (surface == 0) { return SADISH_ERR_BOUNDS; }
    var cw = sd_canvas_width(cv);
    var ch = sd_canvas_height(cv);
    var covbuf = sd_canvas_coverage(cv);
    var covstride = sd_canvas_stride(cv);
    var sw = sd_surface_width(surface);
    var sh = sd_surface_height(surface);
    var spx = sd_surface_pixels(surface);
    var pitch = sd_surface_stride(surface);   # ⚠ row pitch in bytes, not sw*4 (see sd_canvas_blit_at)

    var dx = x1 - x0;
    var dy = y1 - y0;
    var td = dx * dx + dy * dy;   # squared axis length
    var r0 = (c0 >> 16) & 255;
    var g0 = (c0 >> 8) & 255;
    var b0 = c0 & 255;
    var r1 = (c1 >> 16) & 255;
    var g1 = (c1 >> 8) & 255;
    var b1 = c1 & 255;

    var w = cw;
    if (sw < w) { w = sw; }
    var h = ch;
    if (sh < h) { h = sh; }

    var y = 0;
    while (y < h) {
        var x = 0;
        while (x < w) {
            var a = load8(covbuf + y * covstride + x);
            if (a != 0) {
                var sr = r0;
                var sg = g0;
                var sb = b0;
                if (td > 0) {
                    var tn = (x - x0) * dx + (y - y0) * dy;
                    if (tn < 0) { tn = 0; }
                    if (tn > td) { tn = td; }
                    sr = r0 + ((r1 - r0) * tn) / td;
                    sg = g0 + ((g1 - g0) * tn) / td;
                    sb = b0 + ((b1 - b0) * tn) / td;
                }
                var off = y * pitch + x * 4;
                if (a == 255) {
                    store8(spx + off, sb);
                    store8(spx + off + 1, sg);
                    store8(spx + off + 2, sr);
                    store8(spx + off + 3, 255);
                } else {
                    var ia = 255 - a;
                    var nb = (sb * a + load8(spx + off) * ia) / 255;
                    var ng = (sg * a + load8(spx + off + 1) * ia) / 255;
                    var nr = (sr * a + load8(spx + off + 2) * ia) / 255;
                    store8(spx + off, nb);
                    store8(spx + off + 1, ng);
                    store8(spx + off + 2, nr);
                    store8(spx + off + 3, 255);
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return SADISH_OK;
}

# ---- clipping (v0.4.0) -----------------------------------------
# A clip is a coverage MASK (0..255 per pixel), the top of a stack held on the
# canvas (SD_CANVAS_CLIP_OFFSET). fill_impl multiplies each pixel's coverage by
# the active mask, so fills + strokes are bounded to the clip region; blit then
# composites the already-clipped coverage. Push intersects (multiplies) a new
# shape into the current clip; pop restores the previous region.
# SdClip node (16 bytes): +0 mask(ptr, w*h)  +8 prev(SdClip | 0).
# ⛔ The mask is PACKED w*h — `y * w + x` — on a canvas of any stride. Every writer below and the
# three readers (sd_fill_impl, _sd_area_fill, _sd_sb_flush) index it that way; see the SdCanvas
# layout note for why a canvas's stride is the COVERAGE buffer's pitch and never the mask's.

# Intersect `shape` (a PACKED w*h mask) with the current clip IN PLACE, then push it.
# Returns SADISH_OK; SADISH_ERR_BOUNDS for a null canvas; SADISH_ERR_OOM for a null `shape` (the
# caller's own mask allocation was refused — passed straight through so a caller may chain) or for
# a refused 16 B node.
# ⛔ THE NODE IS TAKEN BEFORE THE INTERSECTION, and that order is the refusal contract. Through
# 0.7.0 the node was stored through unchecked (rekha's filing); checking it AFTER the in-place
# multiply would have stopped the fault but still left the caller's `shape` half-consumed —
# multiplied by a clip it was never pushed under, so a caller that retried would intersect twice.
# With the allocation first, a refusal touches NOTHING: the canvas's clip pointer, the mask under
# it and the caller's `shape` are byte-for-byte what they were, the previous clip is still poppable,
# and pushing again once memory is available lands the same region it always would have.
# ⚠ Byte-identical on every push that succeeds — nothing allocates between the two points, so the
# node gets the same block it always got, and the multiply runs over the same bytes in the same
# order. Gated by programs/clip_test.cyr, programs/clip_pitch_test.cyr and programs/oom_test.cyr.
fn sd_clip_push_mask(cv, shape): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (shape == 0) { return SADISH_ERR_OOM; }
    var node = sd_alloc(16);
    if (node == 0) { return SADISH_ERR_OOM; }
    var w = sd_canvas_width(cv);
    var h = sd_canvas_height(cv);
    var cur = load64(cv + SD_CANVAS_CLIP_OFFSET);
    if (cur != 0) {
        var curmask = load64(cur + 0);
        var n = w * h;
        var i = 0;
        while (i < n) {
            store8(shape + i, (load8(shape + i) * load8(curmask + i)) / 255);
            i = i + 1;
        }
    }
    store64(node + 0, shape);
    store64(node + 8, cur);
    store64(cv + SD_CANVAS_CLIP_OFFSET, node);
    return SADISH_OK;
}

# @public — intersect a rectangle [x0,x1) x [y0,y1) (whole pixels) into the
# clip and push it. Returns SADISH_OK, SADISH_ERR_BOUNDS for a null canvas, or SADISH_ERR_OOM if
# the w*h mask or the clip node is refused — in which case NOTHING was written and the clip that
# was on the canvas is unchanged and still poppable.
# ⚠ A 0-AREA CANVAS NOW REPORTS SADISH_ERR_OOM, and that is a CHANGE from 0.7.0 (MEASURED on both
# trees with a hand-built w=0 header: 0.7.0 returned SADISH_OK, 0.7.1 returns SADISH_ERR_OOM;
# programs/oom_test.cyr group K pins it). `sd_alloc(0)` returns 0 by lib/alloc.cyr's contract, so
# 0.7.0 pushed a clip node whose mask pointer was ADDRESS 0 and got away with it only because every
# reader indexes w*h = 0 bytes of it. Refusing is the wanted answer here: after 0.7.1 a null pointer
# does not enter a data structure, and the alternative is weakening sd_clip_push_mask's `shape == 0`
# guard, which exists so a caller chaining its OWN refused mask gets a code instead of that node.
# ⇒ Deliberately NOT the `n > 0` carve-out src/present.cyr makes for the same sd_alloc(0): there the
# 0-pixel call still COMPLETES — a valid header-only PPM, nothing left over — while here the only
# thing to hand back is the booby-trapped node. ⚠ Unreachable from a constructed canvas: sd_canvas_new
# refuses w <= 0 and h <= 0, so only a hand-built header can ask this.
fn sd_canvas_clip_push_rect(cv, x0, y0, x1, y1): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    var w = sd_canvas_width(cv);
    var h = sd_canvas_height(cv);
    var shape = sd_alloc(w * h);
    if (shape == 0) { return SADISH_ERR_OOM; }
    var y = 0;
    while (y < h) {
        var x = 0;
        while (x < w) {
            var v = 0;
            if (x >= x0) {
                if (x < x1) {
                    if (y >= y0) {
                        if (y < y1) { v = 255; }
                    }
                }
            }
            store8(shape + y * w + x, v);
            x = x + 1;
        }
        y = y + 1;
    }
    return sd_clip_push_mask(cv, shape);
}

# @public — intersect a filled PATH (its coverage) into the clip and push it.
# Returns SADISH_OK, SADISH_ERR_BOUNDS for a null canvas, SADISH_ERR_EMPTY_PATH for a null path, or
# SADISH_ERR_OOM if the temp canvas, its coverage, or the clip node is refused — nothing pushed,
# the existing clip unchanged.
# ⛔ ONLY SADISH_ERR_OOM IS PROPAGATED OUT OF THE FILL, and the asymmetry is deliberate. A path
# with no verbs fills nothing, leaves the fresh canvas's zeroed coverage as the mask and so clips
# everything away — that is what this entry point has always done with SADISH_ERR_EMPTY_PATH and
# callers depend on it. An OOM is different in kind: the mask would be a mask of the fill that did
# not happen, and pushing it would silently clip away a shape the caller asked to keep.
# ⚠ Both halves of that asymmetry are GATED, not just asserted here: programs/oom_test.cyr group K
# pushes a verb-less path with no hook armed and reads SADISH_OK, a clip of nothing, and a pop back
# to the previous region (MEASURED identical on 0.7.0); group I refuses the fill and reads
# SADISH_ERR_OOM with nothing pushed. Widening this line to `fillrc != SADISH_OK` fails group K.
fn sd_canvas_clip_push_path(cv, path, rule): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (path == 0) { return SADISH_ERR_EMPTY_PATH; }
    var w = sd_canvas_width(cv);
    var h = sd_canvas_height(cv);
    var tmp = sd_canvas_new(w, h);        # fresh (unclipped) -> raw shape coverage
    if (tmp == 0) { return SADISH_ERR_OOM; }
    sd_canvas_set_aa(tmp, sd_canvas_aa(cv));   # the mask uses the parent's coverage engine
    var fillrc = sd_canvas_fill_path(tmp, path, rule);
    if (fillrc == SADISH_ERR_OOM) { return SADISH_ERR_OOM; }
    return sd_clip_push_mask(cv, sd_canvas_coverage(tmp));
}

# @public — pop the top clip, restoring the previous region (0 = unclipped).
fn sd_canvas_clip_pop(cv): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    var cur = load64(cv + SD_CANVAS_CLIP_OFFSET);
    if (cur != 0) {
        store64(cv + SD_CANVAS_CLIP_OFFSET, load64(cur + 8));
    }
    return SADISH_OK;
}

# ================================================================
# Version probe — packed as major*10000 + minor*100 + patch.
# 0.4.0 -> 400; 0.4.1 -> 401; 0.5.5 -> 505; 0.6.0 -> 600; 0.7.0 -> 700; 0.7.1 -> 701.
# ================================================================
# @public
fn sadish_version(): i64 {
    return 701;
}
