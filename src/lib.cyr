# @public — sadish library include chain.
# sadish (सदिश — vector) — pure-Cyrius low-level 2D vector graphics core.
#
# Provides: path construction (line/quadratic+cubic Bézier), curve
# flattening, scanline fill (even-odd + nonzero winding) with
# anti-aliased coverage, affine transforms, clipping → a pixel/coverage
# buffer that blits via the kernel blit#39 (or a host framebuffer). The
# low-level rasterizer foundation that rekha (font outlines), a
# canvas/drawing API, compositing, SVG, and the dhancha UI toolkit are all
# CONSUMERS of — not re-implementations.
#
# Stdlib includes live ONLY in this file — domain modules are flat,
# which is what makes `cyrius distlib` (strip-include concatenation)
# produce a compile-clean `dist/sadish.cyr`. Don't add stdlib includes
# in individual src/*.cyr files.

# ================================================================
# Standard library
# ================================================================
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/syscalls.cyr"
include "lib/assert.cyr"
include "lib/bench.cyr"

# ================================================================
# sadish domain modules — flat, dependency order.
# error.cyr is dep-free. geom.cyr (SdPoint 16.16 + SdMatrix affine) builds
# on nothing but the fixed-point substrate; path.cyr (SdPath verbs+points
# + flatten) consumes geom's SdPoint; raster.cyr (SdCanvas coverage buffer
# + fill/blit) consumes path's flattened polyline and error.cyr's codes.
# ================================================================
# alloc.cyr FIRST — the allocation seam (sd_alloc / sd_alloc_set) every
# module below draws from; a consumer hooks it to route sadish onto its arena.
include "src/alloc.cyr"
include "src/error.cyr"
# surface.cyr (SdSurface BGRA pixel buffer) + draw.cyr (direct opaque
# primitives: Bresenham line, hline/vline, rect, fill_rect, clear) are the
# pixel-target + "easy 80%" primitives lifted from the ecosystem games
# (docs/development/prior-art.md); they depend only on error + stdlib.
include "src/surface.cyr"
include "src/draw.cyr"
# present.cyr — surface -> screen: a platform-neutral P6 PPM writer plus the
# Linux /dev/fb0 SdPresenter (probe/scale/letterbox blit), adapted from
# encom-hits' engine.cyr. Depends on surface + error only.
include "src/present.cyr"
include "src/geom.cyr"
include "src/path.cyr"
# coverage.cyr — the opt-in SD_AA_AREA engine (exact 2-axis signed-area accumulation). Depends on
# geom (16.16) + error only; raster.cyr's sd_fill_impl dispatches into it.
include "src/coverage.cyr"
include "src/raster.cyr"
# stroke.cyr — round + styled (cap/join/miter-limit) stroking; flattens into
# raster.cyr's stroker scratch; fills through sd_canvas_fill_union (round) or
# its own span walk over raster's fill scratch (styled).
include "src/stroke.cyr"
# dash.cyr — dashed strokes (SVG stroke-dasharray / stroke-dashoffset). Built ON stroke.cyr: it
# cuts the styled stroker's flattened run into on-dashes and hands each one back to _sd_sb_subpath,
# so both entry points share one verb walk (_sd_styled_walk calls forward into this file).
include "src/dash.cyr"
# paint.cyr — gradient paint (linear, radial + focal radial, multi-stop, pad/repeat/reflect, gradient
# transforms) composited through a canvas's coverage; builds on raster (SdCanvas), geom (SdMatrix),
# surface (colour helpers), error and alloc — and, since 0.7.0, on premul.cyr: its blit loops call
# _sd_premul_paint_px for the premultiplied store.
include "src/paint.cyr"
# premul.cyr — premultiplied writers (clear / rect / coverage blit with REAL alpha, and the GRADIENT
# blit sd_canvas_blit_paint_premul_at) for surfaces agnos composites with gpu_shader_op#92; builds on
# surface (sd_premul), raster (SdCanvas), error — and on paint.cyr, whose _sd_paint_blit_run it wraps.
# ⚠ paint.cyr and premul.cyr REFERENCE EACH OTHER (0.7.0: one evaluation, two compositors). Cyrius
# resolves forward references, so this order still compiles, but neither module can be dropped from
# the bundle without the other.
include "src/premul.cyr"
