# @public — sadish path construction + curve flattening.
#
# path.cyr — an SdPath is a growable command list: a stream of verbs
# (moveto / lineto / quadto / cubicto / close) plus a parallel stream of
# control points. This is the resolution-independent geometry a consumer
# builds; the rasterizer (raster.cyr) consumes the FLATTENED polyline the
# curve verbs expand into.
#
# Storage model: two bump-allocated arrays sized at construction, EACH
# WITH ITS OWN CAPACITY (0.7.2). Verbs are one i64 each; POINTS ARE THE
# COORDINATES THEMSELVES — x then y, 16 B a slot, INLINE in the array (0.9.0;
# through 0.8.0 a slot was an 8 B POINTER to a separately allocated 16 B
# SdPoint). A quadto consumes 2 points (control, end); a cubicto 3 (c1, c2,
# end); moveto and lineto 1 (the target); close 0.
# Storage is unbounded as of v0.4.0 — sd_path_grow doubles ONE array, the
# one that overflowed (0.7.2; through 0.7.1 it doubled both); SD_PATH_CAP is
# only sd_path_new's initial allocation, and sd_path_new_cap (0.7.1) opens
# each array at the size the caller already knows.
#
# ⛔⛔ READ A PATH'S POINTS THROUGH sd_path_point_x / sd_path_point_y (0.9.0). They are the
# published way and the ONLY supported one: the layout below is sadish's, and a consumer that
# indexes SD_PATH_POINTS_OFFSET itself is written against a record that has now changed shape
# twice. ⚠ 14 reads across 5 rekha test programs did exactly that, because through 0.8.0 there was
# no accessor to read — half of why this ABI break is worth taking is that there is one now.
#   var i = 0;
#   while (i < sd_path_point_count(p)) {
#       ... sd_path_point_x(p, i), sd_path_point_y(p, i) ...       # 16.16, no allocation
#       i = i + 1;
#   }
# sd_path_verb_at(p, i) is the same for the verb stream, which did NOT change shape.
# ⚠ SADISH'S OWN WALKS TAKE ONE EXEMPTION, STATED HERE SO A LATER READER DOES NOT TAKE IT FOR
# LICENCE. A verb walk reads both streams once per verb and knows no builder can run mid-walk, so
# it HOISTS a base pointer out of the loop and indexes it: every verb stream in src/ does
# (raster.cyr's fill, both of stroke.cyr's, and this file's), and sd_path_flatten below does it for
# the POINTS too. That saves one dependent load per read and is safe only INSIDE the library, which
# owns the layout and moves it in the same commit. Outside those loops sadish reads its own paths
# the published way — 37 sd_path_point_x / sd_path_point_y calls across raster.cyr and stroke.cyr,
# which are the in-tree example to copy. sd_path_verb_at has NO internal caller: it exists so a
# consumer's walk carries no offsets at all, and its gates are programs/inline_points_test.cyr and
# programs/path_cap_test.cyr.
#
# ⭐ SdPolyline FOLLOWED AT 0.10.0 — the note here used to say it was deliberately left alone, and
# the deferral is over. 0.9.0 declined to break two records in one release ("a second ABI break in
# one release is how a consumer stops trusting the version number") and that cost was visible: the
# flatten had to MATERIALISE an SdPoint for every point it emitted, because the output held
# pointers, so what the path stopped paying per point the flatten started paying. 0.10.0 gives the
# polyline the same inline slots and the per-point allocation leaves the library entirely — see
# the SdPolyline record below and sd_polyline_point_x / _y.
# ⚠ SdPoint ITSELF IS UNTOUCHED and stays published: sd_point_new, sd_matrix_apply (which takes and
# returns one) and sd_pt_mid still build 16 B records, and programs/rotate_test.cyr and
# geom_test.cyr hold them. What changed is that no STORE in sadish is an SdPoint any more — both
# arrays hold coordinates, and the record is now purely an argument type.

# ---- verb tags --------------------------------------------------
var SD_VERB_MOVETO = 0;
var SD_VERB_LINETO = 1;
var SD_VERB_QUADTO = 2;
var SD_VERB_CUBICTO = 3;
var SD_VERB_CLOSE  = 4;

# sd_path_new's initial capacity for the VERB array; it doubles on its own overflow (v0.4.0), so
# this is just the first allocation size. ⚠ Through 0.8.0 it sized the point array too.
var SD_PATH_CAP = 256;

# ⭐⭐ sd_path_new's initial capacity for the POINT array, RE-DERIVED WITH THE SLOT (0.9.0). A point
# slot went from 8 B to 16, so 256 slots would have taken sd_path_new's first allocation from
# 48 + 2,048 + 2,048 = 4,144 B to 6,192 B — a 2,048 B regression on EVERY path a caller opens
# without a size, and the default is what an unported consumer uses. 128 slots is the same 2,048 B
# of points, so **sd_path_new costs the 4,144 B in 3 allocations it has cost since 0.4.0**, and a
# small path — rekha's moveto + 2 linetos + close — falls from 4,192 B in 6 calls to 4,144 in 3.
# ⛔ IT IS A MEASURED DECISION AND IT HAS A PRICE: a default path's point array now doubles at the
# 129th point where it used to reach 256, so a path of 129-256 points pays one 4,096 B doubling
# (and one memcpy) that 0.8.0 did not. MEASURED against the alternative — 256 inline slots — on
# dhancha's own gate: its 512 KiB text arena holds a 60-glyph run at 20 px with 128 and CHAINS
# ANOTHER CHUNK with 256 (dhancha's programs/text_arena_test.cyr, the check that pins
# arena_capacity_total at 524,288). rekha builds one sd_path_new per glyph and a glyph of this
# corpus is 26 points on average, 90 at the largest — an order below the new boundary.
# ⚠ The two constants are now ASYMMETRIC on purpose: verbs 256, points 128, both 2,048 B. Callers
# that know their size should use sd_path_new_cap and neither constant reaches them.
var SD_PATH_PCAP = 128;

# The floor sd_path_new_cap clamps to, so a path asked for at 0 (or a negative estimate) still
# holds a closed rect — moveto + 3 linetos + close = 5 verbs, 4 points — without a doubling.
# 128 B of arrays; the smallest useful path, not a second default.
var SD_PATH_CAP_MIN = 8;

# ⛔⛔ THE CEILING, AND WHY A PATH HAS ONE (0.7.1; RE-DERIVED FOR THE 16 B POINT SLOT, 0.9.0). The
# verb array is `cap * 8` bytes and the POINT array is now `cap * 16`, and both MULTIPLIES WRAP: a
# capacity past 2^60 wraps mod 2^64 to a small positive byte count, so the allocator hands back a
# tiny block, the 0-checks pass, the record is stored with a capacity of 1.2e18 behind it, and the
# SECOND push writes off the end of the array — MEASURED before this ceiling existed (0.7.1, at the
# 8 B slot), sd_path_new_cap(2305843009213693953, 0) returned a live path whose verb and point
# blocks were 8 B apart and whose second verb landed on top of the first point.
# ⇒ 2^27 entries — HALF of 0.7.1's 2^28, because the point slot doubled: 2^27 * 16 B = 2 GiB =
# lib/alloc.cyr's ALLOC_MAX, so this is again the largest POINT array the stock allocator can EVER
# serve, and every capacity above it is already refused by the allocator (MEASURED:
# sd_path_new_cap(0, 134217729) -> 0 with the ceiling removed, because alloc refuses 2,147,483,664 B).
# ⚠ ONE CONSTANT BOUNDS BOTH ARRAYS AND IT TAKES THE TIGHTER SLOT. A 2^27-entry VERB array is only
# 1 GiB, so a verb capacity in (2^27, 2^28] is refused here that 0.8.0 served — a deliberate,
# measured narrowing rather than a second constant: a path with 134 M verbs and no points is not a
# shape this stack draws, and one ceiling is one thing to keep true. The behaviour this ceiling
# really exists for is unchanged — the wrap windows are refused, not clamped.
# ⚠ A 2^27-entry path is 1 GiB of verbs + 2 GiB of points and NO SdPoints at all (0.9.0); through
# 0.8.0 the same point count also carried 4 GiB of 16 B records on the seam.
var SD_PATH_CAP_MAX = 134217728;

# ================================================================
# SdPath (48 bytes — the same 48 B since 0.4.0):
#   +0:  verbs      (ptr — array of `vcap` i64 verb tags)
#   +8:  n_verbs    (i64 — verb count)
#   +16: points     (ptr — array of `pcap` INLINE (x, y) PAIRS, 16 B each: x at +0, y at +8)
#   +24: n_points   (i64 — point count)
#   +32: vcap       (i64 — the VERB array's capacity)
#   +40: pcap       (i64 — the POINT array's capacity)
# ================================================================
# ⛔⛔ +16 POINTS AT THE SAME OFFSET, A DIFFERENT ELEMENT (0.9.0) — THE ABI BREAK OF THIS RELEASE.
# Point i was `load64(load64(p + 16) + i * 8)` -> an SdPoint, and is now the two words at
# `load64(p + 16) + i * 16`. The RECORD is still 48 B and every other field is where it was, so a
# consumer that only counts verbs and points compiles and runs unchanged; a consumer that WALKS the
# points array reads a coordinate where it expected a pointer and dereferences it.
# ⇒ sd_path_point_x / sd_path_point_y (below) are the fix, and they are the only read this file
# will promise to keep working. ⚠ The break is loud by construction — an x of 8*65536 dereferenced
# as an SdPoint is a SIGSEGV at the first walk, not a wrong picture — which is why the old shape is
# NOT kept readable behind a flag: a silent half-port is the worse failure.
# ⚠ THE SWEEP, re-run 2026-09-16: outside this repo the only SD_PATH_* reads anywhere are
# SD_PATH_VERBS_OFFSET / SD_PATH_POINTS_OFFSET in SIX rekha test programs, of which FIVE index the
# points array (14 point-array reads between them: cff_test 7, glyf_edge_test 4, path_start_test 1,
# hostile_test 1, bench_hotpath 1 — a read here is one load FROM the array, which then yielded an
# SdPoint pointer). The sixth, path_test, reads SD_PATH_VERBS_OFFSET only and is unaffected: that
# stream did not change shape. rekha's own src/ names no SD_PATH_* constant at all. dhancha names
# sd_path_new's cost in comments only, agnos's refagree calls the public API, and crab and puka
# vendor a stale
# dist/sadish.cyr wholesale (crab draws through its own copy; puka's is inert — no sadish dep, no
# sd_path_* call). Nothing anywhere hand-builds an SdPath, and sd_path_new / sd_path_new_cap are
# still the only constructors.
# ⛔⛔ +40 WAS `reserved` THROUGH 0.7.1, AND IS THE POINT ARRAY'S CAPACITY FROM 0.7.2. That word was
# written 0 by every constructor and read by NOTHING — so no record any consumer holds changed
# meaning and the record is still 48 B. The name SD_PATH_RESERVED_OFFSET is GONE rather than
# aliased: a constant that says "reserved" pointing at a live capacity is the trap, not the fix.
# ⚠ THE SWEEP THAT SAYS SO, AND THE COMPLETE SET OF PLACES A STALE COPY LIVES (re-run 2026-09-16):
# src/, programs/, rekha, dhancha, agnos, and the TWO repos that vendor dist/sadish.cyr wholesale —
# crab AND puka (puka/lib/sadish.cyr:925 still carries 0.7.1's SD_PATH_RESERVED_OFFSET; puka's own
# src/, programs/ and tests/ name no SD_PATH_* constant and call no sd_path_* function, and its
# cyrius.cyml declares no sadish dep, so the copy is inert). Outside this repo the only SD_PATH_*
# READS anywhere are SD_PATH_VERBS_OFFSET / SD_PATH_POINTS_OFFSET in six rekha test programs (the
# same six the ⛔⛔ block above breaks down: five index the points array, path_test reads verbs
# only), and no repo calls sd_path_grow — whose arity changed here — at all.
# ⚠ ONE SHAPE DOES CHANGE: a record a consumer HAND-BUILT to the 0.7.1 layout carries 0 at +40, and
# a 0 point capacity is refused (SADISH_ERR_OOM from _sd_path_reserve / sd_path_push_point) rather
# than written through — the safe direction, and the reason both capacities are 0-checked. Nothing
# in this repo or in any of those five repos hand-builds one; sd_path_new / sd_path_new_cap are the
# only constructors.
var SD_PATH_VERBS_OFFSET   = 0;
var SD_PATH_NVERBS_OFFSET  = 8;
var SD_PATH_POINTS_OFFSET  = 16;
var SD_PATH_NPOINTS_OFFSET = 24;
var SD_PATH_CAP_OFFSET     = 32;
var SD_PATH_PCAP_OFFSET    = 40;
var SD_PATH_SIZE           = 48;
# One point SLOT of an SdPath's points array, in bytes: x at +0, y at +8 (0.9.0; 8 B, a pointer,
# through 0.8.0).
# ⚠ THREE CONSTANTS ARE 16 AND ALL THREE MEAN SOMETHING DIFFERENT. Nothing makes them equal but the
# fact that each happens to hold two i64s, and a change to one must not be propagated to the others:
#   SD_PATH_PT_SIZE      this — the stride of an SdPath's points array
#   SD_POLYLINE_PT_SIZE  the stride of an SdPolyline's points array (0.10.0)
#   SD_POINT_SIZE        the size of a standalone SdPoint record (src/geom.cyr), which is now only
#                        an ARGUMENT type — since 0.10.0 no STORE in sadish is an SdPoint.
var SD_PATH_PT_SIZE        = 16;

# Which array sd_path_grow doubles.
var SD_PATH_GROW_VERBS  = 0;
var SD_PATH_GROW_POINTS = 1;

# An empty SdPath whose verb array holds `vcap` entries and whose point array holds `pcap` — the
# two are INDEPENDENT (0.7.2; through 0.7.1 one `cap` sized both). 0 if ANY of the three
# allocations is refused — record, verbs and points, in that order (0.7.1; through 0.7.0 only the
# record was checked and a refused verb array was stored as 0, which the first sd_path_moveto then
# wrote through: SIGSEGV, rekha's filing). An earlier block of a failed path is abandoned; the
# allocator sadish draws from has no free().
# ⛔ BOTH capacities are bounded BEFORE either multiply — see SD_PATH_CAP_MAX. `cap * 8` (verbs) or
# `cap * 16` (points) on an unrepresentable capacity wraps to a small block the first pushes then
# run off the end of, and no 0-check can see that: both allocations SUCCEED. ⚠ The two ceiling
# tests run before the FIRST sd_alloc, so an over-ceiling point capacity costs zero allocations even
# though the verb array is allocated first (programs/path_cap_test.cyr counts them).
# ⚠ THE THREE REQUESTS ARE STILL THREE, AND THE THIRD ONE DOUBLED: 48 B, `vcap * 8`, `pcap * 16`
# (0.9.0; `pcap * 8` through 0.8.0, with a 16 B sd_alloc per point AFTER it). A path at exact
# capacity is now THREE allocations whatever its point count — that is the release, in one line.
fn _sd_path_alloc(vcap, pcap): i64 {
    if (vcap > SD_PATH_CAP_MAX) { return 0; }
    if (pcap > SD_PATH_CAP_MAX) { return 0; }
    var p = sd_alloc(SD_PATH_SIZE);
    if (p == 0) { return 0; }
    var verbs = sd_alloc(vcap * 8);
    if (verbs == 0) { return 0; }
    var points = sd_alloc(pcap * SD_PATH_PT_SIZE);
    if (points == 0) { return 0; }
    store64(p + SD_PATH_VERBS_OFFSET, verbs);
    store64(p + SD_PATH_NVERBS_OFFSET, 0);
    store64(p + SD_PATH_POINTS_OFFSET, points);
    store64(p + SD_PATH_NPOINTS_OFFSET, 0);
    store64(p + SD_PATH_CAP_OFFSET, vcap);
    store64(p + SD_PATH_PCAP_OFFSET, pcap);
    return p;
}

# @public — allocate an empty path at the default capacity: SD_PATH_CAP = 256 verbs and
# SD_PATH_PCAP = 128 points (0.9.0; 256 points through 0.8.0 — see SD_PATH_PCAP for why the point
# half halved when the slot doubled). MEASURED, and unchanged since 0.4.0: 48 + 2,048 + 2,048 =
# **4,144 B in 3 allocations**.
# ⭐ WHAT DID CHANGE IS WHAT COMES AFTER IT: a push costs NOTHING until an array overflows, so
# rekha's small path — moveto + 2 linetos + close — is **4,144 B in 3 calls** where 0.8.0 paid
# 4,192 B in 6. The three SdPoints and the three sd_alloc calls that built them are gone.
# ⚠ A caller that knows its size should still use sd_path_new_cap: the same small path is 240 B
# there, and the 95-glyph ASCII set falls from 393,680 B to 58,672 B
# (docs/development/proposals/archived/2026-09-15-path-capacity-for-known-size-paths.md).
fn sd_path_new(): i64 {
    return _sd_path_alloc(SD_PATH_CAP, SD_PATH_PCAP);
}

# @public — allocate an empty path sized for `n_verbs` verbs and `n_points` points, so a caller
# that knows the shape ahead of the first moveto never pays a doubling. Returns 0 if any
# allocation is refused.
#
# ⭐⭐ TWO CAPACITIES, TWO ARRAYS (0.7.2) — n_verbs sizes the verb array and n_points the point
# array, each clamped on its own into [SD_PATH_CAP_MIN, SD_PATH_CAP_MAX]. ⚠ Through 0.7.1 the two
# arguments COLLAPSED TO THEIR MAX because one field sized both arrays; a glyph therefore bought
# about 2x more verb slots than it uses, since a TrueType contour of n points emits at most n + 1
# verbs and 2n + 1 points. The signature did not change — a 0.7.1 call site is already correct.
# MEASURED (95 ASCII-shaped paths — 1,768 verbs, 2,498 points, largest glyph 61 verbs — built
# through sd_path_moveto/lineto/quadto/close on the allocation seam, programs/path_cap_test.cyr):
#   sd_path_new(), 0.8.0                  433,648 B in 2,783 calls  (95 x 4,144 + 2,498 x 16)
#   sd_path_new(), HERE                   393,680 B in   285 calls  (95 x 4,144, and no records)
#   sd_path_new_cap, ONE capacity (0.7.1)  84,496 B                 = 5.13x less than 0.8.0's row
#   sd_path_new_cap, two capacities (0.7.2) 78,656 B in 2,783 calls = 5.51x
#   the same, INLINE (x, y) points, HERE    58,672 B in   285 calls = 6.71x less than THIS tree's
#                                                                     own sd_path_new row
# = 95 x 48 (records) + 8 x 1,768 (verbs) + 16 x 2,498 (point slots), and NOTHING ELSE — the 39,968
# B of SdPoint records and the 2,498 sd_alloc calls that built them are gone. ⭐ THE CALL COUNT IS
# THE OTHER HALF: 285 = 3 per path, whatever the path holds.
# ⚠ The 58,672 B is the figure this proposal's "Worth measuring alongside" section computed in
# 0.7.1 and asked to be hit; programs/path_cap_test.cyr group L pins it on the seam.
# ⭐ NOT a cap: an underestimate is still correct. Each array doubles on its own overflow exactly as
# it does for sd_path_new, so a path asked for at 4 that takes 300 points ends up where it would
# have ended up anyway — it just pays for the doublings, and only in the array that overflowed.
# ⚠ 0 or negative for either argument is raised to SD_PATH_CAP_MIN = 8 — INDEPENDENTLY, so
# sd_path_new_cap(61, 0) is a 61-verb, 8-point path, not an error and not a default-sized one.
# ⛔ AND THE OTHER END IS REFUSED, NOT CLAMPED: EITHER capacity above SD_PATH_CAP_MAX = 2^27 (0.9.0;
# 2^28 through 0.8.0) returns 0. That is the ceiling `cap * 8` (verbs) and `cap * 16` (points) stay
# representable and servable under (see SD_PATH_CAP_MAX) — a count read out of a file is exactly the
# shape of argument that reaches 2^60 and wraps.
fn sd_path_new_cap(n_verbs, n_points): i64 {
    var vcap = n_verbs;
    if (vcap < SD_PATH_CAP_MIN) { vcap = SD_PATH_CAP_MIN; }
    var pcap = n_points;
    if (pcap < SD_PATH_CAP_MIN) { pcap = SD_PATH_CAP_MIN; }
    return _sd_path_alloc(vcap, pcap);
}

# ---- accessors --------------------------------------------------
# @public
fn sd_path_verb_count(path): i64  { return load64(path + SD_PATH_NVERBS_OFFSET); }
# @public
fn sd_path_point_count(path): i64 { return load64(path + SD_PATH_NPOINTS_OFFSET); }
# @public — how many verbs the verb array can hold before it doubles (0.7.2). sd_path_new() reports
# SD_PATH_CAP; sd_path_new_cap(v, p) reports v clamped into [SD_PATH_CAP_MIN, SD_PATH_CAP_MAX].
fn sd_path_verb_cap(path): i64  { return load64(path + SD_PATH_CAP_OFFSET); }
# @public — how many points the point array can hold before it doubles (0.7.2). This is the word at
# +40 that was `reserved` through 0.7.1 — see the record layout above.
fn sd_path_point_cap(path): i64 { return load64(path + SD_PATH_PCAP_OFFSET); }

# ⭐⭐ THE PUBLISHED WAY TO READ A PATH'S GEOMETRY (0.9.0) — sd_path_point_x / sd_path_point_y /
# sd_path_verb_at. Use these and the layout above is sadish's business; index the arrays yourself
# and you are writing against a record that changed shape in 0.9.0 and can again.
# ⚠ THEY DO NOT BOUNDS-CHECK, exactly as sd_polyline_count / sd_path_verb_count do not test `path`:
# `i` must be in [0, sd_path_point_count(path)) — one load off the end of a bump-allocated array is
# a stale i64, not a trap, so a walk that runs past the count reads garbage in silence. Bound the
# loop on the count; the count is the contract.
# ⚠ THE COORDINATES ARE RETURNED, NOT AN SdPoint. There is no record to free, to null-check, or to
# keep alive — and no allocation happens here, which is the whole of what 0.9.0 bought. A caller
# that really needs an SdPoint (sd_matrix_apply takes one) builds it: sd_point_new(x, y).
# @public — point `i`'s x, 16.16.
fn sd_path_point_x(path, i): i64 {
    return load64(load64(path + SD_PATH_POINTS_OFFSET) + i * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET);
}
# @public — point `i`'s y, 16.16.
fn sd_path_point_y(path, i): i64 {
    return load64(load64(path + SD_PATH_POINTS_OFFSET) + i * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET);
}
# @public — verb `i`'s tag: SD_VERB_MOVETO / _LINETO / _QUADTO / _CUBICTO / _CLOSE. The verb stream
# is one i64 a verb and did NOT change shape in 0.9.0; this exists so a consumer walking a path
# reaches for accessors in both streams and stops carrying the offsets at all.
fn sd_path_verb_at(path, i): i64 {
    return load64(load64(path + SD_PATH_VERBS_OFFSET) + i * 8);
}

# @public — apply an affine matrix to EVERY point of `path`, IN PLACE (0.10.0). Returns SADISH_OK,
# SADISH_ERR_BOUNDS for a null path or matrix, or SADISH_ERR_UNSUPPORTED for nothing — it cannot
# fail otherwise, because it allocates NOTHING.
#
# ⭐ WHY IT IS ALLOCATION-FREE, AND WHY THAT IS THE WHOLE POINT. sd_matrix_apply takes an SdPoint
# and RETURNS A NEW ONE — a 16 B sd_alloc per point — so the loop every consumer writes by hand
# (`sd_matrix_apply` over a path it rebuilds) costs one allocation per point and a second path.
# A path's points are two plain i64 in a flat array since 0.9.0, so the transform is a read, six
# multiplies and a write, with no record to rebuild and no second path to hold. MEASURED on a
# 2,498-point corpus: the rebuild-through-sd_matrix_apply shape costs 2,498 allocations and a whole
# second path; this costs 0 and touches only the array already there.
# ⚠ IN PLACE means the original geometry IS GONE. Copy the path first if both are wanted — there is
# no sd_path_clone, so that is a build-it-again, which is exactly what a consumer holding a glyph
# outline should do once rather than per frame.
# ⚠ It transforms the CONTROL POINTS, which is correct for affine: an affine image of a Bézier is
# the Bézier of the images of its control points, so curves come out exact, not re-approximated.
# ⚠ A path with no points is SADISH_OK and a no-op — a verb-less path has nothing to move.
fn sd_path_transform(path, m): i64 {
    if (path == 0) { return SADISH_ERR_BOUNDS; }
    if (m == 0) { return SADISH_ERR_BOUNDS; }
    var a = load64(m + SD_MAT_A_OFFSET);
    var b = load64(m + SD_MAT_B_OFFSET);
    var c = load64(m + SD_MAT_C_OFFSET);
    var d = load64(m + SD_MAT_D_OFFSET);
    var e = load64(m + SD_MAT_E_OFFSET);
    var f = load64(m + SD_MAT_F_OFFSET);
    var pts = load64(path + SD_PATH_POINTS_OFFSET);
    var n = load64(path + SD_PATH_NPOINTS_OFFSET);
    var i = 0;
    while (i < n) {
        var xo = i * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET;
        var yo = i * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET;
        var x = load64(pts + xo);
        var y = load64(pts + yo);
        # The same arithmetic as sd_matrix_apply, to the raw unit — see its header.
        store64(pts + xo, sd_fixed_mul(a, x) + sd_fixed_mul(c, y) + e);
        store64(pts + yo, sd_fixed_mul(b, x) + sd_fixed_mul(d, y) + f);
        i = i + 1;
    }
    return SADISH_OK;
}

# @public — the axis-aligned bounding box of `path`'s POINTS, written to the caller's 32 B buffer
# `out` as four 16.16 words: min x at +0, min y at +8, max x at +16, max y at +24 (0.10.0).
# Returns SADISH_OK, SADISH_ERR_BOUNDS for a null path or null `out`, or SADISH_ERR_EMPTY_PATH for
# a path with no points — in which case `out` IS NOT WRITTEN, because there is no defensible box
# for an empty path and a zeroed one would read as a real box at the origin.
#
# ⚠ THE CONTROL POINT HULL, NOT THE INK. A Bézier lies inside its control polygon but need not
# touch it, so a path with curves reports a box that CONTAINS the drawn shape and may be larger
# than it. That is the cheap, allocation-free answer and it is the right one for culling, damage
# tracking and layout — all of which need a conservative superset. A consumer that needs the tight
# box of the drawn curve flattens first and bounds the polyline.
# ⛔ IT IS RECOMPUTED ON EVERY CALL, not cached. SdPath's 48 B record has no spare word — 0.7.2
# spent the one annotated "bounds-cached" on the point capacity — so caching would be an ABI break
# of its own. O(n) over a flat array is cheap; a caller in a hot loop holds the result itself.
fn sd_path_bounds(path, out): i64 {
    if (path == 0) { return SADISH_ERR_BOUNDS; }
    if (out == 0) { return SADISH_ERR_BOUNDS; }
    var n = load64(path + SD_PATH_NPOINTS_OFFSET);
    if (n == 0) { return SADISH_ERR_EMPTY_PATH; }
    var pts = load64(path + SD_PATH_POINTS_OFFSET);
    var minx = load64(pts + SD_POINT_X_OFFSET);
    var miny = load64(pts + SD_POINT_Y_OFFSET);
    var maxx = minx;
    var maxy = miny;
    var i = 1;
    while (i < n) {
        var x = load64(pts + i * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET);
        var y = load64(pts + i * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET);
        if (x < minx) { minx = x; }
        if (x > maxx) { maxx = x; }
        if (y < miny) { miny = y; }
        if (y > maxy) { maxy = y; }
        i = i + 1;
    }
    store64(out + 0, minx);
    store64(out + 8, miny);
    store64(out + 16, maxx);
    store64(out + 24, maxy);
    return SADISH_OK;
}

# Bytes a caller must give sd_path_bounds: four 16.16 words.
var SD_BOUNDS_SIZE = 32;

# Double ONE of the two arrays — `which` is SD_PATH_GROW_VERBS or SD_PATH_GROW_POINTS — copying its
# live entries. Returns SADISH_OK, or SADISH_ERR_OOM if the allocation fails.
# ⭐ ONE ARRAY, ONE ALLOCATION (0.7.2). Through 0.7.1 this doubled BOTH arrays whichever one
# overflowed, so a path whose points outran its verbs bought verb slots it had no verbs for. The
# overflowing array now doubles alone and the other one does not move — which is what makes
# sd_path_new_cap's two capacities survive the first growth.
# ⛔ THE TWO ARRAYS HAVE DIFFERENT ELEMENT SIZES NOW (0.9.0), so the request AND the copy length are
# `esz` below: 8 B a verb, SD_PATH_PT_SIZE = 16 B a point. Through 0.8.0 both were 8 and one
# constant did for both; a 0.9.0 growth that kept the 8 for points allocates HALF the block it
# needs and copies half the bytes — the shape programs/inline_points_test.cyr group D3 exists to
# catch (MEASURED as that mutation: 800 bad coordinates).
# ⛔ THE COPY LENGTH COMES FROM THE SAME ARRAY'S OWN LIVE COUNT (`n_off`), AND SINCE 0.9.0 BOTH
# HALVES ARE QUIET. n_verbs and n_points differ on every path whose verbs outnumber its points — a
# default path holding 256 closes and no points at all is the extreme — and a copy taken from the
# other count moves the wrong number of bytes into a FRESH block.
# ⚠ WHAT CHANGED HERE, AND IT MAKES THE SUITES MATTER MORE, NOT LESS: through 0.8.0 a lost POINT
# slot read back as a null SdPoint pointer that the next walk dereferenced — a SIGSEGV, loud and
# immediate — while a lost VERB tag read back as 0 = SD_VERB_MOVETO and was the silent half.
# INLINE, a lost point slot reads back as the COORDINATE (0, 0): a perfectly valid point at the
# origin, and a wrong picture instead of a crash. MEASURED with `n_off` taken from the other count
# (0.8.0): 26 of 28 suites passed and grow_edges_test SIGSEGVed. So neither array can be left to
# fault for us: programs/path_cap_test.cyr groups E3/E4/G read every verb back after a growth, and
# programs/inline_points_test.cyr group D reads every point's COORDINATES back across six
# doublings, because a coordinate compare is now the only witness either way.
# ⛔ A capacity past SD_PATH_CAP_MAX / 2 cannot double — `newcap * esz` would be past what the
# allocator serves (see SD_PATH_CAP_MAX) — so the doubling is REFUSED rather than wrapped into a
# small block. Unreachable from sadish's own constructors, which bound both capacities at
# SD_PATH_CAP_MAX; this holds for a record a consumer wrote a capacity into itself.
fn sd_path_grow(path, which): i64 {
    var cap_off = SD_PATH_CAP_OFFSET;
    var arr_off = SD_PATH_VERBS_OFFSET;
    var n_off = SD_PATH_NVERBS_OFFSET;
    var esz = 8;
    if (which == SD_PATH_GROW_POINTS) {
        cap_off = SD_PATH_PCAP_OFFSET;
        arr_off = SD_PATH_POINTS_OFFSET;
        n_off = SD_PATH_NPOINTS_OFFSET;
        esz = SD_PATH_PT_SIZE;
    }
    var cap = load64(path + cap_off);
    if (cap > SD_PATH_CAP_MAX / 2) { return SADISH_ERR_OOM; }
    var newcap = cap * 2;
    var blk = sd_alloc(newcap * esz);
    if (blk == 0) { return SADISH_ERR_OOM; }
    memcpy(blk, load64(path + arr_off), load64(path + n_off) * esz);
    store64(path + arr_off, blk);
    store64(path + cap_off, newcap);
    return SADISH_OK;
}

# Append one verb tag, growing the VERB array if it is full. Returns SADISH_OK
# (or SADISH_ERR_OOM only if that grow allocation fails).
fn sd_path_push_verb(path, verb): i64 {
    var n = load64(path + SD_PATH_NVERBS_OFFSET);
    if (n >= load64(path + SD_PATH_CAP_OFFSET)) {
        var g = sd_path_grow(path, SD_PATH_GROW_VERBS);
        if (g != SADISH_OK) { return g; }
    }
    store64(load64(path + SD_PATH_VERBS_OFFSET) + n * 8, verb);
    store64(path + SD_PATH_NVERBS_OFFSET, n + 1);
    return SADISH_OK;
}

# Append the point (x, y) INLINE, growing the POINT array if it is full.
# ⚠ THE SIGNATURE CHANGED IN 0.9.0 — it took an SdPoint POINTER (`sd_path_push_point(path, pt)`)
# and takes two coordinates now. It is not @public and no repo outside this one calls it (swept
# 2026-09-16 across rekha, dhancha, agnos, setu, crab and puka), but it IS in dist/sadish.cyr, so
# the change is named here rather than left to be discovered.
fn sd_path_push_point(path, x, y): i64 {
    var n = load64(path + SD_PATH_NPOINTS_OFFSET);
    if (n >= load64(path + SD_PATH_PCAP_OFFSET)) {
        var g = sd_path_grow(path, SD_PATH_GROW_POINTS);
        if (g != SADISH_OK) { return g; }
    }
    var slot = load64(path + SD_PATH_POINTS_OFFSET) + n * SD_PATH_PT_SIZE;
    store64(slot + SD_POINT_X_OFFSET, x);
    store64(slot + SD_POINT_Y_OFFSET, y);
    store64(path + SD_PATH_NPOINTS_OFFSET, n + 1);
    return SADISH_OK;
}

# ⛔ THE ORDER THE BUILDERS BELOW PUSH IN IS LOAD-BEARING (0.7.1), AND 0.9.0 MADE IT SIMPLER RATHER
# THAN LOOSER. Through 0.7.0 each of them pushed its VERB first and then built its points, so a
# refusal anywhere after the verb left the path HALF-WRITTEN — a quadto verb with one point behind
# it, which every later walk (flatten, fill, stroke) reads as the NEXT verb's point. 0.7.1 made each
# builder (1) reserve capacity for the whole verb, (2) allocate every SdPoint it needed, and only
# then (3) push. ⭐ STEP (2) IS GONE (0.9.0): the coordinates go straight into the array, so the
# ONLY allocation a builder can make is the growth inside step (1) — after a successful reserve,
# every push below is a store into a block that is already there and CANNOT fail.
# ⇒ A failure returns SADISH_ERR_OOM with the path's VERBS, POINTS AND CONTENTS exactly as they
# were, and the path is still usable: the next call may succeed. The window where a verb could be
# pushed and its point refused does not exist any more; it is closed by construction, not by order.
# ⚠ WHAT "UNCHANGED" STILL DOES NOT COVER: a refused GROWTH can leave the OTHER array already
# grown — a bigger capacity and a new block, the old one abandoned to an allocator with no free()
# (_sd_path_reserve grows verbs first). MEASURED: a path at SD_PATH_CAP_MIN holding 8 verbs and 8
# points, under a hook granting the verb growth and refusing the point growth — sd_path_lineto
# returns SADISH_ERR_OOM, vcap 8 -> 16, pcap still 8, and verb count, point count and every stored
# coordinate are untouched; the next lineto returns SADISH_OK.
# ⇒ The cost of a refusal is bounded by ONE doubling PER ARRAY, and nothing a caller can read
# through the public accessors moved except the capacities.
#
# Make room for `nv` more verbs AND `np` more points, doubling EACH array to its OWN need (0.7.2;
# through 0.7.1 one capacity had to cover both, so either need doubled both arrays). SADISH_OK, or
# SADISH_ERR_OOM with the path unchanged. ⚠ The doubling count per array is the same as pushing one
# at a time reaches — the capacity a verb's last push would have forced is the capacity its first
# push reserves.
# ⚠ VERBS ARE GROWN FIRST, so a refusal of the POINT growth can leave the verb array already
# doubled (one abandoned block, the capacity raised) — the same bounded cost the builders' header
# describes, and nothing readable through the public accessors moves.
fn _sd_path_reserve(path, nv, np): i64 {
    var needv = load64(path + SD_PATH_NVERBS_OFFSET) + nv;
    var needp = load64(path + SD_PATH_NPOINTS_OFFSET) + np;
    # A capacity of 0 cannot double its way anywhere: refuse rather than spin. Both are checked —
    # a record hand-built to the 0.7.1 layout carries 0 at +40 (see SD_PATH_PCAP_OFFSET).
    if (load64(path + SD_PATH_CAP_OFFSET) <= 0) { return SADISH_ERR_OOM; }
    if (load64(path + SD_PATH_PCAP_OFFSET) <= 0) { return SADISH_ERR_OOM; }
    while (load64(path + SD_PATH_CAP_OFFSET) < needv) {
        var gv = sd_path_grow(path, SD_PATH_GROW_VERBS);
        if (gv != SADISH_OK) { return gv; }
    }
    while (load64(path + SD_PATH_PCAP_OFFSET) < needp) {
        var gp = sd_path_grow(path, SD_PATH_GROW_POINTS);
        if (gp != SADISH_OK) { return gp; }
    }
    return SADISH_OK;
}

# @public — start a new subpath at (x, y) (16.16). Returns SADISH_OK, or SADISH_ERR_OOM with the
# path's verbs and points unchanged — see the ⚠ above for the one thing that can move, the
# capacity. ⚠ Since 0.9.0 a GROWTH IS THE ONLY WAY THIS RETURNS OOM: a path with room makes no
# allocation at all, where through 0.8.0 it always made one (the SdPoint) and could be refused.
# ⛔ A REFUSED MOVETO MUST ABANDON THE SUBPATH, NOT FALL THROUGH TO THE LINETO. The path is left
# exactly as it was — which means a caller that logs the OOM and carries on building appends its
# linetos to NO CURRENT POINT, and a path whose first verb is a LINETO faults the rasterizer
# (raster.cyr's fill starts at cur = 0 and sd_edge_add reads through it: MEASURED SIGSEGV, on
# 0.7.0 and here alike). Through 0.7.0 the refusal killed the process at the moveto instead, so
# this shape was not reachable; the clean return code is what makes it worth saying.
fn sd_path_moveto(path, x, y): i64 {
    var r = _sd_path_reserve(path, 1, 1);
    if (r != SADISH_OK) { return r; }
    sd_path_push_verb(path, SD_VERB_MOVETO);
    return sd_path_push_point(path, x, y);
}

# @public — straight line to (x, y) from the current point.
# SADISH_OK / SADISH_ERR_OOM (verbs and points unchanged).
fn sd_path_lineto(path, x, y): i64 {
    var r = _sd_path_reserve(path, 1, 1);
    if (r != SADISH_OK) { return r; }
    sd_path_push_verb(path, SD_VERB_LINETO);
    return sd_path_push_point(path, x, y);
}

# @public — quadratic Bézier: control (cx, cy), end (x, y).
# SADISH_OK / SADISH_ERR_OOM (verbs and points unchanged).
fn sd_path_quadto(path, cx, cy, x, y): i64 {
    var r = _sd_path_reserve(path, 1, 2);
    if (r != SADISH_OK) { return r; }
    sd_path_push_verb(path, SD_VERB_QUADTO);
    sd_path_push_point(path, cx, cy);
    return sd_path_push_point(path, x, y);
}

# @public — cubic Bézier: controls (c1x,c1y),(c2x,c2y), end (x, y).
# SADISH_OK / SADISH_ERR_OOM (verbs and points unchanged).
fn sd_path_cubicto(path, c1x, c1y, c2x, c2y, x, y): i64 {
    var r = _sd_path_reserve(path, 1, 3);
    if (r != SADISH_OK) { return r; }
    sd_path_push_verb(path, SD_VERB_CUBICTO);
    sd_path_push_point(path, c1x, c1y);
    sd_path_push_point(path, c2x, c2y);
    return sd_path_push_point(path, x, y);
}

# @public — close the current subpath (back to its moveto). No point.
fn sd_path_close(path): i64 {
    return sd_path_push_verb(path, SD_VERB_CLOSE);
}

# ================================================================
# sd_path_flatten — expand curve verbs into a straight-line polyline
# within `tol` (a 16.16 flatness tolerance) and return an SdPolyline: a
# small header + an array of INLINE COORDINATE PAIRS.
#
# SdPolyline (24 bytes since 0.8.0; 16 through 0.7.2):
#   +0:  points   (ptr — array of (x, y) pairs, 16 B a slot; SdPoint PTRS through 0.9.1)
#   +8:  count    (i64 — number of points)
#   +16: verdict  (i64 — SD_POLYLINE_TRUNCATED | SD_POLYLINE_DEGRADED, 0 = whole)
#
# ⛔⛔ READ A POLYLINE'S POINTS THROUGH sd_polyline_point_x / sd_polyline_point_y (0.10.0), for the
# same reason sd_path_point_x / _y exist since 0.9.0 and with the same force: the slot below is
# sadish's, and through 0.9.1 there was NO accessor, so every reader in this tree and every consumer
# open-coded `sd_point_x(load64(sd_polyline_points(pl) + i * 8))`. That spelling now reads an x
# COORDINATE as an address — an immediate fault for any path off the origin, and a wrong answer for
# one on it. ⚠ Half of why this break is worth taking is that there is an accessor to move to.
#   var i = 0;
#   while (i < sd_polyline_count(pl)) {
#       ... sd_polyline_point_x(pl, i), sd_polyline_point_y(pl, i) ...   # 16.16, no allocation
#       i = i + 1;
#   }
# ⭐ WHAT THE BREAK BUYS: a flattened point costs NO ALLOCATION. Through 0.9.1 an emitted point was
# a 16 B sd_alloc on the consumer's seam — and 0.9.0 made that worse, not better, because a path's
# points went inline and every curve ENDPOINT then had to be materialised too. MEASURED across the
# tree: a styled stroke of a cubic 128 B -> 0 (programs/stroke_style_test.cyr #8), a dashed one
# 224 B -> 0 (dash_test #128), a fill of the hostile 4,096-quad path 1,110,016 B / 69,376 calls -> 0
# / 0 (flatten_bound_test #102-103), and a 20,001-point sd_path_flatten 20,004 calls -> 5
# (grow_edges_test C7). ⇒ Nothing in a flatten is per-point or per-curve any more; what is left is
# per-DOUBLING of the output array.
# ⚠ AND WHAT IT COSTS, SAID PLAINLY: a slot is 16 B where it was 8, so on an arena with no free()
# the CUMULATIVE bytes of a large flatten go UP even as the live bytes and the call count go down.
# SD_FLATTEN_PCAP's header has the arithmetic; grow_edges_test C7 has it measured both ways.
# ================================================================
# ⭐⭐ THE RESULT CARRIES ITS OWN VERDICT (0.8.0) — item 1 of
# docs/development/issues/archived/2026-09-15-flatten-keeps-subdividing-and-allocating-after-the-output-cap-is-full.md's
# "Still open" section, whose Suggested fix asked for "a flag on the polyline (or an error the
# fill/stroke can see) so a truncated contour is refused or clearly degraded, rather than filled
# open". 0.7.1 and 0.7.2 shipped the parenthetical — sd_canvas_fill_path and the three stroke
# entries return SADISH_ERR_OOM for a starved draw — and left the first half undone: a consumer
# holding an SdPolyline could not tell a complete flattening from a PREFIX of one. The
# process-wide sd_flatten_truncated() / sd_flatten_degraded() were the only witnesses, and both
# are deliberately sticky (one until the next sd_path_flatten, one until the next operation
# opens at depth 0), so neither answers "is THIS polyline whole?" for a result taken a while ago.
# ⇒ Two bits, captured when sd_path_flatten's verb walk finishes, in the record itself. They never
# move again: a later flatten sets the globals and cannot touch a polyline already returned.
# ⚠ THE RECORD GREW BY ONE WORD, 16 B -> 24 B, and the ONLY reason that is affordable is that
# nothing embeds it. Swept 2026-09-16 across src/, programs/, rekha, dhancha, agnos, setu and the
# two repos that vendor dist/sadish.cyr (crab, puka): sd_path_flatten is the one constructor,
# src/path.cyr is the one writer, no SdPolyline is ever a field of another record or an array
# element, and every reader outside this file goes through sd_polyline_count / sd_polyline_points
# (crab vendors its own OLDER copy of all of this and is unaffected until it re-vendors — the
# argument does not rest on which tag: any pre-0.10.0 bundle is self-contained, carrying the
# matching reader for the layout it also carries. ⚠ The exact tag is UNKNOWN from inside this repo
# and the two records here disagree — README.md says 0.5.4 as of crab 0.8.10, an archived filing
# said 0.5.5, this line once said 0.6-vintage. Do not restate a number none of us can check).
# ⚠ THAT SWEEP IS WHAT 0.10.0 RESTED ON TOO — the HEADER is unchanged at 24 B and
# the three offsets below are where they were; it is the ARRAY the header points at whose slot
# changed, which is exactly the shape the sweep found no embedder for.
# ⛔ It is ONE WORD OF BITS, not two words of booleans, so a third verdict costs no more bytes.
# Read it with the accessors; SD_POLYLINE_VERDICT_OFFSET is for a consumer that walks raw records.
var SD_POLYLINE_POINTS_OFFSET  = 0;
var SD_POLYLINE_COUNT_OFFSET   = 8;
var SD_POLYLINE_VERDICT_OFFSET = 16;
var SD_POLYLINE_SIZE           = 24;

# One point slot in a polyline's array: x at +0, y at +8 (0.10.0; an 8 B SdPoint POINTER through
# 0.9.1). ⚠ It is the same 16 as SD_POINT_SIZE and SD_PATH_PT_SIZE and means a third thing — the
# stride of THIS array. They are equal by arithmetic, not by contract; a slot that ever carries a
# third word moves only this one.
var SD_POLYLINE_PT_SIZE = 16;

# Points this flattening WANTED to emit were lost — a growth or an SdPoint was refused — so the
# array is a PREFIX of the true flattening. The contour it describes is OPEN where it stops.
var SD_POLYLINE_TRUNCATED = 1;
# At least one curve was cut to its chord because the operation's point budget ran out. Every
# point asked for is present; some of them are the wrong points. See SD_FLATTEN_BUDGET_DEFAULT.
var SD_POLYLINE_DEGRADED  = 2;

# @public
fn sd_polyline_count(pl): i64  { return load64(pl + SD_POLYLINE_COUNT_OFFSET); }
# @public — the raw points block. ⛔ SINCE 0.10.0 ITS SLOTS ARE COORDINATE PAIRS, NOT POINTERS:
# a consumer that did `sd_point_x(load64(sd_polyline_points(pl) + i * 8))` reads a COORDINATE as an
# address and faults. Read through sd_polyline_point_x / _y instead; this stays published for a
# caller that walks the block itself, which must now stride SD_POLYLINE_PT_SIZE.
fn sd_polyline_points(pl): i64 { return load64(pl + SD_POLYLINE_POINTS_OFFSET); }

# @public — point `i`'s x, 16.16. ⚠ No bounds check — bound the loop on sd_polyline_count.
# ⭐ These are the reason the 0.10.0 break is survivable, exactly as sd_path_point_x / _y were for
# 0.9.0's: through 0.9.1 there was NO accessor, so every reader in the tree and every consumer
# open-coded the pointer load. Now none of them carry an offset.
fn sd_polyline_point_x(pl, i): i64 {
    return load64(load64(pl + SD_POLYLINE_POINTS_OFFSET) + i * SD_POLYLINE_PT_SIZE + SD_POINT_X_OFFSET);
}
# @public — point `i`'s y, 16.16.
fn sd_polyline_point_y(pl, i): i64 {
    return load64(load64(pl + SD_POLYLINE_POINTS_OFFSET) + i * SD_POLYLINE_PT_SIZE + SD_POINT_Y_OFFSET);
}

# @public — this polyline's own verdict word (0.8.0): 0, or SD_POLYLINE_TRUNCATED and/or
# SD_POLYLINE_DEGRADED ORed together. Fixed when sd_path_flatten built the record; unlike
# sd_flatten_truncated() / sd_flatten_degraded() it answers for THIS result and nothing else, so
# a consumer may hold several polylines and ask each of them.
# ⚠ Like sd_polyline_count and sd_polyline_points, it does NOT test `pl` — a 0 from
# sd_path_flatten is a documented return the caller checks before reading anything (src/alloc.cyr).
fn sd_polyline_verdict(pl): i64 { return load64(pl + SD_POLYLINE_VERDICT_OFFSET); }

# @public — 1 if points were LOST while this polyline was flattened, so its point array stops
# short of the true flattening and the contour is open at that end. The partial result is handed
# back rather than refused — see sd_path_flatten's header for why — so THIS is what a caller
# tests before filling or stroking the result.
fn sd_polyline_truncated(pl): i64 {
    if ((load64(pl + SD_POLYLINE_VERDICT_OFFSET) & SD_POLYLINE_TRUNCATED) != 0) { return 1; }
    return 0;
}

# @public — 1 if at least one curve of this polyline was cut to its chord by the flatten budget.
# The point count is whole; the shape is not the shape that was asked for. ⚠ It is the CALL's
# verdict, not the operation's: two flattens inside one sd_flatten_op_begin scope share a budget,
# and only the one whose curve was actually cut reports it (sd_flatten_degraded() reports both).
fn sd_polyline_degraded(pl): i64 {
    if ((load64(pl + SD_POLYLINE_VERDICT_OFFSET) & SD_POLYLINE_DEGRADED) != 0) { return 1; }
    return 0;
}

# ---- flatten internals (adaptive de Casteljau) ------------------
# Initial capacity + recursion depth cap. A single curve subdivides to at most 2^depth segments
# (256: every leaf of the recursion emits one point).
# ⚠ SD_FLATTEN_CAP NO LONGER SIZES THE POINT STORES — 0.10.0 split that off into SD_FLATTEN_PCAP
# below, and this paragraph said otherwise until 0.11.0. What it sizes now is the stores whose slot
# did NOT change when a point went 8 B to 16: raster.cyr's fill EDGE LIST and CROSSINGS, and
# stroke.cyr's RUN — all of which GROW past it since 0.7.0 (through 0.6.0 each dropped what did not
# fit). sd_path_flatten's result and the fill's and stroker's per-curve flatten buffers take
# SD_FLATTEN_PCAP instead. ⛔ Read the two together; they are one decision in two constants.
var SD_FLATTEN_CAP       = 8192;
var SD_FLATTEN_MAX_DEPTH = 8;

# ⭐ THE POINT STORES' INITIAL CAPACITY, HALVED AS THE SLOT DOUBLED (0.10.0) — the same move
# SD_PATH_PCAP made for SD_PATH_CAP in 0.9.0, and for the same reason. A polyline slot went 8 B
# (an SdPoint ptr) to 16 B (the coordinates), so at SD_FLATTEN_CAP the first allocation of every
# point store would have doubled, 65,536 B -> 131,072 B, and a flatten of four points would pay it.
# At 4096 * 16 the first allocation is **65,536 B — byte-identical to every release since 0.7.0**.
# ⚠ SD_FLATTEN_CAP still sizes the stores whose slot did NOT change: raster.cyr's fill edge list
# and crossings, and stroke.cyr's run. Only the three POINT stores take this one — sd_path_flatten's
# output and the fill's and stroker's per-curve buffers.
# ⛔ The per-curve buffers are FIXED (no growth) and this halving is still ample: one curve emits at
# most 2^SD_FLATTEN_MAX_DEPTH = 256 points, so 4096 is 16x headroom. The flatten OUTPUT grows, so a
# path past 4096 points pays one extra doubling and nothing else.
var SD_FLATTEN_PCAP      = 4096;

# ================================================================
# THE PER-OPERATION WORK BUDGET, in POINTS EMITTED (0.7.1).
#
# ⛔⛔ WHY A BUDGET EXISTS, AND WHY IT IS A TRADE. Through 0.7.0 the work of one flatten was bounded
# by the path's CURVE COUNT and nothing else: each maximally non-flat quad subdivides to the depth
# cap whatever the output already holds. rekha filed it
# (docs/development/issues/archived/2026-09-15-flatten-keeps-subdividing-and-allocating-after-the-output-cap-is-full.md)
# because a font file can carry exactly that shape and rekha fills untrusted outlines every frame.
# MEASURED on this tree, 4,096 maximally non-flat quads (moveto then N x quadto(1e9, 1e9, 0, 0))
# through one sd_path_flatten: 1,048,577 points for 83,623,976 B in 3,133,451 allocations.
# ⇒ Past the budget, sadish chooses BOUNDED WORK AND A FLAGGED, DEGRADED CURVE over a faithful
# tessellation at any price: each remaining curve emits its ENDPOINT — its chord — and subdivides
# no further, and sd_flatten_degraded() says so for the whole operation.
#
# THE DEFAULT, FROM MEASUREMENT (all at the fill's own tolerance, SD_ONE >> 2):
#   a 256 px circle of 4 cubics                           65 points
#   a 8,192 px circle of 4 cubics (the depth cap)        257 points
#   95 ASCII-shaped glyph paths, all in one path       3,250 points
#   programs/grow_edges_test.cyr's cubic_ring(3000)    8,601 points  <- the largest in the suites
#   the hostile 4,096-quad path above                1,048,577 points
# 65,536 is 7.6x the largest legitimate path this stack draws, 20x a full ASCII label, and holds
# one flatten under ~2.1 MiB (65,536 SdPoints + the doubling ladder of the output array) — the same
# shape of answer as raster.cyr's 8 MiB SD_GROW_LIMIT_DEFAULT, in the unit this call allocates in.
# ⚠ A consumer that draws large curve-dense artwork of its own (not a glyph, not a UI) raises it,
# or sets 0 for 0.7.0's unbounded behaviour; a consumer that fills untrusted outlines keeps it.
#
# ⚠ WHAT COUNTS, AND WHAT DEGRADES. Every point EMITTED in the operation counts, straight verbs
# included — the budget bounds the result, not just the curve arithmetic. Only SUBDIVISION is
# refused: a moveto/lineto always emits, so a 100,000-point polyline still flattens whole (and a
# curve after it flattens to its chord).
# ================================================================
var SD_FLATTEN_BUDGET_DEFAULT = 65536;
var _sd_flat_budget = 65536;

# The one emit ctx sd_flat_emit may GROW — sd_path_flatten's, through sd_alloc, while it runs (0
# otherwise). Every other ctx is a fixed per-curve scratch buffer (raster.cyr) that must never be
# reallocated, least of all on the consumer's hook.
var _sd_flat_ctx = 0;
# 1 if the last sd_path_flatten lost a point — a growth or an SdPoint was refused — so its result
# is a PREFIX of the true flattening, not the whole of it.
var _sd_flat_trunc = 0;
# ⛔⛔ THE EMIT CTX THAT CAN TAKE NOTHING MORE (0 = none) — A POINTER, NOT A FLAG (0.7.1 repair).
# An emit that was dropped or whose SdPoint was refused records ITS OWN ctx here, and the recursion
# stops only for THAT ctx: fullness is a property of the OUTPUT ARRAY, not of the operation.
# ⚠ A plain flag leaked, and the leak was silent both ways. sd_flatten_op_begin clears this only at
# nesting depth 0, and sd_path_flatten opens a NESTED operation whenever a consumer has one open —
# which is the usage sd_flatten_op_begin's own header prescribes. So a starved flatten's flag
# survived into the NEXT, healthy flatten inside the same operation and truncated it to its
# straight-verb anchors, while sd_path_flatten's `_sd_flat_trunc = 0` wiped the only witness:
# MEASURED, two flattens of the same 513-point path inside one operation, the first starved —
# the second emitted 1 point with truncated() and degraded() both reading 0.
# ⇒ Two different ctxs never share a verdict now, and sd_path_flatten clears this outright when it
# establishes its own ctx (an arena a consumer reset between frames can hand out the same address
# twice, and a pointer alone cannot tell those two ctxs apart).
# ⛔ A POINTER IS STILL NOT ENOUGH ON ITS OWN, because raster.cyr and stroke.cyr REWIND one buffer
# per curve: the same ctx address is a different, empty output a moment later. _sd_flat_enter
# re-derives the verdict from the ctx's own (count, cap) at every entry — see it for the measured
# fills this blanked. Set it here, clear it there; nothing else writes it but sd_flatten_op_begin
# at depth 0 and sd_path_flatten's ctx setup.
var _sd_flat_full = 0;
var _sd_flat_used = 0;         # points emitted so far in the open operation
var _sd_flat_degraded = 0;     # 1 if a curve of the open operation was cut to its chord (budget)
var _sd_flat_nest = 0;         # open-operation nesting depth; 0 = none open
# ⛔ THE PER-CALL HALF OF _sd_flat_degraded (0.8.0), and the reason the polyline's DEGRADED bit
# cannot just read _sd_flat_degraded at the end of the walk. Degradation belongs to the OPERATION:
# inside a consumer's sd_flatten_op_begin scope, a budget spent by an EARLIER flatten leaves
# _sd_flat_degraded standing at 1, and a later, entirely whole flatten would then stamp its own
# result DEGRADED — a per-result verdict that is really a poll of a shared global, which is the
# defect the polyline verdict exists to fix. So the two subdivision recursions set BOTH: this one
# is cleared by sd_path_flatten at the top of every call and read once at the bottom, and nothing
# else in the process reads or writes it. ⚠ It is not public and it is not an operation verdict —
# sd_flatten_degraded() is unchanged and still answers for the operation.
# ⛔ THE CLEAR MUST RUN BEFORE THE WALK, NOT AFTER THE STORE, and that is not a stylistic choice.
# The two recursions that SET this are reached by the PUBLIC per-curve entries sd_flatten_quad /
# sd_flatten_cubic as well — the road sd_fill_impl and the stroker take — so a cut can be made by
# something that is not an sd_path_flatten at all, and a clear at the BOTTOM of the call would let
# it stand until the next flatten stamped it into a whole result. MEASURED: with the clear moved to
# just after the verdict store, all 29 suites stayed green while a budget-cut FILL followed by an
# untouched sd_path_flatten returned a record reading SD_POLYLINE_DEGRADED.
# ⇒ programs/flatten_bound_test.cyr group Q9 (checks 439-455) is what holds the position — Q1 and Q6
# do not, because in both the call that does the cutting is itself an sd_path_flatten.
var _sd_flat_cut = 0;          # 1 if a curve of THIS sd_path_flatten call was cut to its chord

# @public — set the per-operation flatten budget in POINTS (0 = unbounded, negative = refused and
# nothing changes); returns the PREVIOUS value, so a caller can scope it.
# SD_FLATTEN_BUDGET_DEFAULT restores the default.
fn sd_flatten_budget_set(n): i64 {
    var prev = _sd_flat_budget;
    if (n < 0) { return prev; }
    _sd_flat_budget = n;
    return prev;
}

# @public — the current per-operation flatten budget in points (0 = unbounded).
fn sd_flatten_budget_get(): i64 {
    return _sd_flat_budget;
}

# @public — 1 if the operation that just finished cut at least one curve to its chord because the
# budget ran out. Read it after sd_path_flatten, or after sd_flatten_op_end when a consumer scopes
# a whole draw.
# ⚠ IT BELONGS TO THE LAST OPERATION, NOT THE LAST CALL, and it is cleared when the next one opens
# at nesting depth 0. Every sd_path_flatten is an operation (an empty path included, 0.7.1); since
# 0.7.2 so is every FILL, as a whole (sd_fill_impl opens one, lazily, at the first curve it really
# flattens); and so is every single curve verb the STROKER flattens — stroke.cyr is the one caller
# left that goes one verb at a time, so a stroke's verdict is its LAST CURVE's unless the consumer
# scopes it. ⛔ A fill of a path with NO CURVE VERBS opens none at all, so this still reads whatever
# the last flatten left: MEASURED, a degraded flatten followed by a fill of a 3-lineto path still
# reports 1 (programs/flatten_bound_test.cyr group O). Read it inside a scope you opened
# (sd_flatten_op_begin / _end) if you want it to answer for a particular draw.
# ⭐ For one sd_path_flatten in particular, read sd_polyline_degraded(pl) instead (0.8.0): that bit
# is that CALL's, so two flattens sharing one budgeted scope report separately — the one whose
# curve was cut says 1 and the whole one says 0, where this global says 1 for both.
fn sd_flatten_degraded(): i64 {
    return _sd_flat_degraded;
}

# @public — 1 if points that a flatten wanted to emit were LOST (a growth was refused, or an
# SdPoint was): the result is a PREFIX of the true flattening, not the whole of it.
# ⚠ IT IS SET BY EVERY FLATTEN, INCLUDING THE PER-CURVE ONES INSIDE A FILL OR A STROKE. It is STICKY:
# sd_path_flatten clears it, and the fill and the stroke walks scope it per call (they save the
# caller's standing verdict and put it back), so after a draw it still reads "something was lost
# since the last sd_path_flatten".
# ⛔ IT IS NO LONGER THE ONLY WITNESS, and the header said it was through 0.7.1. Since 0.7.1
# sd_canvas_fill_path RETURNS SADISH_ERR_OOM for a fill whose own flatten lost points, and since
# 0.7.2 so do sd_canvas_stroke_path / _ex / _dash: MEASURED, a 20 px-radius circle of 4 cubics on
# 64x64 under a hook granting 5 allocations — SADISH_ERR_OOM, 81,029 of 312,280 coverage units,
# truncated() = 1 (0.7.0 did not get that far: SIGSEGV in sd_pt_mid).
# ⇒ Poll this when you want to know whether an EARLIER draw lost something; read the return code to
# know whether THIS one did. The canvas keeps whatever the partial draw painted — nothing is rolled
# back.
# ⭐ AND FOR A POLYLINE, ASK THE POLYLINE (0.8.0): sd_polyline_truncated(pl) is that result's own
# frozen verdict, so it stays right however many flattens, fills or strokes happen afterwards.
# This global is what is left for the case that has no result to ask — sd_path_flatten returning 0.
fn sd_flatten_truncated(): i64 {
    return _sd_flat_trunc;
}

# @public — open a flatten OPERATION: the scope the budget and the degraded flag are measured over.
# Returns the new nesting depth.
#
# ⭐ WHY A CONSUMER WOULD CALL THIS — AND WHAT 0.7.2 TOOK OFF ITS PLATE. sd_path_flatten opens one
# around its whole verb walk, and since 0.7.2 sd_canvas_fill_path does too (sd_fill_impl, lazily at
# its first flattened curve), so neither a lone flatten NOR a lone fill needs anything from you:
# MEASURED (programs/flatten_bound_test.cyr groups H and O), the hostile 4,096-quad path filled on
# 64x64 — unwrapped 1,044,480 B in 65,280 allocations on the seam, wrapped the SAME 1,044,480 B in
# 65,280, with sd_flatten_degraded() reading 1 either way. (0.7.1 unwrapped: 16,711,680 B in
# 1,044,480 — one budget per curve verb. 0.7.0: 50,135,040 B in 3,133,440 — no budget at all.)
# ⛔ THE STROKER IS STILL PER-CURVE, and that is what this is for now. stroke.cyr flattens ONE CURVE
# VERB AT A TIME into a fixed buffer, each call its own operation, so the budget bounds one curve
# there (at most 2^SD_FLATTEN_MAX_DEPTH = 256 points, which never reaches the default) and not the
# stroke. A consumer that wants ONE stroke of an untrusted path bounded wraps it:
#     sd_flatten_op_begin();  sd_canvas_stroke_path(cv, path, w);  sd_flatten_op_end();
#     if (sd_flatten_degraded() != 0) { ...the outline was cut to chords... }
# MEASURED (group P), a 4-cubic circle stroked at a budget of 64 points: TEN unwrapped strokes each
# paint 126,930 coverage units and none degrades — every curve gets its own 64, and spends 4 — while
# inside ONE operation the first four paint 126,930 and the FIFTH paints 114,300 with degraded() = 1,
# because 16 points a stroke spend it. Wrap to bound a stroke, or to make several draws share one
# budget.
# ⚠ Balance it. An op left open keeps accumulating, and a later flatten degrades for a budget it
# did not spend; sd_flatten_op_end is the only thing that closes one.
# ⚠ THE RESET IS AT DEPTH 0 ONLY — a nested begin joins the operation already open, which is the
# whole point of the scope. That is why sd_path_flatten clears the OUTPUT's fullness verdict itself
# when it establishes its ctx (see _sd_flat_full) instead of relying on this: inside a consumer's
# scope, a flatten's begin is a nested one and resets nothing.
fn sd_flatten_op_begin(): i64 {
    if (_sd_flat_nest == 0) {
        _sd_flat_used = 0;
        _sd_flat_degraded = 0;
        _sd_flat_full = 0;
    }
    _sd_flat_nest = _sd_flat_nest + 1;
    return _sd_flat_nest;
}

# @public — close a flatten operation opened by sd_flatten_op_begin. Returns the new nesting depth;
# closing when none is open is a no-op returning 0.
fn sd_flatten_op_end(): i64 {
    if (_sd_flat_nest > 0) { _sd_flat_nest = _sd_flat_nest - 1; }
    return _sd_flat_nest;
}

# Double the point array of emit ctx `ctx` through sd_alloc, copying its points. Returns 1, or 0 if
# `ctx` is not growable or the allocation failed (_sd_flat_trunc set; later emits stop trying).
fn _sd_flat_widen(ctx): i64 {
    if (ctx != _sd_flat_ctx) { return 0; }
    if (_sd_flat_trunc != 0) { return 0; }
    var nc = load64(ctx + 16) * 2;
    var blk = sd_alloc(nc * SD_POLYLINE_PT_SIZE);
    if (blk == 0) {
        _sd_flat_trunc = 1;
        return 0;
    }
    memcpy(blk, load64(ctx + 0), load64(ctx + 8) * SD_POLYLINE_PT_SIZE);
    store64(ctx + 0, blk);
    store64(ctx + 16, nc);
    return 1;
}

# Emit accumulator ctx: +0 points(ptr)  +8 count  +16 cap. A full ctx grows if it is
# sd_path_flatten's; otherwise the point is dropped — and a DROP RECORDS THIS ctx IN _sd_flat_full,
# which is the whole of how the recursion learns there is no point subdividing any further (0.7.1:
# through 0.7.0 this returned 0 either way and nothing upstream looked). Returns 0.
# ⛔ TAKES COORDINATES SINCE 0.10.0 — it took one SdPoint POINTER. A caller that still passes a
# pointer stores an address where an x belongs and leaves y as whatever the slot held.
fn sd_flat_emit(ctx, x, y): i64 {
    var count = load64(ctx + 8);
    if (count >= load64(ctx + 16)) {
        if (_sd_flat_widen(ctx) == 0) {
            _sd_flat_full = ctx;
            return 0;
        }
    }
    var pts = load64(ctx + 0);
    store64(pts + count * SD_POLYLINE_PT_SIZE + SD_POINT_X_OFFSET, x);
    store64(pts + count * SD_POLYLINE_PT_SIZE + SD_POINT_Y_OFFSET, y);
    store64(ctx + 8, count + 1);
    _sd_flat_used = _sd_flat_used + 1;
    return 0;
}

# Emit the point (x, y). Returns 0.
# ⭐⭐ THIS IS THE 0.10.0 CHANGE. It took a fourth argument — the endpoint's EXISTING SdPoint, or 0
# meaning "materialise one" — and its body was an sd_point_new plus a refusal path, because the
# output held POINTERS and an emitted point therefore had to be a record. The output holds the
# coordinates now, so there is nothing to materialise and nothing here can be refused: a point
# costs no allocation at all, and the only refusal left in the emit path is a GROWTH
# (_sd_flat_widen), which already records itself. That deletes one 16 B sd_alloc PER EMITTED POINT.
fn _sd_flat_put(ctx, x, y): i64 {
    return sd_flat_emit(ctx, x, y);
}

# ⛔⛔ THE OTHER HALF OF THE FULLNESS VERDICT: RE-CHECK IT WHEN A FOREIGN CTX COMES BACK (0.7.1).
# _sd_flat_put / sd_flat_emit record the ctx that could take nothing more; this is what un-records
# it, and it exists because a per-curve buffer is REWOUND between curves.
#
# raster.cyr's fill and stroke.cyr's stroker own ONE process-lifetime flatten buffer each and reset
# its (points, count, cap) fields before every single curve verb — so the buffer that was full a
# moment ago is empty again, and a verdict left standing against it silently empties every curve
# after it. MEASURED before this check, a 16x16 fill of a 5 px circle of 4 cubics (true ink 18,016
# coverage units) with a starved fill and a HEALTHY one inside one sd_flatten_op_begin/_end:
#   grant=0  starved 0      then 0        grant=2  starved 9,008   then 0
#   grant=1  starved 1,314  then 0        grant=3  starved 16,697  then 0
# The second fill ran with the allocator fully restored, returned SADISH_OK, and painted a BLANK
# canvas — for the whole life of the consumer's operation, since only a depth-0 begin cleared the
# flag. (Outside an operation the leak is invisible: the depth-0 begin is then the draw's own —
# sd_flatten_quad's for a stroke, and since 0.7.2 sd_fill_impl's for a fill — and it clears the
# flag. That is exactly why it took an operation to find.)
# ⇒ Fullness is re-derived from the ctx itself: the verdict survives only while the ctx REALLY has
# no room (count >= cap, the growth-refused case), which is what group F's cross-curve stop rests
# on. ⚠ SINCE 0.10.0 THAT IS THE ONLY CASE THERE IS — a point allocates nothing, so "the allocator
# said no but the array had room" cannot arise from an emit any more. The re-derivation is kept
# because it is what makes a REWOUND buffer a new output (raster.cyr and stroke.cyr rewind one per
# curve verb), which is the half of this repair that still does work every frame.
# A verdict set by a refused SdPoint (count < cap — the allocator said no, the array did not)
# is re-tried once per curve: one descent to the first leaf and one refused allocation, then the
# recursion stops again. Bounded, and it cannot outlive the starvation that caused it.
# ⚠ sd_path_flatten's OWN ctx is exempt — it accumulates across the whole verb walk, so its
# fullness must persist between curves. It is cleared once, where that ctx is established.
fn _sd_flat_enter(ctx): i64 {
    if (_sd_flat_full != ctx) { return 0; }
    if (ctx == _sd_flat_ctx) { return 0; }
    if (load64(ctx + 8) < load64(ctx + 16)) { _sd_flat_full = 0; }
    return 0;
}

# Midpoint of two SdPoints (signed /2 via sd_asr — coords can be negative), as a NEW SdPoint; 0 if
# that allocation is refused.
# ⚠ NOTHING IN SADISH CALLS THIS SINCE 0.7.1 — the flatten recursion computes its mids as i64
# locals (see _sd_flat_quad_r). It is kept because it is in the published bundle a consumer may
# call, and because it is still the definition of what a mid-point IS.
fn sd_pt_mid(a, b): i64 {
    var mx = sd_asr(sd_point_x(a) + sd_point_x(b), 1);
    var my = sd_asr(sd_point_y(a) + sd_point_y(b), 1);
    return sd_point_new(mx, my);
}

# Quadratic flatness on raw 16.16 coordinates — THE definition; sd_quad_flat is its SdPoint form
# and the recursion below calls this one, so the two can never drift apart.
# A quad's max deviation from its chord is 0.25*|p0 - 2*p1 + p2|, so it is flat when |secondDiff|
# <= 4*tol. The Manhattan magnitude (>= Euclidean) keeps this division/sqrt-free and only ever
# over-tessellates, never under.
fn _sd_quad_flat_xy(x0, y0, x1, y1, x2, y2, tol): i64 {
    var dx = x0 - 2 * x1 + x2;
    var dy = y0 - 2 * y1 + y2;
    if (sd_abs(dx) + sd_abs(dy) <= 4 * tol) { return 1; }
    return 0;
}

# @public — is the quad (p0,p1,p2) within `tol` of its chord? 1 / 0.
fn sd_quad_flat(p0, p1, p2, tol): i64 {
    return _sd_quad_flat_xy(sd_point_x(p0), sd_point_y(p0), sd_point_x(p1), sd_point_y(p1),
      sd_point_x(p2), sd_point_y(p2), tol);
}

# ⭐⭐ THE RECURSION CARRIES COORDINATES, NOT SdPoints (0.7.1) — the whole of the mid-point fix.
#
# Through 0.7.0 each node called sd_pt_mid three times (quad) or six (cubic), and sd_pt_mid IS an
# sd_point_new: a 16 B sd_alloc on the consumer's seam. But of a node's mids only ONE is ever
# emitted — the centre point, which travels down as a child's endpoint until a leaf emits it — and
# the others are pure control points, dead the moment their child has read them. So a fully
# subdivided quad paid ~765 allocations to emit 256 points, and a cubic ~1,530.
# ⇒ A node now computes its mids as PLAIN i64 LOCALS and hands them down as numbers. Only
# _sd_flat_put allocates, and only for a point that is actually going into the output.
#   · MEASURED (programs/flatten_bound_test.cyr counts both recursions in one process): a maximally
#     non-flat quad falls from 765 allocations (12,240 B) to 255 (4,080 B); a depth-8 cubic emitting
#     232 points from 1,386 to 231. Allocation is now exactly (points emitted - 1) per curve.
#   · The last argument of each recursion is the endpoint's EXISTING SdPoint, or 0 for "a midpoint
#     nobody has materialised yet". That is what keeps the caller's own SdPoint pointers in the
#     output for a curve's final endpoint, byte-for-byte as 0.7.0 left them.
#   · p0 needs no pointer: a node NEVER emits its own start point — the previous segment did.
#   · The arithmetic is unchanged to the raw unit (sd_asr(a + b, 1), the same second-difference
#     test), so every path under budget flattens to the same points in the same order as 0.7.0.
#     programs/flatten_bound_test.cyr holds it to a reference built from the 0.7.0 code.
#
# Emits every point AFTER (x0,y0) up to and including (x2,y2). Returns 0.
fn _sd_flat_quad_r(ctx, x0, y0, x1, y1, x2, y2, tol, depth): i64 {
    # Nothing more can reach THIS output: stop, rather than subdivide into drops (the filing's
    # "one comparison per remaining curve"). ⚠ It is `== ctx`, not `!= 0`: another ctx's fullness
    # says nothing about this one — see _sd_flat_full.
    if (_sd_flat_full == ctx) { return 0; }
    if (depth <= 0) { return _sd_flat_put(ctx, x2, y2); }
    if (_sd_quad_flat_xy(x0, y0, x1, y1, x2, y2, tol) != 0) { return _sd_flat_put(ctx, x2, y2); }
    # Over budget: this curve becomes its chord — the endpoint, no subdivision, no temporaries.
    # ⚠ TWO FLAGS, TWO SCOPES (0.8.0): _sd_flat_degraded is the OPERATION's and is cleared by a
    # depth-0 sd_flatten_op_begin; _sd_flat_cut is the CALL's and is cleared by sd_path_flatten,
    # which stamps it into the polyline it returns. Setting only one of them is a real bug in
    # either direction — see _sd_flat_cut.
    if (_sd_flat_budget > 0) {
        if (_sd_flat_used >= _sd_flat_budget) {
            _sd_flat_degraded = 1;
            _sd_flat_cut = 1;
            return _sd_flat_put(ctx, x2, y2);
        }
    }
    var x01 = sd_asr(x0 + x1, 1);
    var y01 = sd_asr(y0 + y1, 1);
    var x12 = sd_asr(x1 + x2, 1);
    var y12 = sd_asr(y1 + y2, 1);
    var x012 = sd_asr(x01 + x12, 1);
    var y012 = sd_asr(y01 + y12, 1);
    _sd_flat_quad_r(ctx, x0, y0, x01, y01, x012, y012, tol, depth - 1);
    _sd_flat_quad_r(ctx, x012, y012, x12, y12, x2, y2, tol, depth - 1);
    return 0;
}

# Recursively flatten a quad (p0,p1,p2). Emits every point AFTER p0 up to and
# including p2 — p0 is already in the output from the previous segment.
# ⛔⛔ THE OPERATION OPENED HERE IS LOAD-BEARING FOR THE STROKER, AND FOR NOTHING ELSE NOW (0.7.2).
# stroke.cyr calls this one curve verb at a time into a fixed buffer, and nothing else resets
# _sd_flat_used for an UNWRAPPED stroke — so a fresh budget and a fresh full/degraded flag per curve
# is what this begin/end pair is. Delete it and _sd_flat_used accumulates for the life of the
# PROCESS: MEASURED (programs/flatten_bound_test.cyr group P), ten identical unwrapped strokes of a
# 4-cubic circle at a budget of 64 paint 126,930 coverage units each with it, and 126,930 four times
# then 114,300 with degraded() = 1 for ever after without it — the same input, a different picture.
# Since 0.7.2 sd_path_flatten's walk and sd_fill_impl's fill BOTH open an operation of their own
# first, so these begins nest inside theirs and reset nothing there.
# ⭐ THE COORDINATE ENTRY (0.9.0) — what a PATH walk calls, now that a path's points are numbers
# and not records. ⛔ IT LOST ITS `pt2` / `pt3` ARGUMENT AT 0.10.0, and the reason is the release:
# that argument carried "the endpoint's EXISTING SdPoint, or 0 to materialise one", which only had
# to exist while the output held POINTERS. Both stores are coordinates now, so there is no record
# to pass down, nothing to reuse, and nothing to materialise — sd_flatten_quad below simply reads
# its SdPoint arguments' two words like any other caller.
# ⚠ A CONSUMER CALLING sd_flatten_quad / sd_flatten_cubic SEES NO SIGNATURE CHANGE: the public
# SdPoint-form entries take the same arguments they always did. What changed is what lands in the
# ctx — coordinates, not the caller's own records — so a consumer that compared output POINTERS
# against the SdPoints it passed in is comparing things that no longer exist.
fn _sd_flatten_quad_xy(ctx, x0, y0, x1, y1, x2, y2, tol, depth): i64 {
    _sd_flat_enter(ctx);
    sd_flatten_op_begin();
    _sd_flat_quad_r(ctx, x0, y0, x1, y1, x2, y2, tol, depth);
    sd_flatten_op_end();
    return 0;
}

fn sd_flatten_quad(ctx, p0, p1, p2, tol, depth): i64 {
    return _sd_flatten_quad_xy(ctx, sd_point_x(p0), sd_point_y(p0), sd_point_x(p1), sd_point_y(p1),
      sd_point_x(p2), sd_point_y(p2), tol, depth);
}

# Cubic flatness on raw 16.16 coordinates — THE definition (sd_cubic_flat is its SdPoint form):
# both second differences (p0-2p1+p2) and (p1-2p2+p3) within tolerance, same Manhattan bound as
# the quad.
fn _sd_cubic_flat_xy(x0, y0, x1, y1, x2, y2, x3, y3, tol): i64 {
    var d1x = x0 - 2 * x1 + x2;
    var d1y = y0 - 2 * y1 + y2;
    var d2x = x1 - 2 * x2 + x3;
    var d2y = y1 - 2 * y2 + y3;
    var m1 = sd_abs(d1x) + sd_abs(d1y);
    var m2 = sd_abs(d2x) + sd_abs(d2y);
    var m = m1;
    if (m2 > m) { m = m2; }
    if (m <= 4 * tol) { return 1; }
    return 0;
}

# @public — is the cubic (p0,p1,p2,p3) within `tol` of its chord? 1 / 0.
fn sd_cubic_flat(p0, p1, p2, p3, tol): i64 {
    return _sd_cubic_flat_xy(sd_point_x(p0), sd_point_y(p0), sd_point_x(p1), sd_point_y(p1),
      sd_point_x(p2), sd_point_y(p2), sd_point_x(p3), sd_point_y(p3), tol);
}

# The cubic's coordinate recursion — see _sd_flat_quad_r for why it carries numbers. Of a node's
# six mids only p0123 is ever emitted; p01, p12, p23, p012 and p123 are control points its two
# children read and drop. Emits every point after (x0,y0). Returns 0.
fn _sd_flat_cubic_r(ctx, x0, y0, x1, y1, x2, y2, x3, y3, tol, depth): i64 {
    if (_sd_flat_full == ctx) { return 0; }
    if (depth <= 0) { return _sd_flat_put(ctx, x3, y3); }
    if (_sd_cubic_flat_xy(x0, y0, x1, y1, x2, y2, x3, y3, tol) != 0) {
        return _sd_flat_put(ctx, x3, y3);
    }
    # The cubic's own copy of the quad's two-flag rule — see _sd_flat_quad_r.
    if (_sd_flat_budget > 0) {
        if (_sd_flat_used >= _sd_flat_budget) {
            _sd_flat_degraded = 1;
            _sd_flat_cut = 1;
            return _sd_flat_put(ctx, x3, y3);
        }
    }
    var x01 = sd_asr(x0 + x1, 1);
    var y01 = sd_asr(y0 + y1, 1);
    var x12 = sd_asr(x1 + x2, 1);
    var y12 = sd_asr(y1 + y2, 1);
    var x23 = sd_asr(x2 + x3, 1);
    var y23 = sd_asr(y2 + y3, 1);
    var x012 = sd_asr(x01 + x12, 1);
    var y012 = sd_asr(y01 + y12, 1);
    var x123 = sd_asr(x12 + x23, 1);
    var y123 = sd_asr(y12 + y23, 1);
    var x0123 = sd_asr(x012 + x123, 1);
    var y0123 = sd_asr(y012 + y123, 1);
    _sd_flat_cubic_r(ctx, x0, y0, x01, y01, x012, y012, x0123, y0123, tol, depth - 1);
    _sd_flat_cubic_r(ctx, x0123, y0123, x123, y123, x23, y23, x3, y3, tol, depth - 1);
    return 0;
}

# Recursively flatten a cubic (p0,p1,p2,p3). Emits every point after p0.
# Opens a flatten operation, exactly as sd_flatten_quad does — and for the same reason: the stroker
# is the caller that depends on it. Group P drives BOTH, because a stroke of an all-cubic path walks
# straight past a per-curve operation that survives in the quad branch alone.
# The cubic's coordinate entry — see _sd_flatten_quad_xy.
fn _sd_flatten_cubic_xy(ctx, x0, y0, x1, y1, x2, y2, x3, y3, tol, depth): i64 {
    _sd_flat_enter(ctx);
    sd_flatten_op_begin();
    _sd_flat_cubic_r(ctx, x0, y0, x1, y1, x2, y2, x3, y3, tol, depth);
    sd_flatten_op_end();
    return 0;
}

fn sd_flatten_cubic(ctx, p0, p1, p2, p3, tol, depth): i64 {
    return _sd_flatten_cubic_xy(ctx, sd_point_x(p0), sd_point_y(p0), sd_point_x(p1), sd_point_y(p1),
      sd_point_x(p2), sd_point_y(p2), sd_point_x(p3), sd_point_y(p3), tol, depth);
}

# @public — flatten `path` into a straight-line polyline within `tol` (a
# 16.16 flatness tolerance), returning an SdPolyline. Straight verbs pass
# through as anchors; quad/cubic verbs are adaptively subdivided (de
# Casteljau) until each segment's deviation from its chord is <= tol.
# Returns 0 on an empty path (the caller reports EMPTY_PATH) AND on a refused allocation — the
# out array, the ctx or the polyline header — with sd_flatten_truncated() set to tell the two
# apart (0.7.1; through 0.7.0 a refusal here stored through 0). ⭐ The verdict is cleared BEFORE the
# empty-path return, so "0 and truncated() == 0" really does mean empty; an early return that
# skipped the clear would have left the previous call's 1 standing.
# ⚠ THE TWO ZEROS ARE STILL TOLD APART BY THE GLOBAL, NOT BY THE RESULT (0.8.0 did not change
# this, and it cannot): the polyline verdict lives IN the record, so a call that returns no record
# has nowhere to put one. `if (pl == 0) { ... sd_flatten_truncated() ... }` is unchanged, and it
# is the only case left where a caller must reach for a process-wide flag.
#
# ⭐⭐ A TRUNCATED FLATTEN IS FLAGGED, NOT REFUSED (0.8.0) — the decision the filing's second
# Suggested-fix bullet leaves to the implementation ("refused OR clearly degraded"). sadish
# returns the PREFIX with SD_POLYLINE_TRUNCATED set rather than 0, because:
#   · returning 0 would throw away a result callers do use — group F's starved flatten keeps the
#     8,192 points that fit, and they are byte-identical to the whole flattening's first 8,192;
#   · 0 is already spoken for TWICE (empty path, refused allocation), and a third meaning on the
#     same sentinel would make the very confusion this release is repairing worse, not better;
#   · "refused" belongs at the DRAW, where a partial contour actually gets filled open, and that
#     is where it already is: sd_canvas_fill_path (0.7.1) and sd_canvas_stroke_path / _ex / _dash
#     (0.7.2) return SADISH_ERR_OOM rather than paint a half outline and claim success.
# ⇒ The flag keeps both halves — the points and the truth about them — and costs the caller one
# `if (sd_polyline_truncated(pl) != 0)`. ⛔ A polyline is NOT self-validating: nothing in sadish
# refuses to rasterize a truncated one, because the same prefix is exactly what a caller
# recovering from an out-of-memory frame wants to draw. Test it if the shape has to be right.
#
# ⭐ THE RESULT'S OWN VERDICT (0.8.0), captured the moment the verb walk ends:
#   sd_polyline_truncated(pl)  1 if points were LOST (a growth or an SdPoint was refused)
#   sd_polyline_degraded(pl)   1 if a curve of THIS call was cut to its chord by the budget
# Both are frozen into the 24 B record and never move again — a later flatten, a later fill, a
# later stroke all leave them alone, which is the whole difference from the two globals. ⚠ The
# DEGRADED bit is this CALL's, where sd_flatten_degraded() is the OPERATION's: inside a consumer's
# scope an earlier flatten's spent budget keeps the global at 1 while a whole result correctly
# reports 0. TRUNCATED matches sd_flatten_truncated() exactly at the moment of return, since that
# global is cleared by this call and set only by this call's own emits.
# ⭐ Every point is returned (0.7.0; through 0.6.0 the result stopped at SD_FLATTEN_CAP = 8,192).
# The point array starts at SD_FLATTEN_PCAP * 16 B and doubles through sd_alloc — it is the caller's
# result, on the seam like the polyline — abandoning each smaller block to the allocator: MEASURED
# 983,040 B of arrays for 20,001 points (65,536 + 131,072 + 262,144 + 524,288), 65,536 B at or under
# 4,096. ⚠ If a doubling fails the result keeps the points that fit, as 0.6.0 did, and
# _sd_flat_trunc is set — and since 0.10.0 a REFUSED DOUBLING IS THE ONLY WAY THAT HAPPENS.
# ⭐⭐ AN EMITTED POINT COSTS NOTHING (0.10.0), AND THIS PARAGRAPH USED TO SAY THE OPPOSITE. Through
# 0.9.1 every point the walk emitted was a fresh 16 B SdPoint, because the output held pointers —
# and 0.9.0 had just made that worse, since a path's points went inline and its anchors could no
# longer be handed through. The output holds coordinates now, so a point is two stores.
# MEASURED on the seam, a 21-point line path at the fill's tolerance: 3 allocations on 0.8.0, 24 on
# 0.9.0, and **3 again here** — the arrays, the ctx and the header, and nothing per point ever
# again. ⇒ The advice this paragraph used to give — "flatten every frame and you pay the anchors
# back per frame, so fill the path directly instead" — no longer applies: holding a polyline and
# re-flattening now cost the same in calls, and the choice is about lifetime, not allocation.
# ⭐ ONE OPERATION for the whole walk (0.7.1): SD_FLATTEN_BUDGET_DEFAULT points of subdivision are
# shared across every curve of the path, and sd_flatten_degraded() reports afterwards whether any
# of them was cut to its chord. MEASURED, 4,096 maximally non-flat quads: 83,623,976 B in
# 3,133,451 allocations on 0.7.0, 3,076,136 B in 65,287 here (27x the bytes, 48x the calls).
fn sd_path_flatten(path, tol): i64 {
    # ⛔ THE VERDICTS ARE CLEARED BEFORE THE EMPTY-PATH RETURN, AND THE OPERATION OPENS BEFORE IT
    # (0.7.1 repair). Through the first 0.7.1 draft both sat after it, so an empty path returned 0
    # carrying the PREVIOUS call's verdicts — and the header's own way of telling "empty" from
    # "refused" (truncated() set) did not work: MEASURED, a starved flatten followed by a flatten of
    # an empty path returned 0 twice with truncated() reading 1 both times.
    _sd_flat_trunc = 0;
    # The call-scoped half of the degraded verdict (0.8.0). Cleared here and nowhere else, so what
    # it reads at the bottom of this function is exactly "a curve of THIS call was cut".
    # ⛔ HERE, not after the store: a FILL or a STROKE reaches the same two recursions through
    # sd_flatten_quad / sd_flatten_cubic, so a cut left standing by one of THOSE would be stamped
    # into the next polyline. See _sd_flat_cut; group Q9 is the gate.
    _sd_flat_cut = 0;
    sd_flatten_op_begin();
    var n_verbs = load64(path + SD_PATH_NVERBS_OFFSET);
    if (n_verbs == 0) {
        sd_flatten_op_end();
        return 0;
    }

    var verbs = load64(path + SD_PATH_VERBS_OFFSET);
    var points = load64(path + SD_PATH_POINTS_OFFSET);

    var out = sd_alloc(SD_FLATTEN_PCAP * SD_POLYLINE_PT_SIZE);
    if (out == 0) {
        _sd_flat_trunc = 1;
        sd_flatten_op_end();
        return 0;
    }
    var ctx = sd_alloc(24);
    if (ctx == 0) {
        _sd_flat_trunc = 1;
        sd_flatten_op_end();
        return 0;
    }
    store64(ctx + 0, out);
    store64(ctx + 8, 0);
    store64(ctx + 16, SD_FLATTEN_PCAP);
    _sd_flat_ctx = ctx;
    # A NEW output can take points whatever any other one could not — and an arena the consumer
    # reset can hand this call the address a starved ctx had (see _sd_flat_full).
    _sd_flat_full = 0;

    # A non-positive tol would never satisfy the flatness test — recurse to
    # the depth cap every time; clamp to >= 1 (1/65536 px).
    var t = tol;
    if (t < 1) { t = 1; }

    # ⛔ `has_cur`, NOT `cur != 0` (0.9.0). Through 0.8.0 the current point was an SdPoint POINTER
    # and 0 meant "no moveto yet" for free. A point is two COORDINATES now, and (0, 0) is a real
    # point — the origin — so the sentinel has to be its own flag or a path that starts at the
    # origin draws nothing. Every walk in the tree (this one, raster.cyr's fill, both of
    # stroke.cyr's) carries the same flag for the same reason.
    var curx = 0;
    var cury = 0;
    var has_cur = 0;
    var vi = 0;
    var pi = 0;
    while (vi < n_verbs) {
        var verb = load64(verbs + vi * 8);
        if (verb == SD_VERB_MOVETO) {
            curx = load64(points + pi * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET);
            cury = load64(points + pi * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET);
            has_cur = 1;
            _sd_flat_put(ctx, curx, cury);
            pi = pi + 1;
        }
        if (verb == SD_VERB_LINETO) {
            if (has_cur != 0) {         # a drawing verb before any moveto is skipped (raster.cyr)
                curx = load64(points + pi * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET);
                cury = load64(points + pi * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET);
                _sd_flat_put(ctx, curx, cury);
            }
            pi = pi + 1;
        }
        if (verb == SD_VERB_QUADTO) {
            var qcx = load64(points + pi * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET);
            var qcy = load64(points + pi * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET);
            var qex = load64(points + (pi + 1) * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET);
            var qey = load64(points + (pi + 1) * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET);
            if (has_cur != 0) {             # a curve before any moveto is skipped (see raster.cyr)
                _sd_flatten_quad_xy(ctx, curx, cury, qcx, qcy, qex, qey, t,
                  SD_FLATTEN_MAX_DEPTH);
                curx = qex;
                cury = qey;
            }
            pi = pi + 2;
        }
        if (verb == SD_VERB_CUBICTO) {
            var k1x = load64(points + pi * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET);
            var k1y = load64(points + pi * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET);
            var k2x = load64(points + (pi + 1) * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET);
            var k2y = load64(points + (pi + 1) * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET);
            var kex = load64(points + (pi + 2) * SD_PATH_PT_SIZE + SD_POINT_X_OFFSET);
            var key = load64(points + (pi + 2) * SD_PATH_PT_SIZE + SD_POINT_Y_OFFSET);
            if (has_cur != 0) {             # a curve before any moveto is skipped (see raster.cyr)
                _sd_flatten_cubic_xy(ctx, curx, cury, k1x, k1y, k2x, k2y, kex, key, t,
                  SD_FLATTEN_MAX_DEPTH);
                curx = kex;
                cury = key;
            }
            pi = pi + 3;
        }
        # SD_VERB_CLOSE consumes no point; the rasterizer closes the subpath
        # back to its moveto anchor.
        vi = vi + 1;
    }

    # ⛔ THE VERDICT IS TAKEN HERE, BEFORE THE HEADER IS ALLOCATED — the walk is over, and the only
    # thing left that can move either flag is this function's own refused sd_alloc, which sets
    # _sd_flat_trunc on a call that returns no record to carry it (0.8.0).
    var verdict = 0;
    if (_sd_flat_trunc != 0) { verdict = verdict + SD_POLYLINE_TRUNCATED; }
    if (_sd_flat_cut != 0)   { verdict = verdict + SD_POLYLINE_DEGRADED; }

    sd_flatten_op_end();
    _sd_flat_ctx = 0;
    var count = load64(ctx + 8);
    var pl = sd_alloc(SD_POLYLINE_SIZE);
    if (pl == 0) {
        _sd_flat_trunc = 1;
        return 0;
    }
    store64(pl + SD_POLYLINE_POINTS_OFFSET, load64(ctx + 0));   # the CURRENT block, grown or not
    store64(pl + SD_POLYLINE_COUNT_OFFSET, count);
    store64(pl + SD_POLYLINE_VERDICT_OFFSET, verdict);
    return pl;
}
