[package]
name = "sadish"
version = "${file:VERSION}"
description = "sadish (सदिश — vector) — pure-Cyrius low-level 2D vector graphics core for AGNOS: path construction (line/quadratic+cubic Bézier), curve flattening, scanline fill (even-odd + nonzero winding) with anti-aliased coverage, affine transforms, clipping → a pixel/coverage buffer. The rasterizer foundation rekha/canvas/SVG/UI-toolkit consume."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/sadish"
language = "cyrius"
cyrius = "6.6.6"

# sadish is a library — no CLI binary. `cyrius build` targets a smoke
# program that links the full include chain to prove lib.cyr parses clean.
# Consumers (rekha for font outlines, a canvas/drawing API, SVG, and the
# dhancha UI toolkit) pull `dist/sadish.cyr` via a `[deps.sadish]` entry
# pointing at a git tag.
#
# Dependency direction: sadish is a LEAF — no upstream sadish deps (only
# the Cyrius stdlib below). Downstream consumers: rekha, dhancha (and a
# canvas/compositing/SVG layer). None of them are re-implementations; they
# build ON this rasterizer core.
[build]
entry = "programs/smoke.cyr"
output = "build/sadish-smoke"

# `[lib]` feeds `cyrius distlib` — module order matters: stdlib first
# (declared in src/lib.cyr), then domain modules in dependency order.
# error.cyr is dep-free; surface.cyr (SdSurface BGRA pixel buffer) + draw.cyr
# (direct opaque primitives) build on error only; geom.cyr uses error;
# path.cyr builds on geom; coverage.cyr (the opt-in SD_AA_AREA engine) builds on
# geom + error; raster.cyr consumes path and dispatches into coverage; stroke.cyr
# fills through raster (fill_union, the fill + stroker scratch); dash.cyr cuts
# stroke.cyr's flattened run into dashes and hands each piece back to it; paint.cyr
# (gradient paint) composites through raster's SdCanvas; premul.cyr (premultiplied
# writers for #92 surfaces, the gradient blit included) builds on surface + raster +
# error AND on paint.cyr, whose _sd_paint_blit_run it wraps — while paint.cyr's blit
# loops in turn call premul.cyr's _sd_premul_paint_px. ⚠ Since 0.7.0 the two REFERENCE
# EACH OTHER; Cyrius resolves forward references, so this order compiles, but neither
# can be dropped from the bundle without the other. Don't reorder without
# re-running `cyrius distlib` and verifying the concatenated bundle compiles.
# alloc.cyr is FIRST: the allocation seam (sd_alloc) every other module draws from.
[lib]
modules = [
    "src/alloc.cyr",
    "src/error.cyr",
    "src/surface.cyr",
    "src/draw.cyr",
    "src/present.cyr",
    "src/geom.cyr",
    "src/path.cyr",
    "src/coverage.cyr",
    "src/raster.cyr",
    "src/stroke.cyr",
    "src/dash.cyr",
    "src/paint.cyr",
    "src/premul.cyr",
]

[deps]
# Base stdlib set — the vector-graphics core is pure integer Cyrius
# (16.16 fixed-point), no external crate deps (sadish is a leaf). `bench`
# is carried now so the v0.2 rasterizer bites have a benchmarking harness
# ready when scanline coverage lands.
stdlib = [
    "string",
    "fmt",
    "alloc",
    "io",
    "vec",
    "str",
    "syscalls",
    "assert",
    "bench",
]
