# sadish.cyr -- bundled distribution
# Version: 0.6.0
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- alloc.cyr ---

# @public — sadish allocation seam: the ONE place every other module draws memory from.
#
# alloc.cyr — `sd_alloc(n)` is what surface.cyr, geom.cyr, path.cyr, raster.cyr, present.cyr
# and error.cyr call instead of the stdlib `alloc(n)`. By default it IS `alloc(n)`; a consumer
# may install a hook with `sd_alloc_set(fp)` and every byte sadish asks for while the hook is
# set comes from the hook instead.
#
# ⭐ WHY A SEAM EXISTS AT ALL. `lib/alloc.cyr` is a bump allocator with NO `free()`. Before 0.5.5
# every fill cost the global heap a fixed 327,824 B and every stroke of a closed 4-vertex rect
# 2,789,016 B (MEASURED, 8x8 canvas, one call each) — permanently, per call. A per-frame consumer
# (dhancha's frame arena, and crab on top of it, whose headline gate asserts a rendered frame
# costs the heap EXACTLY 0 bytes) had no way to draw scalable text through sadish without
# leaking a canvas plus a path per glyph per frame — the defect dhancha filed as
# `2026-09-13-scalable-text-allocates-per-call-outside-the-frame-arena.md`. Routing sadish's
# allocations onto the consumer's arena is the ONLY way a frame can cost the heap nothing,
# and the consumer is the only party that knows the frame boundary. Hence: a hook.
#
# THE CONTRACT.
#   · The hook applies to EVERYTHING sadish allocates while it is set — surfaces, canvases,
#     coverage buffers, clip masks, paths, verb/point arrays, points, matrices, error records,
#     flatten mid-points, the PPM/presenter buffers. sadish does not distinguish "the result"
#     from "the working set"; a consumer scopes the hook around the work whose lifetime it is
#     choosing: `var prev = sd_alloc_set(&mine); ...draw...; sd_alloc_set(prev);`.
#   ⛔ A pointer that outlives the hook's backing store is dangling. If the hook is an arena
#     that gets reset every frame, NOTHING sadish returned under it may be kept across the reset
#     — not a path, not a canvas, not a surface. That is the consumer's lifetime call, exactly as
#     it already is for `dh_falloc`.
#   · A hook returning 0 is handled precisely as `alloc()` returning 0 already is: the callers
#     that check (sd_surface_new, sd_canvas_new, sd_path_new, sd_path_grow) return 0 /
#     SADISH_ERR_OOM; the callers that do not check never did. No new failure path.
#   · `sd_alloc_set` returns the PREVIOUS hook so a nested scope unwinds in order; 0 restores the
#     global allocator. `sd_alloc_get` reads it back.
#   ⚠ The fill/stroke fixed-capacity scratch in raster.cyr is deliberately NOT on this seam — it
#     is allocated once for the life of the process from the global `alloc` (see
#     `_sd_scratch_init`; the SD_AA_AREA accumulator in coverage.cyr likewise). A hook pointing
#     at an arena that gets reset would otherwise leave the scratch dangling on the second frame.
#   ⚠ The hook is a process-wide global, like the scratch: sadish has never had a lock anywhere
#     and is not thread-safe. Set it from the thread that draws.

# The installed hook: fn(n): ptr (0 on failure), or 0 = the global allocator.
var _sd_alloc_fn = 0;

# @public — allocate n bytes for sadish through the consumer's hook, or the global allocator when
# none is set. Returns 0 on failure, as `alloc` does.
fn sd_alloc(n): i64 {
    if (_sd_alloc_fn == 0) { return alloc(n); }
    return callptr(_sd_alloc_fn, n);
}

# @public — install `fp` (`fn(n): ptr`, 0 on failure) as the allocator for everything sadish
# allocates from now on. Returns the PREVIOUS hook so a caller can scope it (set, draw, restore).
# Passing 0 restores the global allocator.
fn sd_alloc_set(fp): i64 {
    var prev = _sd_alloc_fn;
    _sd_alloc_fn = fp;
    return prev;
}

# @public — the current hook; 0 = the global allocator.
fn sd_alloc_get(): i64 {
    return _sd_alloc_fn;
}

# --- error.cyr ---

# @public — stable API surface for sadish error handling.
# error.cyr — sadish vector-graphics error codes + Result helpers.
#
# SadishErr is a 16-byte record. Error codes are integer constants; for
# errors that carry context (a message pointer), use sadish_err_new(code,
# msg). The (ptr, err_out) Ok/Err split mirrors the ecosystem's raster
# libs (chitra) so a consumer maps a failure cleanly onto its own error.
#
# SadishErr struct layout (16 bytes):
#   +0: code    — error code constant (one of the SADISH_* below)
#   +8: detail  — pointer to detail string (or 0)

# ================================================================
# Error code constants
# ================================================================

enum SadishErrCode {
    SADISH_OK              = 0;   # no error
    SADISH_ERR_OOM         = 1;   # allocation failed / capacity cap hit
    SADISH_ERR_EMPTY_PATH  = 2;   # fill/flatten on a path with no verbs
    SADISH_ERR_BOUNDS      = 3;   # coordinate / canvas index out of range
    SADISH_ERR_UNSUPPORTED = 4;   # a valid request sadish can't yet honor
    SADISH_ERR_OTHER       = 99;  # catch-all
}

# ================================================================
# SadishErr struct
# ================================================================

# Create a SadishErr with code and an optional detail string (0 = none).
fn sadish_err_new(code, detail): i64 {
    var e = sd_alloc(16);
    store64(e, code);
    store64(e + 8, detail);
    return e;
}

# Create a SadishErr with code only (no detail).
fn sadish_err(code): i64 {
    return sadish_err_new(code, 0);
}

# Get the error code.
fn sadish_err_code(e): i64 {
    return load64(e);
}

# Get the detail string pointer (or 0).
fn sadish_err_detail(e): i64 {
    return load64(e + 8);
}

# ================================================================
# Error name lookup — returns a cstring (never null).
# ================================================================

fn sadish_err_name(code): i64 {
    if (code == SADISH_OK)              { return "ok"; }
    if (code == SADISH_ERR_OOM)         { return "out of memory"; }
    if (code == SADISH_ERR_EMPTY_PATH)  { return "empty path"; }
    if (code == SADISH_ERR_BOUNDS)      { return "out of bounds"; }
    if (code == SADISH_ERR_UNSUPPORTED) { return "unsupported feature"; }
    if (code == SADISH_ERR_OTHER)       { return "other error"; }
    return "unknown error";
}

# Print an error name to stderr (fd 2).
fn sadish_err_print_name(code): i64 {
    var name = sadish_err_name(code);
    syscall(1, 2, name, strlen(name));
    return 0;
}

# --- surface.cyr ---

# @public — sadish pixel surface: the direct primitives' destination buffer.
#
# surface.cyr — an SdSurface owns a width*height 32bpp pixel buffer in the
# ecosystem-convergent BGRA byte order (memory: B,G,R,A), so a packed sadish
# color 0x00RRGGBB lands verbatim in a little-endian 32bpp framebuffer. This is
# the DESTINATION buffer: the direct hairline/fill primitives in draw.cyr write
# here, and (v0.2+) the coverage blit in raster.cyr will composite onto it.
#
# Lifted, not reinvented: the pixel-write convention, the {w,h,px} layout, and
# the coordinate system (origin top-left, y-down, off = (y*w + x)*4) are the
# shared idiom proven across the ecosystem's framebuffer apps (encom-hits,
# cyrius-bb/-polyomino, cyrius-doom). See docs/development/prior-art.md.
#
# ⚠ That offset assumes the packed buffer. ROWS ARE `stride` BYTES APART, NOT
# `w*4`: off = y*stride + x*4. The two are the same number for every surface
# sd_surface_new makes, and differ on a WRAPPED one — a header over a wider buffer
# (dhancha's dh_surface_wrap over a framebuffer or a pane sub-rect). Every reader
# and writer of an SdSurface in sadish (this file, draw.cyr, the blits in
# raster.cyr, present.cyr) loads the stride once per call and addresses by it;
# programs/stride_test.cyr holds each of them to it on a hand-built wrapped header.

# ================================================================
# Color — a packed 0x00RRGGBB integer. Stored to the surface as BGRA with the
# alpha byte forced opaque (0xFF); read back RGB-packed (alpha dropped).
# ================================================================
# @public — pack (r,g,b) 0..255 into a sadish color 0x00RRGGBB.
fn sd_rgb(r, g, b): i64 {
    return ((r & 255) << 16) | ((g & 255) << 8) | (b & 255);
}
# @public — channel extractors.
fn sd_color_r(c): i64 { return (c >> 16) & 255; }
fn sd_color_g(c): i64 { return (c >> 8) & 255; }
fn sd_color_b(c): i64 { return c & 255; }

# ================================================================
# ALPHA (v0.5.0) — additive, and deliberately backward-compatible.
#
# Until now every sadish primitive hardcoded the alpha byte to 255 in four separate places, and the colour
# type had no alpha at all. That was invisible because nothing downstream read byte 3 — but agnos's
# gpu_shader_op#92 op 0x01 does: it performs PREMULTIPLIED src-over on the shader cores, which is the one
# thing a CPU blit cannot do cheaply. Without a real alpha channel the whole hardware-blend path had no
# producer.
#
# ⚠ THE LEGACY RULE, and it is what makes this additive: an alpha byte of 0 means OPAQUE, not invisible.
# sd_rgb(r,g,b) returns 0x00RRGGBB with byte 3 = 0, and every existing caller and test depends on that
# value. Treating 0 as transparent would make every pre-existing drawing vanish. So sd_alpha_of() maps
# 0 -> 255, and a caller who genuinely wants "draw nothing" simply does not draw.
# The cost: fully-transparent (a == 0) is not expressible as a colour. That is the right trade — it is the
# one alpha value with no visible effect.
# ================================================================
# @public — pack (r,g,b,a) into a sadish colour 0xAARRGGBB. a is 1..255; 0 is reserved (reads back opaque).
fn sd_rgba(r, g, b, a): i64 {
    return ((a & 255) << 24) | ((r & 255) << 16) | ((g & 255) << 8) | (b & 255);
}
# @public — the alpha a colour will actually be drawn with. 0 (a bare sd_rgb value) means OPAQUE.
fn sd_alpha_of(c): i64 {
    var a = (c >> 24) & 255;
    if (a == 0) { return 255; }
    return a;
}
# @public — raw alpha byte, WITHOUT the legacy 0-means-opaque mapping. For code that needs to know whether
# a colour carried an explicit alpha at all.
fn sd_color_a(c): i64 { return (c >> 24) & 255; }
# @public — PREMULTIPLY a colour: scale each channel by its own alpha, as gpu_shader_op#92 op 0x01 requires
# (c <= a). This is the sanctioned producer for surfaces flagged SETU_SURF_PREMULTIPLIED.
#
# ⚠ Passing STRAIGHT alpha to #92 does not error — it renders washed out, silently, with no diagnostic
# anywhere in the stack. Always route through here rather than multiplying by hand.
fn sd_premul(c): i64 {
    var a = sd_alpha_of(c);
    var r = (sd_color_r(c) * a) / 255;
    var g = (sd_color_g(c) * a) / 255;
    var b = (sd_color_b(c) * a) / 255;
    return sd_rgba(r, g, b, a);
}

# ================================================================
# SdSurface (32 bytes):
#   +0:  width   (i64 — pixels)
#   +8:  height  (i64 — pixels)
#   +16: pixels  (ptr — owned width*height*4 bytes, BGRA, packed)
#   +24: stride  (i64 — bytes per row; width*4 for the packed buffer, wider for a
#                 wrapped one — the row pitch every reader/writer addresses by)
# ================================================================
var SD_SURFACE_WIDTH_OFFSET  = 0;
var SD_SURFACE_HEIGHT_OFFSET = 8;
var SD_SURFACE_PIXELS_OFFSET = 16;
var SD_SURFACE_STRIDE_OFFSET = 24;
var SD_SURFACE_SIZE          = 32;

# @public — allocate a w*h BGRA surface, cleared to transparent black (0).
# Returns the SdSurface ptr, or 0 on OOM / bad dimensions.
fn sd_surface_new(w, h): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    var s = sd_alloc(SD_SURFACE_SIZE);
    if (s == 0) { return 0; }
    var nbytes = (w * h) * 4;
    var px = sd_alloc(nbytes);
    if (px == 0) { return 0; }
    memset(px, 0, nbytes);
    store64(s + SD_SURFACE_WIDTH_OFFSET, w);
    store64(s + SD_SURFACE_HEIGHT_OFFSET, h);
    store64(s + SD_SURFACE_PIXELS_OFFSET, px);
    store64(s + SD_SURFACE_STRIDE_OFFSET, (w * 4));
    return s;
}

# ---- accessors --------------------------------------------------
# @public
fn sd_surface_width(s): i64  { return load64(s + SD_SURFACE_WIDTH_OFFSET); }
# @public
fn sd_surface_height(s): i64 { return load64(s + SD_SURFACE_HEIGHT_OFFSET); }
# @public
fn sd_surface_pixels(s): i64 { return load64(s + SD_SURFACE_PIXELS_OFFSET); }
# @public
fn sd_surface_stride(s): i64 { return load64(s + SD_SURFACE_STRIDE_OFFSET); }

# Bounds-checked BGRA store of pixel (x, y) of a w*h buffer, given `row` = the
# address of row y's first pixel (`px + y * stride`, computed by the caller). The
# private helper every per-pixel primitive (sd_plot, sd_line, sd_put) shares so the
# write convention lives in one place. ⚠ Row pointer, not (px, stride): the stride
# form needs a 7th argument, which goes on the stack (MEASURED ~4% slower on an
# sd_line-only workload); sd_line also steps the row pointer rather than multiplying.
# `row` may point anywhere when y is out of range; it is only dereferenced after
# the bounds checks pass.
fn _sd_put_row(row, w, h, x, y, color): i64 {
    if (x < 0) { return 0; }
    if (x >= w) { return 0; }
    if (y < 0) { return 0; }
    if (y >= h) { return 0; }
    var off = x * 4;
    store8(row + off, color & 255);
    store8(row + off + 1, (color >> 8) & 255);
    store8(row + off + 2, (color >> 16) & 255);
    store8(row + off + 3, sd_alpha_of(color));   # v0.5.0: honour the colour's alpha (0 == opaque, legacy)
    return 0;
}

# The same store into a PACKED buffer (rows w*4 bytes apart) — the pre-stride
# signature, kept working (no consumer calls it; nothing in sadish does any more).
# A raw pointer carries no stride, so this form cannot address a wrapped surface;
# sd_plot / sd_line pass the surface's own stride to _sd_put_row instead.
fn sd_put(px, w, h, x, y, color): i64 {
    return _sd_put_row(px + y * (w * 4), w, h, x, y, color);
}

# @public — read a pixel back as a packed 0x00RRGGBB color (alpha dropped).
# Out-of-bounds reads return 0. The readback path for tests + coverage compositing.
fn sd_surface_pixel_at(s, x, y): i64 {
    var w = load64(s + SD_SURFACE_WIDTH_OFFSET);
    var h = load64(s + SD_SURFACE_HEIGHT_OFFSET);
    if (x < 0) { return 0; }
    if (y < 0) { return 0; }
    if (x >= w) { return 0; }
    if (y >= h) { return 0; }
    var px = load64(s + SD_SURFACE_PIXELS_OFFSET);
    var off = y * load64(s + SD_SURFACE_STRIDE_OFFSET) + x * 4;
    var b = load8(px + off);
    var g = load8(px + off + 1);
    var r = load8(px + off + 2);
    return (r << 16) | (g << 8) | b;
}

# --- draw.cyr ---

# @public — sadish direct 2D primitives (opaque, integer-pixel).
#
# draw.cyr — hairline + axis-aligned primitives adapted from the ecosystem's
# framebuffer games (integer Bresenham line, hline/vline fast paths, rect
# outline, filled rect, clear). This is the "easy 80%" LIFTED rather than
# reinvented (see docs/development/prior-art.md): proven, dependency-free,
# opaque 1px drawing onto an SdSurface. The anti-aliased / coverage / winding
# path is the separate vector core (path.cyr -> raster.cyr).
#
# All coordinates are whole integer pixels; color is a packed 0x00RRGGBB.
# The Bresenham body is encom-hits/src/draw.cyr:7-55 verbatim in structure,
# retargeted from a fixed 320x240 to the SdSurface's own width/height.
#
# ⚠ Every primitive here addresses rows by `sd_surface_stride(s)` (loaded once per
# call), never `w * 4` — see surface.cyr. Through 0.5.5 only sd_canvas_blit_at did,
# and a WINDOW background sd_fill_rect'd into a wrapped 200x60 header overwrote
# 4,000 padding pixels under text that landed straight (MEASURED, the 0.5.5 review).

# @public — plot one pixel (bounds-checked; off-surface is a silent no-op).
fn sd_plot(s, x, y, color): i64 {
    var w = load64(s + SD_SURFACE_WIDTH_OFFSET);
    var h = load64(s + SD_SURFACE_HEIGHT_OFFSET);
    var px = load64(s + SD_SURFACE_PIXELS_OFFSET);
    var stride = load64(s + SD_SURFACE_STRIDE_OFFSET);
    return _sd_put_row(px + y * stride, w, h, x, y, color);
}

# @public — Bresenham line from (x0,y0) to (x1,y1). Integer, per-pixel clipped.
fn sd_line(s, x0, y0, x1, y1, color): i64 {
    var w = load64(s + SD_SURFACE_WIDTH_OFFSET);
    var h = load64(s + SD_SURFACE_HEIGHT_OFFSET);
    var px = load64(s + SD_SURFACE_PIXELS_OFFSET);
    var stride = load64(s + SD_SURFACE_STRIDE_OFFSET);
    var dx = x1 - x0;
    var dy = y1 - y0;
    if (dx < 0) { dx = 0 - dx; }
    if (dy < 0) { dy = 0 - dy; }
    var sx = 1;
    if (x0 > x1) { sx = 0 - 1; }
    var sy = 1;
    if (y0 > y1) { sy = 0 - 1; }
    var err = dx - dy;
    var x = x0;
    var y = y0;
    # The row pointer steps with y instead of being re-multiplied per pixel: MEASURED, 18,000 lines on
    # 1024x768, `px + y * stride` per pixel cost ~3.8% over 0.5.5; tracked, within noise (median of 6:
    # 0.264 s 0.5.5, 0.267 s here).
    var row = px + y0 * stride;
    var drow = stride * sy;
    while (1) {
        _sd_put_row(row, w, h, x, y, color);
        if (x == x1) {
            if (y == y1) { return 0; }
        }
        var e2 = err * 2;
        if (e2 > (0 - dy)) { err = err - dy; x = x + sx; }
        if (e2 < dx) { err = err + dx; y = y + sy; row = row + drow; }
    }
    return 0;
}

# @public — horizontal span [x0,x1] at row y (endpoints clamped to the surface).
fn sd_hline(s, x0, x1, y, color): i64 {
    var w = load64(s + SD_SURFACE_WIDTH_OFFSET);
    var h = load64(s + SD_SURFACE_HEIGHT_OFFSET);
    if (y < 0) { return 0; }
    if (y >= h) { return 0; }
    var px = load64(s + SD_SURFACE_PIXELS_OFFSET);
    var start = x0;
    var end = x1;
    if (start > end) { var tmp = start; start = end; end = tmp; }
    if (start < 0) { start = 0; }
    if (end >= w) { end = w - 1; }
    var base = y * load64(s + SD_SURFACE_STRIDE_OFFSET);
    var x = start;
    while (x <= end) {
        var off = base + x * 4;
        store8(px + off, color & 255);
        store8(px + off + 1, (color >> 8) & 255);
        store8(px + off + 2, (color >> 16) & 255);
        store8(px + off + 3, sd_alpha_of(color));   # v0.5.0: honour alpha (0 == opaque)
        x = x + 1;
    }
    return 0;
}

# @public — vertical span [y0,y1] at column x (endpoints clamped to the surface).
fn sd_vline(s, x, y0, y1, color): i64 {
    var w = load64(s + SD_SURFACE_WIDTH_OFFSET);
    var h = load64(s + SD_SURFACE_HEIGHT_OFFSET);
    if (x < 0) { return 0; }
    if (x >= w) { return 0; }
    var px = load64(s + SD_SURFACE_PIXELS_OFFSET);
    var stride = load64(s + SD_SURFACE_STRIDE_OFFSET);
    var start = y0;
    var end = y1;
    if (start > end) { var tmp = start; start = end; end = tmp; }
    if (start < 0) { start = 0; }
    if (end >= h) { end = h - 1; }
    var y = start;
    while (y <= end) {
        var off = y * stride + x * 4;
        store8(px + off, color & 255);
        store8(px + off + 1, (color >> 8) & 255);
        store8(px + off + 2, (color >> 16) & 255);
        store8(px + off + 3, sd_alpha_of(color));   # v0.5.0: honour alpha (0 == opaque)
        y = y + 1;
    }
    return 0;
}

# @public — rectangle OUTLINE (4 edges); top-left (x,y), size rw*rh.
fn sd_rect(s, x, y, rw, rh, color): i64 {
    sd_hline(s, x, x + rw - 1, y, color);
    sd_hline(s, x, x + rw - 1, y + rh - 1, color);
    sd_vline(s, x, y, y + rh - 1, color);
    sd_vline(s, x + rw - 1, y, y + rh - 1, color);
    return 0;
}

# @public — FILLED rectangle; top-left (x,y), size rw*rh.
# @public — ALPHA-BLENDED horizontal span: `color` composited OVER what is already there, at
# coverage `a` (0..255). The workhorse under `sd_fill_rect_blend`.
#
# ⭐⭐ THE FIRST FILL IN sadish THAT READS ITS DESTINATION. Every other span writer stores four bytes
# per pixel and never loads — which is correct and fast for opaque paint, and is exactly why a
# translucent veil was impossible until now. dhancha wanted a modal backdrop and had to ship a
# scanline dim instead; this is what that was waiting on.
#
# ⛔⛔ `a` IS AN EXPLICIT ARGUMENT AND 0 MEANS FULLY TRANSPARENT — THE OPPOSITE OF `sd_alpha_of`.
# The legacy packed-alpha rule maps a 0 byte to **opaque** (`sd_alpha_of`), which exists so a bare
# `sd_rgb` value is not invisible. Carrying that convention into a blend would make
# `sd_fill_rect_blend(..., 0)` paint SOLID — the single most surprising outcome available, and the
# exact trap that made `sd_rgba(0,0,0,128)` paint black. ⇒ Alpha is passed separately, it is never
# read out of `color`, and 0 is a no-op.
#
# ⚠ SOURCE-OVER, INTEGER, PER CHANNEL: `out = (src*a + dst*(255-a)) / 255`. Rounding is truncation,
# so a 50 % veil applied twice is not identical to one at 75 % — which is true of any integer
# compositor and is not worth a fractional pixel format to fix.
# ⚠ THE DESTINATION ALPHA BYTE IS LEFT AT 255. sadish surfaces are opaque render targets; a blend
# that also composited alpha would make the result translucent to whatever draws it next, and every
# consumer here presents to a screen.
fn sd_blend_hline(s, x0, x1, y, color, a): i64 {
    if (a <= 0) { return 0; }
    var w = load64(s + SD_SURFACE_WIDTH_OFFSET);
    var h = load64(s + SD_SURFACE_HEIGHT_OFFSET);
    if (y < 0) { return 0; }
    if (y >= h) { return 0; }
    var px = load64(s + SD_SURFACE_PIXELS_OFFSET);
    var start = x0;
    var end = x1;
    if (start > end) { var tmp = start; start = end; end = tmp; }
    if (start < 0) { start = 0; }
    if (end >= w) { end = w - 1; }
    var av = a;
    if (av > 255) { av = 255; }
    var inv = 255 - av;
    # ⚠ The buffer is BGRA: byte 0 is BLUE, matching `sd_hline`'s store order and `sd_rgb`'s packing.
    var sb = color & 255;
    var sg = (color >> 8) & 255;
    var sr = (color >> 16) & 255;
    var base = y * load64(s + SD_SURFACE_STRIDE_OFFSET);
    var x = start;
    while (x <= end) {
        var off = base + x * 4;
        store8(px + off, (sb * av + load8(px + off) * inv) / 255);
        store8(px + off + 1, (sg * av + load8(px + off + 1) * inv) / 255);
        store8(px + off + 2, (sr * av + load8(px + off + 2) * inv) / 255);
        store8(px + off + 3, 255);
        x = x + 1;
    }
    return 0;
}

# @public — fill a rect with `color` composited OVER the destination at coverage `a` (0..255).
# `a == 0` paints nothing; `a == 255` is exactly `sd_fill_rect`.
#
# ⚠ THIS IS WHAT A SCRIM IS. A modal backdrop, a selection wash, a disabled overlay — every one of
# them is this call, and every consumer that wanted one has until now had to fake it with a dither.
fn sd_fill_rect_blend(s, x, y, rw, rh, color, a): i64 {
    var row = 0;
    while (row < rh) {
        sd_blend_hline(s, x, x + rw - 1, y + row, color, a);
        row = row + 1;
    }
    return 0;
}

fn sd_fill_rect(s, x, y, rw, rh, color): i64 {
    var row = 0;
    while (row < rh) {
        sd_hline(s, x, x + rw - 1, y + row, color);
        row = row + 1;
    }
    return 0;
}

# @public — clear the whole surface to `color`.
fn sd_clear(s, color): i64 {
    var w = load64(s + SD_SURFACE_WIDTH_OFFSET);
    var h = load64(s + SD_SURFACE_HEIGHT_OFFSET);
    return sd_fill_rect(s, 0, 0, w, h, color);
}

# --- present.cyr ---

# @public — sadish present backend: get a surface onto a screen.
#
# present.cyr — takes an SdSurface and displays it. Two sinks:
#
#   1. sd_surface_write_ppm(s, path) — write the surface as a binary P6 PPM.
#      Platform-neutral (file syscalls only); the headless / CI / debug path.
#   2. SdPresenter (sd_present_open/blit/close) — the LINUX host framebuffer
#      sink: open /dev/fb0, probe real geometry (VSCREENINFO/FSCREENINFO),
#      integer-scale + center-letterbox the surface honoring the physical
#      pitch, and write the active band. Adapted from encom-hits/src/engine.cyr
#      (probe/blit) — which fixed the "tiles across the top band" pitch bug
#      shared by cyrius-doom/-polyomino. See docs/development/prior-art.md.
#
# The encom original was module-global + fixed 320x240; sadish's is
# struct-based (reentrant) and takes the surface's own dimensions. Timing /
# frame-pacing (game-specific) is intentionally left out.
#
# ⚠ sd_present_blit writes to the LIVE framebuffer — never call it from a test.
# The fb0 path is Linux-specific (raw open/ioctl/lseek/write); the AGNOS sink
# (kernel blit#39) is a future backend beside this one.

# ---- PPM sink (platform-neutral) --------------------------------
# Write the decimal ASCII of a non-negative n into buf at off; return new off.
fn sd_ppm_put_dec(buf, off, n): i64 {
    if (n == 0) {
        store8(buf + off, 48);
        return off + 1;
    }
    var digits = 0;
    var t = n;
    while (t > 0) { digits = digits + 1; t = t / 10; }
    var i = digits - 1;
    while (i >= 0) {
        store8(buf + off + i, 48 + (n % 10));
        n = n / 10;
        i = i - 1;
    }
    return off + digits;
}

# Build "P6\n<w> <h>\n255\n" into buf; return its byte length.
fn sd_ppm_header(buf, w, h): i64 {
    var o = 0;
    store8(buf + o, 80); o = o + 1;   # 'P'
    store8(buf + o, 54); o = o + 1;   # '6'
    store8(buf + o, 10); o = o + 1;   # newline
    o = sd_ppm_put_dec(buf, o, w);
    store8(buf + o, 32); o = o + 1;   # space
    o = sd_ppm_put_dec(buf, o, h);
    store8(buf + o, 10); o = o + 1;   # newline
    store8(buf + o, 50); o = o + 1;   # '2'
    store8(buf + o, 53); o = o + 1;   # '5'
    store8(buf + o, 53); o = o + 1;   # '5'
    store8(buf + o, 10); o = o + 1;   # newline
    return o;
}

# @public — write the surface as a binary P6 PPM to `path`. BGRA -> RGB at
# write time. Returns SADISH_OK, or SADISH_ERR_OTHER if the file won't open.
fn sd_surface_write_ppm(s, path): i64 {
    if (s == 0) { return SADISH_ERR_BOUNDS; }
    var w = sd_surface_width(s);
    var h = sd_surface_height(s);
    var px = sd_surface_pixels(s);
    var stride = sd_surface_stride(s);
    # open(path, O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577, mode 0644 = 420)
    var fd = syscall(2, path, 577, 420);
    if (fd < 0) { return SADISH_ERR_OTHER; }
    var hdr = sd_alloc(32);
    var hlen = sd_ppm_header(hdr, w, h);
    syscall(1, fd, hdr, hlen);
    var n = w * h;
    var rgb = sd_alloc(n * 3);
    # ⚠ Row by row at the surface's stride, not one run of w*h pixels: on a WRAPPED
    # surface the bytes between one row's end and the next row's start are not its pixels.
    var j = 0;
    var y = 0;
    while (y < h) {
        var row = px + y * stride;
        var x = 0;
        while (x < w) {
            var off = x * 4;
            store8(rgb + j, load8(row + off + 2));      # R (BGRA byte 2)
            store8(rgb + j + 1, load8(row + off + 1));  # G
            store8(rgb + j + 2, load8(row + off));      # B (byte 0)
            x = x + 1;
            j = j + 3;
        }
        y = y + 1;
    }
    syscall(1, fd, rgb, n * 3);
    syscall(3, fd);
    return SADISH_OK;
}

# ================================================================
# SdPresenter (72 bytes) — a Linux /dev/fb0 display sink.
#   +0  fd     +8  xres   +16 yres   +24 bpp   +32 pitch   +64 blit-scratch(ptr)
# ================================================================
var SD_PRES_FD_OFFSET    = 0;
var SD_PRES_XRES_OFFSET  = 8;
var SD_PRES_YRES_OFFSET  = 16;
var SD_PRES_BPP_OFFSET   = 24;
var SD_PRES_PITCH_OFFSET = 32;
var SD_PRES_BLIT_OFFSET  = 64;
var SD_PRESENTER_SIZE    = 72;

# @public — open /dev/fb0 and probe geometry. Returns an SdPresenter, or 0 if
# the framebuffer is unavailable (no device / no permission) — callers fall
# back to sd_surface_write_ppm.
fn sd_present_open(): i64 {
    var fd = syscall(2, "/dev/fb0", 2, 0);   # open O_RDWR
    if (fd < 0) { return 0; }
    var vinfo = sd_alloc(256);
    var finfo = sd_alloc(256);
    memset(vinfo, 0, 256);
    memset(finfo, 0, 256);
    syscall(16, fd, 0x4600, vinfo);   # ioctl FBIOGET_VSCREENINFO
    syscall(16, fd, 0x4602, finfo);   # ioctl FBIOGET_FSCREENINFO
    var xres = load32(vinfo + 0);     # fb_var_screeninfo.xres
    var yres = load32(vinfo + 4);     # .yres
    var bpp  = load32(vinfo + 24);    # .bits_per_pixel
    var pitch = load32(finfo + 48);   # fb_fix_screeninfo.line_length
    if (xres <= 0) { xres = 640; }
    if (yres <= 0) { yres = 480; }
    if (bpp  <= 0) { bpp  = 32; }
    var minpitch = xres * (bpp / 8);
    if (pitch < minpitch) { pitch = minpitch; }
    var p = sd_alloc(SD_PRESENTER_SIZE);
    store64(p + SD_PRES_FD_OFFSET, fd);
    store64(p + SD_PRES_XRES_OFFSET, xres);
    store64(p + SD_PRES_YRES_OFFSET, yres);
    store64(p + SD_PRES_BPP_OFFSET, bpp);
    store64(p + SD_PRES_PITCH_OFFSET, pitch);
    var blit = sd_alloc(pitch * yres);
    memset(blit, 0, pitch * yres);
    store64(p + SD_PRES_BLIT_OFFSET, blit);
    return p;
}

# @public — scale + center-letterbox `s` into the framebuffer and write it.
# ⚠ writes to the live display. Integer scale = largest that fits both axes.
fn sd_present_blit(p, s): i64 {
    if (p == 0) { return SADISH_ERR_BOUNDS; }
    if (s == 0) { return SADISH_ERR_BOUNDS; }
    var fd = load64(p + SD_PRES_FD_OFFSET);
    var xres = load64(p + SD_PRES_XRES_OFFSET);
    var yres = load64(p + SD_PRES_YRES_OFFSET);
    var bpp = load64(p + SD_PRES_BPP_OFFSET);
    var pitch = load64(p + SD_PRES_PITCH_OFFSET);
    var blit = load64(p + SD_PRES_BLIT_OFFSET);
    var sw = sd_surface_width(s);
    var sh = sd_surface_height(s);
    var srcpx = sd_surface_pixels(s);
    var srcstride = sd_surface_stride(s);   # ⚠ source row pitch in bytes — not sw*4 on a wrapped surface

    var scale = xres / sw;
    var scy = yres / sh;
    if (scy < scale) { scale = scy; }
    if (scale < 1) { scale = 1; }
    var xoff = (xres - sw * scale) / 2;
    var yoff = (yres - sh * scale) / 2;
    if (xoff < 0) { xoff = 0; }
    if (yoff < 0) { yoff = 0; }
    var bpp_bytes = bpp / 8;
    var row_bytes = sw * (scale * bpp_bytes);

    var sy = 0;
    while (sy < sh) {
        var src_row = srcpx + sy * srcstride;
        var dy0 = yoff + sy * scale;
        var first = blit + dy0 * pitch + xoff * bpp_bytes;
        var dx = first;
        var sx = 0;
        while (sx < sw) {
            var so = sx * 4;
            if (bpp == 16) {
                var b = load8(src_row + so);
                var g = load8(src_row + so + 1);
                var r = load8(src_row + so + 2);
                var p16 = ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
                var rx = 0;
                while (rx < scale) {
                    store8(dx, p16 & 0xFF);
                    store8(dx + 1, (p16 >> 8) & 0xFF);
                    dx = dx + 2;
                    rx = rx + 1;
                }
            } else {
                var p32 = load32(src_row + so) | 0xFF000000;
                var rx = 0;
                while (rx < scale) {
                    store32(dx, p32);
                    dx = dx + bpp_bytes;
                    rx = rx + 1;
                }
            }
            sx = sx + 1;
        }
        var ry = 1;
        while (ry < scale) {
            memcpy(blit + (dy0 + ry) * pitch + xoff * bpp_bytes, first, row_bytes);
            ry = ry + 1;
        }
        sy = sy + 1;
    }

    var rows = sh * scale;
    if (yoff + rows > yres) { rows = yres - yoff; }
    syscall(8, fd, yoff * pitch, 0);                    # lseek SEEK_SET
    syscall(1, fd, blit + yoff * pitch, rows * pitch);  # write active band
    return SADISH_OK;
}

# @public — close the framebuffer fd.
fn sd_present_close(p): i64 {
    if (p == 0) { return SADISH_OK; }
    syscall(3, load64(p + SD_PRES_FD_OFFSET));
    return SADISH_OK;
}

# --- geom.cyr ---

# @public — sadish geometry primitives: points + affine matrices.
#
# geom.cyr — the fixed-point coordinate substrate for the whole
# rasterizer. Everything-is-i64, so sub-pixel coordinates use 16.16
# signed fixed-point: the low 16 bits are the fraction, the high bits the
# integer part. 1.0 == SD_ONE (65536); an integer pixel n == n << 16.
# This keeps the entire vector pipeline (paths, flattening, transforms,
# scanline coverage) in exact integer arithmetic — no float in the core.

# ---- 16.16 fixed-point scale ------------------------------------
# 1.0 in 16.16. Shift a plain integer pixel value left by SD_SHIFT to
# lift it into fixed-point; shift right to drop back to whole pixels.
var SD_SHIFT = 16;
var SD_ONE   = 65536;    # 1 << 16

# @public — Arithmetic (sign-preserving) right shift by n. Cyrius `>>` is
# LOGICAL (zero-fill), so a plain `>>` on a negative value fills the sign
# bits with 0 and corrupts it — load-bearing for every signed subpixel /
# coverage / transform computation in the rasterizer. Valid for 0 <= n <= 63.
fn sd_asr(x, n): i64 {
    if (n <= 0) { return x; }
    if (x >= 0) { return x >> n; }
    var top = (0 - 1) << (64 - n);   # top n bits all-ones (sign extension)
    return (x >> n) | top;
}

# @public — absolute value.
fn sd_abs(v): i64 {
    if (v < 0) { return 0 - v; }
    return v;
}

# @public — integer floor square root (Newton's method). n <= 0 -> 0. Note:
# isqrt of a raw `dx*dx + dy*dy` (16.16 deltas) yields the length in 16.16
# directly, since (L·2^16)^2 = L^2·2^32 = the raw squared-length.
fn sd_isqrt(n): i64 {
    if (n <= 0) { return 0; }
    var x = n;
    var y = (x + 1) >> 1;
    while (y < x) {
        x = y;
        y = (x + n / x) >> 1;
    }
    return x;
}

# Multiply two 16.16 fixed-point values -> 16.16. (a*b) has 32 fractional
# bits; drop back down by SD_SHIFT via the SIGNED shift (sd_asr) so negative
# products — mirrors, rotations, below-origin coordinates — stay correct.
# TODO(v0.x): the 64-bit intermediate is fine for on-canvas magnitudes; a
# saturating variant is future work once large user transforms are in scope.
fn sd_fixed_mul(a, b): i64 {
    return sd_asr(a * b, SD_SHIFT);
}

# ================================================================
# SdPoint — a 2D point in 16.16 fixed-point (16 bytes).
#   +0: x   (i64 — 16.16 fixed-point)
#   +8: y   (i64 — 16.16 fixed-point)
# ================================================================
var SD_POINT_X_OFFSET = 0;
var SD_POINT_Y_OFFSET = 8;
var SD_POINT_SIZE     = 16;

# @public
fn sd_point_new(x, y): i64 {
    var p = sd_alloc(SD_POINT_SIZE);
    store64(p + SD_POINT_X_OFFSET, x);
    store64(p + SD_POINT_Y_OFFSET, y);
    return p;
}

# @public
fn sd_point_x(p): i64 { return load64(p + SD_POINT_X_OFFSET); }
# @public
fn sd_point_y(p): i64 { return load64(p + SD_POINT_Y_OFFSET); }

# ================================================================
# SdMatrix — a 2x3 affine transform (6 values, 48 bytes).
# Maps (x, y) -> (a*x + c*y + e,  b*x + d*y + f). All values 16.16.
#   +0:  a    +8:  b
#   +16: c    +24: d
#   +32: e    +40: f
# The (a,b,c,d) 2x2 is the linear part; (e,f) the translation.
# ================================================================
var SD_MAT_A_OFFSET = 0;
var SD_MAT_B_OFFSET = 8;
var SD_MAT_C_OFFSET = 16;
var SD_MAT_D_OFFSET = 24;
var SD_MAT_E_OFFSET = 32;
var SD_MAT_F_OFFSET = 40;
var SD_MATRIX_SIZE  = 48;

# Low-level constructor from all six 16.16 components.
fn sd_matrix_new(a, b, c, d, e, f): i64 {
    var m = sd_alloc(SD_MATRIX_SIZE);
    store64(m + SD_MAT_A_OFFSET, a);
    store64(m + SD_MAT_B_OFFSET, b);
    store64(m + SD_MAT_C_OFFSET, c);
    store64(m + SD_MAT_D_OFFSET, d);
    store64(m + SD_MAT_E_OFFSET, e);
    store64(m + SD_MAT_F_OFFSET, f);
    return m;
}

# @public — the identity matrix (a=d=1.0, all else 0).
fn sd_matrix_identity(): i64 {
    return sd_matrix_new(SD_ONE, 0, 0, SD_ONE, 0, 0);
}

# @public — a pure translation by (tx, ty), both 16.16.
fn sd_matrix_translate(tx, ty): i64 {
    return sd_matrix_new(SD_ONE, 0, 0, SD_ONE, tx, ty);
}

# @public — a pure scale by (sx, sy), both 16.16.
fn sd_matrix_scale(sx, sy): i64 {
    return sd_matrix_new(sx, 0, 0, sy, 0, 0);
}

# @public — compose two affine transforms: result applies `n` THEN `m`
# (i.e. result(pt) == m(n(pt))). Standard 2x3 * 2x3 affine product.
fn sd_matrix_mul(m, n): i64 {
    var ma = load64(m + SD_MAT_A_OFFSET);
    var mb = load64(m + SD_MAT_B_OFFSET);
    var mc = load64(m + SD_MAT_C_OFFSET);
    var md = load64(m + SD_MAT_D_OFFSET);
    var me = load64(m + SD_MAT_E_OFFSET);
    var mf = load64(m + SD_MAT_F_OFFSET);
    var na = load64(n + SD_MAT_A_OFFSET);
    var nb = load64(n + SD_MAT_B_OFFSET);
    var nc = load64(n + SD_MAT_C_OFFSET);
    var nd = load64(n + SD_MAT_D_OFFSET);
    var ne = load64(n + SD_MAT_E_OFFSET);
    var nf = load64(n + SD_MAT_F_OFFSET);
    var ra = sd_fixed_mul(na, ma) + sd_fixed_mul(nb, mc);
    var rb = sd_fixed_mul(na, mb) + sd_fixed_mul(nb, md);
    var rc = sd_fixed_mul(nc, ma) + sd_fixed_mul(nd, mc);
    var rd = sd_fixed_mul(nc, mb) + sd_fixed_mul(nd, md);
    var re = sd_fixed_mul(ne, ma) + sd_fixed_mul(nf, mc) + me;
    var rf = sd_fixed_mul(ne, mb) + sd_fixed_mul(nf, md) + mf;
    return sd_matrix_new(ra, rb, rc, rd, re, rf);
}

# @public — apply an affine transform to a point, returning a new SdPoint.
# (x, y) -> (a*x + c*y + e,  b*x + d*y + f). All 16.16.
fn sd_matrix_apply(m, pt): i64 {
    var x = sd_point_x(pt);
    var y = sd_point_y(pt);
    var a = load64(m + SD_MAT_A_OFFSET);
    var b = load64(m + SD_MAT_B_OFFSET);
    var c = load64(m + SD_MAT_C_OFFSET);
    var d = load64(m + SD_MAT_D_OFFSET);
    var e = load64(m + SD_MAT_E_OFFSET);
    var f = load64(m + SD_MAT_F_OFFSET);
    var nx = sd_fixed_mul(a, x) + sd_fixed_mul(c, y) + e;
    var ny = sd_fixed_mul(b, x) + sd_fixed_mul(d, y) + f;
    return sd_point_new(nx, ny);
}

# ================================================================
# Fixed-point trig via CORDIC — sovereign (no float, no libm), all shifts +
# adds through the SIGNED sd_asr. 16 rotation iterations after range-reducing
# to [-pi/2, pi/2]; accurate to a few 16.16 LSBs.
# ================================================================
# atan(2^-i) in 16.16 radians, i = 0..15.
fn sd_cordic_atan(i): i64 {
    if (i == 0)  { return 51472; }
    if (i == 1)  { return 30386; }
    if (i == 2)  { return 16055; }
    if (i == 3)  { return 8150; }
    if (i == 4)  { return 4091; }
    if (i == 5)  { return 2047; }
    if (i == 6)  { return 1024; }
    if (i == 7)  { return 512; }
    if (i == 8)  { return 256; }
    if (i == 9)  { return 128; }
    if (i == 10) { return 64; }
    if (i == 11) { return 32; }
    if (i == 12) { return 16; }
    if (i == 13) { return 8; }
    if (i == 14) { return 4; }
    return 2;
}

# theta in 16.16 radians -> cos (want_sin=0) or sin (want_sin=1) in 16.16.
fn sd_cordic(theta, want_sin): i64 {
    var two_pi = 411775;
    var pi = 205887;
    var half_pi = 102944;
    var t = theta;
    while (t > pi) { t = t - two_pi; }
    while (t < 0 - pi) { t = t + two_pi; }
    # Fold [-pi,pi] into [-pi/2, pi/2]; a fold past +-pi/2 flips both signs.
    var flip = 0;
    if (t > half_pi) { t = t - pi; flip = 1; }
    if (t < 0 - half_pi) { t = t + pi; flip = 1; }

    var x = 39797;   # K gain (1 / A_16) in 16.16 — cancels the CORDIC gain
    var y = 0;
    var z = t;
    var i = 0;
    while (i < 16) {
        var dx = sd_asr(x, i);
        var dy = sd_asr(y, i);
        if (z >= 0) {
            x = x - dy;
            y = y + dx;
            z = z - sd_cordic_atan(i);
        } else {
            x = x + dy;
            y = y - dx;
            z = z + sd_cordic_atan(i);
        }
        i = i + 1;
    }
    if (flip != 0) { x = 0 - x; y = 0 - y; }
    if (want_sin != 0) { return y; }
    return x;
}

# @public — cos(theta), theta in 16.16 radians -> 16.16.
fn sd_cos(theta): i64 { return sd_cordic(theta, 0); }
# @public — sin(theta), theta in 16.16 radians -> 16.16.
fn sd_sin(theta): i64 { return sd_cordic(theta, 1); }

# @public — rotation by `theta` (16.16 radians). Maps (x,y) ->
# (x*cos - y*sin, x*sin + y*cos): a=cos, b=sin, c=-sin, d=cos.
fn sd_matrix_rotate(theta): i64 {
    var c = sd_cos(theta);
    var s = sd_sin(theta);
    return sd_matrix_new(c, s, 0 - s, c, 0, 0);
}

# Divide two 16.16 fixed-point values -> 16.16 (signed). The a<<SD_SHIFT
# pre-scale is exact for on-canvas / trig magnitudes; very large operands can
# overflow the 64-bit intermediate (same caveat as sd_fixed_mul). b==0 -> 0.
fn sd_fixed_div(a, b): i64 {
    if (b == 0) { return 0; }
    return (a << SD_SHIFT) / b;
}

# @public — skew by angles (ax, ay) in 16.16 radians. x' = x + y*tan(ax),
# y' = y + x*tan(ay): a=1, c=tan(ax), b=tan(ay), d=1. tan = sin/cos.
fn sd_matrix_skew(ax, ay): i64 {
    var tx = sd_fixed_div(sd_sin(ax), sd_cos(ax));
    var ty = sd_fixed_div(sd_sin(ay), sd_cos(ay));
    return sd_matrix_new(SD_ONE, ty, tx, SD_ONE, 0, 0);
}

# --- path.cyr ---

# @public — sadish path construction + curve flattening.
#
# path.cyr — an SdPath is a growable command list: a stream of verbs
# (moveto / lineto / quadto / cubicto / close) plus a parallel stream of
# control points. This is the resolution-independent geometry a consumer
# builds; the rasterizer (raster.cyr) consumes the FLATTENED polyline the
# curve verbs expand into.
#
# Storage model: two bump-allocated arrays sized at construction. Verbs
# are one i64 each; points are SdPoint pointers (one i64 each). A quadto
# consumes 2 points (control, end); a cubicto 3 (c1, c2, end); moveto and
# lineto 1 (the target); close 0. Storage is unbounded as of v0.4.0 —
# sd_path_grow doubles both arrays on overflow; SD_PATH_CAP is only the
# initial allocation.

# ---- verb tags --------------------------------------------------
var SD_VERB_MOVETO = 0;
var SD_VERB_LINETO = 1;
var SD_VERB_QUADTO = 2;
var SD_VERB_CUBICTO = 3;
var SD_VERB_CLOSE  = 4;

# Initial capacity for both the verb and point arrays; sd_path_grow doubles
# them on overflow (v0.4.0), so this is just the first allocation size.
var SD_PATH_CAP = 256;

# ================================================================
# SdPath (48 bytes):
#   +0:  verbs      (ptr — array of SD_PATH_CAP i64 verb tags)
#   +8:  n_verbs    (i64 — verb count)
#   +16: points     (ptr — array of SD_PATH_CAP i64 SdPoint ptrs)
#   +24: n_points   (i64 — point count)
#   +32: cap        (i64 — capacity, in verbs and points)
#   +40: reserved   (i64 — 0; future flags: subpath-open, bounds-cached)
# ================================================================
var SD_PATH_VERBS_OFFSET    = 0;
var SD_PATH_NVERBS_OFFSET   = 8;
var SD_PATH_POINTS_OFFSET   = 16;
var SD_PATH_NPOINTS_OFFSET  = 24;
var SD_PATH_CAP_OFFSET      = 32;
var SD_PATH_RESERVED_OFFSET = 40;
var SD_PATH_SIZE            = 48;

# @public — allocate an empty path.
fn sd_path_new(): i64 {
    var p = sd_alloc(SD_PATH_SIZE);
    if (p == 0) { return 0; }
    var verbs = sd_alloc(SD_PATH_CAP * 8);
    var points = sd_alloc(SD_PATH_CAP * 8);
    store64(p + SD_PATH_VERBS_OFFSET, verbs);
    store64(p + SD_PATH_NVERBS_OFFSET, 0);
    store64(p + SD_PATH_POINTS_OFFSET, points);
    store64(p + SD_PATH_NPOINTS_OFFSET, 0);
    store64(p + SD_PATH_CAP_OFFSET, SD_PATH_CAP);
    store64(p + SD_PATH_RESERVED_OFFSET, 0);
    return p;
}

# ---- accessors --------------------------------------------------
# @public
fn sd_path_verb_count(path): i64  { return load64(path + SD_PATH_NVERBS_OFFSET); }
# @public
fn sd_path_point_count(path): i64 { return load64(path + SD_PATH_NPOINTS_OFFSET); }

# Double both the verb and point arrays (copying live entries). Returns
# SADISH_OK, or SADISH_ERR_OOM if the larger allocation fails.
fn sd_path_grow(path): i64 {
    var cap = load64(path + SD_PATH_CAP_OFFSET);
    var newcap = cap * 2;
    var nv = sd_alloc(newcap * 8);
    if (nv == 0) { return SADISH_ERR_OOM; }
    var np = sd_alloc(newcap * 8);
    if (np == 0) { return SADISH_ERR_OOM; }
    var nverbs = load64(path + SD_PATH_NVERBS_OFFSET);
    var npoints = load64(path + SD_PATH_NPOINTS_OFFSET);
    memcpy(nv, load64(path + SD_PATH_VERBS_OFFSET), nverbs * 8);
    memcpy(np, load64(path + SD_PATH_POINTS_OFFSET), npoints * 8);
    store64(path + SD_PATH_VERBS_OFFSET, nv);
    store64(path + SD_PATH_POINTS_OFFSET, np);
    store64(path + SD_PATH_CAP_OFFSET, newcap);
    return SADISH_OK;
}

# Append one verb tag, growing the backing store if full. Returns SADISH_OK
# (or SADISH_ERR_OOM only if a grow allocation fails).
fn sd_path_push_verb(path, verb): i64 {
    var n = load64(path + SD_PATH_NVERBS_OFFSET);
    if (n >= load64(path + SD_PATH_CAP_OFFSET)) {
        var g = sd_path_grow(path);
        if (g != SADISH_OK) { return g; }
    }
    store64(load64(path + SD_PATH_VERBS_OFFSET) + n * 8, verb);
    store64(path + SD_PATH_NVERBS_OFFSET, n + 1);
    return SADISH_OK;
}

# Append one SdPoint ptr, growing the backing store if full.
fn sd_path_push_point(path, pt): i64 {
    var n = load64(path + SD_PATH_NPOINTS_OFFSET);
    if (n >= load64(path + SD_PATH_CAP_OFFSET)) {
        var g = sd_path_grow(path);
        if (g != SADISH_OK) { return g; }
    }
    store64(load64(path + SD_PATH_POINTS_OFFSET) + n * 8, pt);
    store64(path + SD_PATH_NPOINTS_OFFSET, n + 1);
    return SADISH_OK;
}

# @public — start a new subpath at (x, y) (16.16). Returns SADISH_OK / err.
fn sd_path_moveto(path, x, y): i64 {
    var r = sd_path_push_verb(path, SD_VERB_MOVETO);
    if (r != SADISH_OK) { return r; }
    return sd_path_push_point(path, sd_point_new(x, y));
}

# @public — straight line to (x, y) from the current point.
fn sd_path_lineto(path, x, y): i64 {
    var r = sd_path_push_verb(path, SD_VERB_LINETO);
    if (r != SADISH_OK) { return r; }
    return sd_path_push_point(path, sd_point_new(x, y));
}

# @public — quadratic Bézier: control (cx, cy), end (x, y).
fn sd_path_quadto(path, cx, cy, x, y): i64 {
    var r = sd_path_push_verb(path, SD_VERB_QUADTO);
    if (r != SADISH_OK) { return r; }
    var r1 = sd_path_push_point(path, sd_point_new(cx, cy));
    if (r1 != SADISH_OK) { return r1; }
    return sd_path_push_point(path, sd_point_new(x, y));
}

# @public — cubic Bézier: controls (c1x,c1y),(c2x,c2y), end (x, y).
fn sd_path_cubicto(path, c1x, c1y, c2x, c2y, x, y): i64 {
    var r = sd_path_push_verb(path, SD_VERB_CUBICTO);
    if (r != SADISH_OK) { return r; }
    var r1 = sd_path_push_point(path, sd_point_new(c1x, c1y));
    if (r1 != SADISH_OK) { return r1; }
    var r2 = sd_path_push_point(path, sd_point_new(c2x, c2y));
    if (r2 != SADISH_OK) { return r2; }
    return sd_path_push_point(path, sd_point_new(x, y));
}

# @public — close the current subpath (back to its moveto). No point.
fn sd_path_close(path): i64 {
    return sd_path_push_verb(path, SD_VERB_CLOSE);
}

# ================================================================
# sd_path_flatten — expand curve verbs into a straight-line polyline
# within `tol` (a 16.16 flatness tolerance) and return an SdPolyline: a
# small header + an array of SdPoint ptrs.
#
# SdPolyline (16 bytes):
#   +0: points   (ptr — array of i64 SdPoint ptrs)
#   +8: count    (i64 — number of points)
# ================================================================
var SD_POLYLINE_POINTS_OFFSET = 0;
var SD_POLYLINE_COUNT_OFFSET  = 8;
var SD_POLYLINE_SIZE          = 16;

# @public
fn sd_polyline_count(pl): i64  { return load64(pl + SD_POLYLINE_COUNT_OFFSET); }
# @public
fn sd_polyline_points(pl): i64 { return load64(pl + SD_POLYLINE_POINTS_OFFSET); }

# ---- flatten internals (adaptive de Casteljau) ------------------
# Output cap + recursion depth cap. A single curve subdivides to at most
# 2^depth segments; the flatten output is bounded at SD_FLATTEN_CAP points
# (excess is dropped — a path that hits this is pathological for v0.3; a
# growable store is the same TODO(v0.4) as the path backing).
var SD_FLATTEN_CAP       = 8192;
var SD_FLATTEN_MAX_DEPTH = 8;

# Emit accumulator ctx: +0 points(ptr)  +8 count  +16 cap.
fn sd_flat_emit(ctx, pt): i64 {
    var count = load64(ctx + 8);
    var cap = load64(ctx + 16);
    if (count >= cap) { return 0; }
    var pts = load64(ctx + 0);
    store64(pts + count * 8, pt);
    store64(ctx + 8, count + 1);
    return 0;
}

# Midpoint of two SdPoints (signed /2 via sd_asr — coords can be negative).
fn sd_pt_mid(a, b): i64 {
    var mx = sd_asr(sd_point_x(a) + sd_point_x(b), 1);
    var my = sd_asr(sd_point_y(a) + sd_point_y(b), 1);
    return sd_point_new(mx, my);
}

# Quadratic flatness: a quad's max deviation from its chord is
# 0.25*|p0 - 2*p1 + p2|, so it is flat when |secondDiff| <= 4*tol. The
# Manhattan magnitude (>= Euclidean) keeps this division/sqrt-free and only
# ever over-tessellates, never under.
fn sd_quad_flat(p0, p1, p2, tol): i64 {
    var dx = sd_point_x(p0) - 2 * sd_point_x(p1) + sd_point_x(p2);
    var dy = sd_point_y(p0) - 2 * sd_point_y(p1) + sd_point_y(p2);
    if (sd_abs(dx) + sd_abs(dy) <= 4 * tol) { return 1; }
    return 0;
}

# Recursively flatten a quad (p0,p1,p2). Emits every point AFTER p0 up to and
# including p2 — p0 is already in the output from the previous segment.
fn sd_flatten_quad(ctx, p0, p1, p2, tol, depth): i64 {
    if (depth <= 0) { return sd_flat_emit(ctx, p2); }
    if (sd_quad_flat(p0, p1, p2, tol) != 0) { return sd_flat_emit(ctx, p2); }
    var p01 = sd_pt_mid(p0, p1);
    var p12 = sd_pt_mid(p1, p2);
    var p012 = sd_pt_mid(p01, p12);
    sd_flatten_quad(ctx, p0, p01, p012, tol, depth - 1);
    sd_flatten_quad(ctx, p012, p12, p2, tol, depth - 1);
    return 0;
}

# Cubic flatness: both second differences (p0-2p1+p2) and (p1-2p2+p3) within
# tolerance (same Manhattan bound as the quad).
fn sd_cubic_flat(p0, p1, p2, p3, tol): i64 {
    var d1x = sd_point_x(p0) - 2 * sd_point_x(p1) + sd_point_x(p2);
    var d1y = sd_point_y(p0) - 2 * sd_point_y(p1) + sd_point_y(p2);
    var d2x = sd_point_x(p1) - 2 * sd_point_x(p2) + sd_point_x(p3);
    var d2y = sd_point_y(p1) - 2 * sd_point_y(p2) + sd_point_y(p3);
    var m1 = sd_abs(d1x) + sd_abs(d1y);
    var m2 = sd_abs(d2x) + sd_abs(d2y);
    var m = m1;
    if (m2 > m) { m = m2; }
    if (m <= 4 * tol) { return 1; }
    return 0;
}

# Recursively flatten a cubic (p0,p1,p2,p3). Emits every point after p0.
fn sd_flatten_cubic(ctx, p0, p1, p2, p3, tol, depth): i64 {
    if (depth <= 0) { return sd_flat_emit(ctx, p3); }
    if (sd_cubic_flat(p0, p1, p2, p3, tol) != 0) { return sd_flat_emit(ctx, p3); }
    var p01 = sd_pt_mid(p0, p1);
    var p12 = sd_pt_mid(p1, p2);
    var p23 = sd_pt_mid(p2, p3);
    var p012 = sd_pt_mid(p01, p12);
    var p123 = sd_pt_mid(p12, p23);
    var p0123 = sd_pt_mid(p012, p123);
    sd_flatten_cubic(ctx, p0, p01, p012, p0123, tol, depth - 1);
    sd_flatten_cubic(ctx, p0123, p123, p23, p3, tol, depth - 1);
    return 0;
}

# @public — flatten `path` into a straight-line polyline within `tol` (a
# 16.16 flatness tolerance), returning an SdPolyline. Straight verbs pass
# through as anchors; quad/cubic verbs are adaptively subdivided (de
# Casteljau) until each segment's deviation from its chord is <= tol.
# Returns 0 on an empty path (the caller reports EMPTY_PATH).
fn sd_path_flatten(path, tol): i64 {
    var n_verbs = load64(path + SD_PATH_NVERBS_OFFSET);
    if (n_verbs == 0) { return 0; }

    var verbs = load64(path + SD_PATH_VERBS_OFFSET);
    var points = load64(path + SD_PATH_POINTS_OFFSET);

    var out = sd_alloc(SD_FLATTEN_CAP * 8);
    var ctx = sd_alloc(24);
    store64(ctx + 0, out);
    store64(ctx + 8, 0);
    store64(ctx + 16, SD_FLATTEN_CAP);

    # A non-positive tol would never satisfy the flatness test — recurse to
    # the depth cap every time; clamp to >= 1 (1/65536 px).
    var t = tol;
    if (t < 1) { t = 1; }

    var cur = 0;
    var vi = 0;
    var pi = 0;
    while (vi < n_verbs) {
        var verb = load64(verbs + vi * 8);
        if (verb == SD_VERB_MOVETO) {
            cur = load64(points + pi * 8);
            sd_flat_emit(ctx, cur);
            pi = pi + 1;
        }
        if (verb == SD_VERB_LINETO) {
            cur = load64(points + pi * 8);
            sd_flat_emit(ctx, cur);
            pi = pi + 1;
        }
        if (verb == SD_VERB_QUADTO) {
            var qc = load64(points + pi * 8);
            var qe = load64(points + (pi + 1) * 8);
            sd_flatten_quad(ctx, cur, qc, qe, t, SD_FLATTEN_MAX_DEPTH);
            cur = qe;
            pi = pi + 2;
        }
        if (verb == SD_VERB_CUBICTO) {
            var k1 = load64(points + pi * 8);
            var k2 = load64(points + (pi + 1) * 8);
            var ke = load64(points + (pi + 2) * 8);
            sd_flatten_cubic(ctx, cur, k1, k2, ke, t, SD_FLATTEN_MAX_DEPTH);
            cur = ke;
            pi = pi + 3;
        }
        # SD_VERB_CLOSE consumes no point; the rasterizer closes the subpath
        # back to its moveto anchor.
        vi = vi + 1;
    }

    var count = load64(ctx + 8);
    var pl = sd_alloc(SD_POLYLINE_SIZE);
    store64(pl + SD_POLYLINE_POINTS_OFFSET, out);
    store64(pl + SD_POLYLINE_COUNT_OFFSET, count);
    return pl;
}

# --- coverage.cyr ---

# coverage.cyr — the SD_AA_AREA coverage engine: exact 2-axis signed-area cell accumulation.
#
# The font-rs / stb_truetype v2 / FreeType "smooth" family. sd_fill_impl (raster.cyr) builds the
# closed edge list exactly as it always has, then — ONLY on a canvas switched to SD_AA_AREA with
# sd_canvas_set_aa — hands that list here instead of to the 4-sub-scanline loop.
#
# ⛔⛔ OPT-IN, AND IT STAYS OPT-IN. The default engine (SD_AA_SUBSCANLINE) is analytic in x but
# SAMPLES y at 4 sub-scanlines, so a near-horizontal edge quantizes to 1/4 steps (an edge at
# y = 4.3 reads 63, not 76). agnos's GPU rasteriser (tests/gpu/refagree.cyr) uses sadish's
# DEFAULT fill as a byte-identical oracle, so that engine is never replaced — this one sits beside
# it and nothing reaches it unless a caller asks.
#
# THE ALGORITHM. One accumulator row acc[0..w] (w+1 i64 slots). For every edge overlapping pixel
# row py, clip the edge to the row, split it at pixel-column boundaries, and for each piece of
# height pdy lying in column c at mean fractional x fx:
#     a = pdy * fx                     (the part of the piece's cover NOT inside pixel c)
#     acc[c]   += sgn * (pdy - a)
#     acc[c+1] += sgn * a
# A running sum along the row then yields, per pixel, the signed integral of the winding number
# over that pixel's area, in 16.16 (ONE = fully covered).
#
# ⛔ THE STREAK INVARIANT. Every piece deposits exactly `pdy` into the row (pdy - a + a), and the
# pieces of an edge telescope: each piece's pdy is the DIFFERENCE of two y offsets computed from the
# row-clipped segment's exact endpoints (never a sum of rounded steps), so they add to exactly
# ye - ys. Across rows the same holds — row clipping is at exact integer row boundaries. ⇒ Right of
# a closed contour the running sum is EXACTLY 0 in integer arithmetic; one leaked unit would paint a
# streak to the canvas's right edge. Portions LEFT of x = 0 deposit their whole pdy into column 0
# (their cover still reaches every visible pixel); portions right of x = w deposit nothing, since
# no visible prefix sum reads past column w-1.
#
# RULES, from s = |running sum|:
#   NONZERO   -> min(s, ONE)
#   EVEN_ODD  -> s mod 2*ONE folded into a triangle wave (FreeType's approach)
# Both fold the INTEGRAL of the winding over the pixel, not the area of the region, so both are
# EXACT when the winding inside the pixel takes only the values {0, +1} or only {0, -1} — a simple
# contour, or disjoint ones. Anywhere else it is the standard cell-coverage approximation (FreeType's
# too): opposite windings inside one pixel cancel — and ONE self-intersecting contour can do that,
# a pixel-sized bow-tie reads 0 — and overlapping same-way contours over part of a pixel count twice
# (two coincident edges at x = 4.3 read 152 nonzero, not 76).
#
# ⚠ PRECISION. Coordinates are 16.16 and must satisfy |x|, |y| <= 2^30 raw (±16,384 px) — the same
# bound the default engine's (bx-ax)*(sy-ay) product already carries. Under it every intermediate
# fits an i64: x at a row boundary (dx * dy_part) < 2^62; a column crossing's y offset
# (pdy_row <= 2^16) * (x - x0 < 2^31) < 2^47; the split (pdy <= 2^16) * (fx_sum <= 2^17) <= 2^33;
# the running sum <= SD_FLATTEN_CAP * ONE = 2^29. All divisions and shifts in the accumulation act
# on non-negative values (the sign is applied after the split), so truncation is the same for a
# contour and its mirror: CW and CCW input give byte-identical coverage.
# ⚠ Truncation is under a raw unit per step per piece (x at a row boundary, y at a column crossing,
# the split), so a pixel's error grows with the pieces IN it — not along the row, where the pieces
# telescope. MEASURED, even-odd, coincident triangles inside one pixel vs the exact fold: 810 of
# them (2,430 edges) exact to the byte, 2,430 (7,290 edges) 2 bytes off.
#
# ⚠ SINGLE-THREADED, like the rest of the fill: the accumulator is one process-wide block.

# ---- process-lifetime scratch (lazily, on the FIRST AREA fill) -------------------------------
# ⛔ FROM THE GLOBAL `alloc`, NEVER `sd_alloc` — the same rule, for the same reason, as raster.cyr's
# _sd_scratch_init: a consumer hook is typically an arena that gets reset, and a scratch drawn from
# it dangles on the next frame. ⚠ And NOT in _sd_scratch_init: a process that never asks for AREA
# pays nothing for it, and the default fill's first-call figures (590,152 B at 32 px, asserted in
# programs/alloc_test.cyr) stay exact.
# The edge list needs no scratch of its own: it is sorted IN PLACE in _sd_fill_edges, which is
# per-call working storage nothing reads after sd_fill_impl returns.
var _sd_area_acc = 0;          # (w + 1) * 8 — one row of signed 16.16 cell accumulators
var _sd_area_acc_cap = 0;      # slots the current block holds

# The accumulator for a canvas `w` pixels wide: w + 1 slots (a piece in the last column deposits
# its `a` into slot w, which nothing reads). Re-allocates from the GLOBAL alloc only when a wider
# canvas than ever seen arrives; ⚠ the old block is abandoned (no free()), exactly like
# _sd_fill_accrow_for. MEASURED (programs/area_test.cyr): the first AREA fill costs the global heap
# exactly (w+1)*8 — 264 B at 32 px, a regrow to 64 px 520 B — and the arena 0; every fill after, 0.
# Returns 0 if the allocation fails.
fn _sd_area_acc_for(w): i64 {
    if (w + 1 <= _sd_area_acc_cap) { return _sd_area_acc; }
    var blk = alloc((w + 1) * 8);
    if (blk == 0) { return 0; }
    _sd_area_acc = blk;
    _sd_area_acc_cap = w + 1;
    return blk;
}

# min / max y of an edge record (4 i64: ax, ay, bx, by).
fn _sd_area_ymin(e): i64 {
    var ay = load64(e + 8);
    var by = load64(e + 24);
    if (by < ay) { return by; }
    return ay;
}

fn _sd_area_ymax(e): i64 {
    var ay = load64(e + 8);
    var by = load64(e + 24);
    if (by > ay) { return by; }
    return ay;
}

# Swap two 32-byte edge records.
fn _sd_area_swap(ea, eb): i64 {
    var k = 0;
    while (k < 32) {
        var t = load64(ea + k);
        store64(ea + k, load64(eb + k));
        store64(eb + k, t);
        k = k + 8;
    }
    return 0;
}

# Sort the edge records by ymin, in place (Shell sort, Knuth 3h+1 gaps: no scratch, and no O(n^2)
# on the 8,192-edge worst case a long flattened path can produce).
fn _sd_area_sort(edges, n): i64 {
    var gap = 1;
    while (gap < n / 3) { gap = gap * 3 + 1; }
    while (gap >= 1) {
        var i = gap;
        while (i < n) {
            var src = edges + i * 32;
            var t0 = load64(src + 0);
            var t1 = load64(src + 8);
            var t2 = load64(src + 16);
            var t3 = load64(src + 24);
            var key = t1;
            if (t3 < key) { key = t3; }
            var j = i;
            var stop = 0;
            while (stop == 0) {
                if (j < gap) {
                    stop = 1;
                } else {
                    var prev = edges + (j - gap) * 32;
                    if (_sd_area_ymin(prev) > key) {
                        var dst = edges + j * 32;
                        store64(dst + 0, load64(prev + 0));
                        store64(dst + 8, load64(prev + 8));
                        store64(dst + 16, load64(prev + 16));
                        store64(dst + 24, load64(prev + 24));
                        j = j - gap;
                    } else {
                        stop = 1;
                    }
                }
            }
            var at = edges + j * 32;
            store64(at + 0, t0);
            store64(at + 8, t1);
            store64(at + 16, t2);
            store64(at + 24, t3);
            i = i + 1;
        }
        gap = gap / 3;
    }
    return 0;
}

# Deposit one row-clipped segment into the accumulator. `xa`, `xb` are its x at the two row-clipped
# ends (either order — cover is spread linearly in x, so direction does not matter), `dy` > 0 its
# height inside the row, `sgn` +1 / -1 its winding direction.
fn _sd_area_cells(acc, w, xa, xb, dy, sgn): i64 {
    var wmax = w << SD_SHIFT;
    if (xa == xb) {
        # vertical piece: one column, fx is its x fraction
        if (xa >= wmax) { return 0; }
        if (xa <= 0) {
            store64(acc, load64(acc) + sgn * dy);
            return 0;
        }
        var vc = xa >> SD_SHIFT;
        var va = (dy * (xa - (vc << SD_SHIFT))) >> SD_SHIFT;
        store64(acc + vc * 8, load64(acc + vc * 8) + sgn * (dy - va));
        store64(acc + (vc + 1) * 8, load64(acc + (vc + 1) * 8) + sgn * va);
        return 0;
    }
    var x0 = xa;
    var x1 = xb;
    if (x0 > x1) { x0 = xb; x1 = xa; }
    if (x0 >= wmax) { return 0; }                     # wholly right of the canvas
    if (x1 <= 0) {                                    # wholly left: full cover into column 0
        store64(acc, load64(acc) + sgn * dy);
        return 0;
    }
    var span = x1 - x0;
    # the visible x range [lo, hi); lo < hi here because x0 < wmax and x1 > 0
    var lo = x0;
    if (lo < 0) { lo = 0; }
    var hi = x1;
    if (hi > wmax) { hi = wmax; }
    # y offset (from the x0 end) at x = lo; the part left of x = 0 lands whole in column 0
    var py = 0;
    if (lo > x0) {
        py = (dy * (lo - x0)) / span;
        store64(acc, load64(acc) + sgn * py);
    }
    var px = lo;
    var c = lo >> SD_SHIFT;
    while (px < hi) {
        var cl = c << SD_SHIFT;
        var nx = cl + SD_ONE;
        if (nx > hi) { nx = hi; }
        var ny = dy;
        if (nx < x1) { ny = (dy * (nx - x0)) / span; }
        var pdy = ny - py;
        var a = (pdy * ((px - cl) + (nx - cl))) >> 17;    # pdy * mean(fx), fx sum has 17 bits
        store64(acc + c * 8, load64(acc + c * 8) + sgn * (pdy - a));
        store64(acc + (c + 1) * 8, load64(acc + (c + 1) * 8) + sgn * a);
        px = nx;
        py = ny;
        c = c + 1;
    }
    return 0;
}

# Deposit the part of edge record `e` that lies in the pixel row starting at `rt` (16.16).
fn _sd_area_edge_row(acc, w, e, rt): i64 {
    var xa = load64(e + 0);
    var ya = load64(e + 8);
    var xb = load64(e + 16);
    var yb = load64(e + 24);
    var sgn = 1;
    if (ya > yb) {
        # orient top -> bottom; the x at a row boundary is then computed from the same
        # endpoints in the same order for both windings (mirror-exact)
        xa = load64(e + 16);
        ya = load64(e + 24);
        xb = load64(e + 0);
        yb = load64(e + 8);
        sgn = 0 - 1;
    }
    var ys = ya;
    if (ys < rt) { ys = rt; }
    var ye = yb;
    if (ye > rt + SD_ONE) { ye = rt + SD_ONE; }
    if (ye <= ys) { return 0; }
    var xs = xa + ((xb - xa) * (ys - ya)) / (yb - ya);
    var xe = xa + ((xb - xa) * (ye - ya)) / (yb - ya);
    return _sd_area_cells(acc, w, xs, xe, ye - ys, sgn);
}

# ================================================================
# _sd_area_fill — the SD_AA_AREA engine behind sd_fill_impl. `edges`/`n_edges` is the closed edge
# list sd_fill_impl built (REORDERED here); `cov`/`stride` the canvas's coverage buffer; `mask` the
# active clip mask (0 = unclipped); `nonzero` 1 for SD_FILL_NONZERO, 0 for even-odd; `combine`
# 0 = overwrite, 1 = MAX into the existing coverage. The byte mapping, clip multiply and union MAX
# are the default engine's, verbatim.
# ⛔ The list must be WHOLE — every contour closed — or the running sum never returns to 0 and the
# row streaks to the right edge. sd_fill_impl guarantees it by calling here only with n_edges <
# SD_FLATTEN_CAP (sd_edge_add drops edges silently once the list is full).
#
# Rows are swept top to bottom over an ACTIVE WINDOW [lo, nxt) of the ymin-sorted edge list:
# edges whose ymin is above the row's bottom join at nxt; an edge that ends at or before the
# row's bottom is swapped down to lo after that row. O(rows * active + sort), against the default
# engine's O(rows * 4 * n_edges) plus an insertion sort of crossings per sub-scanline. MEASURED,
# 256x256, including flattening: a two-contour quad/cubic blob 0.52 ms per fill (SUBSCANLINE
# 2.77 ms); a 400-edge self-intersecting polygon 2.4 ms (37.9 ms); 8,000 edges 42 ms (11.7 s).
# Returns SADISH_OK, or SADISH_ERR_OOM if the one-time accumulator allocation fails.
# ================================================================
fn _sd_area_fill(edges, n_edges, w, h, cov, stride, mask, nonzero, combine): i64 {
    var acc = _sd_area_acc_for(w);
    if (acc == 0) { return SADISH_ERR_OOM; }
    # Slots [0, w) start at 0: a fresh block is not guaranteed zeroed, and a NARROWER previous
    # fill leaves its sink slot (its own index w) holding a residue this canvas would read. Slot w
    # itself is a write-only sink — no running sum reads past column w-1 — so it is never cleared.
    var zi = 0;
    while (zi < w) {
        store64(acc + zi * 8, 0);
        zi = zi + 1;
    }
    _sd_area_sort(edges, n_edges);

    var two = SD_ONE * 2;
    var lo = 0;
    var nxt = 0;
    var py = 0;
    while (py < h) {
        var rt = py << SD_SHIFT;
        var rb = rt + SD_ONE;
        var joining = 1;
        while (joining != 0) {
            if (nxt >= n_edges) {
                joining = 0;
            } else {
                if (_sd_area_ymin(edges + nxt * 32) < rb) {
                    nxt = nxt + 1;
                } else {
                    joining = 0;
                }
            }
        }
        var i = lo;
        while (i < nxt) {
            var e = edges + i * 32;
            _sd_area_edge_row(acc, w, e, rt);
            if (_sd_area_ymax(e) <= rb) {
                # done after this row: retire it below the window (the record swapped up into
                # slot i came from lo, which this row has already processed)
                _sd_area_swap(e, edges + lo * 32);
                lo = lo + 1;
            }
            i = i + 1;
        }

        # accumulator row -> coverage bytes (running sum; each slot is zeroed as it is consumed)
        var run = 0;
        var px = 0;
        while (px < w) {
            run = run + load64(acc + px * 8);
            store64(acc + px * 8, 0);
            var s = run;
            if (s < 0) { s = 0 - s; }
            if (nonzero != 0) {
                if (s > SD_ONE) { s = SD_ONE; }
            } else {
                s = s % two;
                if (s > SD_ONE) { s = two - s; }
            }
            # s <= ONE, so c <= 255: the default engine's clamp cannot fire here
            var c = (s * 255) >> SD_SHIFT;
            if (mask != 0) {
                c = (c * load8(mask + py * stride + px)) / 255;
            }
            if (combine != 0) {
                var oldc = load8(cov + py * stride + px);
                if (c < oldc) { c = oldc; }
            }
            store8(cov + py * stride + px, c);
            px = px + 1;
        }
        py = py + 1;
    }
    return SADISH_OK;
}

# --- raster.cyr ---

# @public — sadish rasterizer: path -> coverage buffer -> blit.
#
# raster.cyr — an SdCanvas owns a width*height coverage buffer (one byte
# of anti-aliased coverage per pixel, 0..255). The fill entry takes a
# flattened path and a winding rule and accumulates coverage; the blit
# entry hands that coverage to a destination framebuffer (the kernel
# blit#39 on AGNOS, or a host framebuffer under test).
#
# The coverage buffer is a separate, format-neutral stage on purpose: a
# consumer (canvas/compositing/SVG/UI) chooses how to turn coverage +
# a paint (solid color / gradient) into destination pixels. sadish's job
# ends at coverage + a reference solid blit.

# ---- winding rules ----------------------------------------------
var SD_FILL_EVEN_ODD = 0;
var SD_FILL_NONZERO  = 1;

# ---- coverage engines -------------------------------------------
# SD_AA_SUBSCANLINE — the 0.4.0 engine: analytic in x, 4 sub-scanlines in y. THE DEFAULT, and
#   byte-identical forever: agnos's GPU rasteriser (tests/gpu/refagree.cyr) is gated on it.
# SD_AA_AREA — exact in both axes (signed-area cell accumulation, src/coverage.cyr). Opt-in per
#   canvas with sd_canvas_set_aa.
var SD_AA_SUBSCANLINE = 0;
var SD_AA_AREA        = 1;

# ================================================================
# SdCanvas (48 bytes):
#   +0:  width      (i64 — pixels)
#   +8:  height     (i64 — pixels)
#   +16: coverage   (ptr — owned width*height bytes, one coverage per px)
#   +24: stride     (i64 — bytes per row; == width for the packed buffer)
#   +32: clip       (ptr — top SdClip node, or 0 = unclipped)
#   +40: aa         (i64 — coverage engine, SD_AA_SUBSCANLINE | SD_AA_AREA)
# ⚠ The canvas was 40 bytes through 0.5.5. Nothing in dhancha, rekha or agnos builds one by hand
# (checked by grep) — sd_canvas_new is the only constructor. But every canvas — and the temp mask
# canvas behind each sd_canvas_clip_push_path — now costs 8 B more on sd_alloc, which moves exact
# figures consumers have MEASURED (dhancha's text_arena_test, same checks passing: a 12-label frame
# 417,056 -> 417,144 B, its 64 KiB-arena spill 351,520 -> 351,608 B).
# ================================================================
var SD_CANVAS_WIDTH_OFFSET    = 0;
var SD_CANVAS_HEIGHT_OFFSET   = 8;
var SD_CANVAS_COVERAGE_OFFSET = 16;
var SD_CANVAS_STRIDE_OFFSET   = 24;
var SD_CANVAS_CLIP_OFFSET     = 32;
var SD_CANVAS_AA_OFFSET       = 40;
var SD_CANVAS_SIZE            = 48;

# @public — allocate a w*h canvas with a zeroed coverage buffer.
# Returns the SdCanvas ptr, or 0 on OOM / bad dimensions.
fn sd_canvas_new(w, h): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    var cv = sd_alloc(SD_CANVAS_SIZE);
    if (cv == 0) { return 0; }
    var n = w * h;
    var cov = sd_alloc(n);
    if (cov == 0) { return 0; }
    # Zero the coverage buffer (alloc is not guaranteed zeroed).
    var i = 0;
    while (i < n) {
        store8(cov + i, 0);
        i = i + 1;
    }
    store64(cv + SD_CANVAS_WIDTH_OFFSET, w);
    store64(cv + SD_CANVAS_HEIGHT_OFFSET, h);
    store64(cv + SD_CANVAS_COVERAGE_OFFSET, cov);
    store64(cv + SD_CANVAS_STRIDE_OFFSET, w);
    store64(cv + SD_CANVAS_CLIP_OFFSET, 0);
    store64(cv + SD_CANVAS_AA_OFFSET, SD_AA_SUBSCANLINE);
    return cv;
}

# ---- accessors --------------------------------------------------
# @public
fn sd_canvas_width(cv): i64    { return load64(cv + SD_CANVAS_WIDTH_OFFSET); }
# @public
fn sd_canvas_height(cv): i64   { return load64(cv + SD_CANVAS_HEIGHT_OFFSET); }
# @public
fn sd_canvas_coverage(cv): i64 { return load64(cv + SD_CANVAS_COVERAGE_OFFSET); }
# @public
fn sd_canvas_stride(cv): i64   { return load64(cv + SD_CANVAS_STRIDE_OFFSET); }
# @public — the canvas's coverage engine (SD_AA_SUBSCANLINE unless sd_canvas_set_aa changed it).
fn sd_canvas_aa(cv): i64       { return load64(cv + SD_CANVAS_AA_OFFSET); }

# @public — choose the coverage engine every fill into `cv` uses: sd_canvas_fill_path,
# sd_canvas_fill_union (and so sd_canvas_stroke_path), and the mask sd_canvas_clip_push_path
# builds. SD_AA_SUBSCANLINE (the default) or SD_AA_AREA. Coverage already in the buffer is not
# touched. Returns SADISH_OK, or SADISH_ERR_BOUNDS for a null canvas or an unknown mode (the
# canvas is left unchanged).
fn sd_canvas_set_aa(cv, mode): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (mode != SD_AA_SUBSCANLINE) {
        if (mode != SD_AA_AREA) { return SADISH_ERR_BOUNDS; }
    }
    store64(cv + SD_CANVAS_AA_OFFSET, mode);
    return SADISH_OK;
}

# Coverage of one pixel (0 if out of bounds).
fn sd_canvas_coverage_at(cv, x, y): i64 {
    var w = load64(cv + SD_CANVAS_WIDTH_OFFSET);
    var h = load64(cv + SD_CANVAS_HEIGHT_OFFSET);
    if (x < 0) { return 0; }
    if (y < 0) { return 0; }
    if (x >= w) { return 0; }
    if (y >= h) { return 0; }
    var cov = load64(cv + SD_CANVAS_COVERAGE_OFFSET);
    var stride = load64(cv + SD_CANVAS_STRIDE_OFFSET);
    return load8(cov + y * stride + x);
}

# @public — zero the coverage buffer (reuse a canvas across draws).
fn sd_canvas_clear(cv): i64 {
    var w = load64(cv + SD_CANVAS_WIDTH_OFFSET);
    var h = load64(cv + SD_CANVAS_HEIGHT_OFFSET);
    var cov = load64(cv + SD_CANVAS_COVERAGE_OFFSET);
    var n = w * h;
    var i = 0;
    while (i < n) {
        store8(cov + i, 0);
        i = i + 1;
    }
    return SADISH_OK;
}

# ---- process-lifetime fill/stroke scratch (0.5.5) ---------------
# ⭐ Before 0.5.5 every sd_fill_impl call allocated ectx + edges + fbuf + fctx + accrow + cross
# FRESH, and every sd_canvas_stroke_path call its run + fbuf + fctx — on a bump allocator with no
# free(). MEASURED on 0.5.4, 8x8 canvas, one call: fill 327,824 B, stroke of a closed 4-vertex
# rect 2,789,016 B (8 fill_union passes underneath it), per call, forever. dhancha filed it
# (2026-09-13, scalable text allocates per call outside the frame arena); crab's zero-heap
# frame gate is what it blocks. The capacity is FIXED (SD_FLATTEN_CAP) and does not depend on
# the path, so it is one process-wide set, allocated lazily ONCE and reused by every call.
#
# ⛔ FROM THE GLOBAL `alloc`, NEVER `sd_alloc`. A consumer's hook is typically a per-frame arena
# that gets reset; a scratch drawn from it would be dangling on the second frame. The scratch
# outlives every hook by construction, so it must come from the one allocator that never rewinds.
# ⇒ This is also why fill/stroke are NOT on the seam's "everything" promise (see src/alloc.cyr):
# their one-time cost lands on the global heap at the first call, and never again.
#
# ⛔ TWO SETS, NOT ONE. sd_canvas_stroke_path holds `run` LIVE across the sd_canvas_fill_union
# calls sd_stroke_run makes, and each of those runs sd_fill_impl, which fills its own fbuf/fctx.
# Sharing a fbuf between the two would have the fill's flatten overwrite the stroke's run
# mid-stroke. The stroker's run/fbuf/fctx are therefore its own globals, and non-aliasing is
# visible in the names rather than reasoned about per call.
#
# ⚠ SINGLE-THREADED ENTRY POINTS, said out loud. The rasterizer never had a lock anywhere and was
# never thread-safe; a shared scratch makes sd_fill_impl / sd_canvas_stroke_path explicitly
# single-threaded. Checked: every consumer in the ecosystem (dhancha, rekha, agnos's refagree
# test) rasterizes from one thread.
#
# Flatten MID-POINTS (sd_pt_mid -> sd_point_new) are deliberately NOT here: they are
# proportional to the curve work, not fixed-capacity, so they stay on the seam and the hook
# decides where they live (MEASURED, 8x8 canvas, warm scratch: the CHANGELOG's one-quad fill —
# moveto (0,0), quadto ctrl (8,0) → (8,8), lineto back, closed — costs 144 B of them = 9
# mid-points x 16 B, 3 subdivisions, and the same 144 B on the next identical call; a single quad
# only ever costs 48 x (2^d - 1) B because both de Casteljau halves carry the parent's second
# difference / 4 and so split to the same depth).
var _sd_fill_ectx = 0;         # edge builder ctx (24 B): +0 edges  +8 count  +16 cap
var _sd_fill_edges = 0;        # SD_FLATTEN_CAP * 32
var _sd_fill_fbuf = 0;         # SD_FLATTEN_CAP * 8 — flatten output for one curve verb
var _sd_fill_fctx = 0;         # flatten ctx (24 B)
var _sd_fill_cross = 0;        # SD_FLATTEN_CAP * 16 — (x, dir) crossings; n_edges <= cap
var _sd_fill_accrow = 0;       # w * 8 — per-row 16.16 accumulator, sized to the widest canvas seen
var _sd_fill_accrow_cap = 0;   # pixels the current accrow block can hold
var _sd_stroke_run = 0;        # SD_FLATTEN_CAP * 8 — the stroker's polyline run
var _sd_stroke_fbuf = 0;       # SD_FLATTEN_CAP * 8 — the stroker's OWN flatten output
var _sd_stroke_fctx = 0;       # the stroker's OWN flatten ctx (24 B)
# ⚠ The SD_AA_AREA engine's accumulator (_sd_area_acc, (w+1)*8) is the same kind of scratch but
# lives with its engine in src/coverage.cyr, allocated on the first AREA fill — NOT here, so a
# process that never opts in pays nothing and the first-fill figures below stay exact.

# Allocate the fixed-capacity scratch once (idempotent). Called at the top of sd_fill_impl and
# sd_canvas_stroke_path; a second call is one load + compare. MEASURED one-time cost: 589,896 B
# (fill 458,800 + stroke 131,096), plus accrow on first use (w*8: 64 B at 8 px, 6,080 B at 760).
# ⇒ After it, a straight-line fill costs the heap 0 B (MEASURED, 8x8 and 760x300); a stroke of the
# closed 8x8 rect 34,432 B, all of it paths + points on the seam (was 2,789,016 B).
fn _sd_scratch_init(): i64 {
    if (_sd_fill_ectx != 0) { return 0; }
    _sd_fill_ectx = alloc(24);
    _sd_fill_edges = alloc(SD_FLATTEN_CAP * 32);
    _sd_fill_fbuf = alloc(SD_FLATTEN_CAP * 8);
    _sd_fill_fctx = alloc(24);
    _sd_fill_cross = alloc(SD_FLATTEN_CAP * 16);
    _sd_stroke_run = alloc(SD_FLATTEN_CAP * 8);
    _sd_stroke_fbuf = alloc(SD_FLATTEN_CAP * 8);
    _sd_stroke_fctx = alloc(24);
    return 0;
}

# The per-row accumulator for a canvas `w` pixels wide. Its size is the only part of the scratch
# that depends on the call, so it keeps a capacity and re-allocates from the GLOBAL alloc only
# when a wider canvas than ever seen arrives. ⚠ The old block is abandoned (no free()) — a
# monotone series of ever-wider canvases pays sum(w*8) once; a consumer at a fixed size pays once.
fn _sd_fill_accrow_for(w): i64 {
    if (w <= _sd_fill_accrow_cap) { return _sd_fill_accrow; }
    _sd_fill_accrow = alloc(w * 8);
    _sd_fill_accrow_cap = w;
    return _sd_fill_accrow;
}

# ---- fill internals --------------------------------------------
# Vertical sub-scanlines per pixel row. Coverage is ANALYTIC in x (exact
# horizontal span overlap per sub-scanline) and sampled in y at SD_FILL_SS
# sub-scanlines — smoother AND far cheaper than the old SS*SS point sampling
# (edge crossings are computed per row, not per pixel). This is the SD_AA_SUBSCANLINE engine and
# stays the default; full 2-axis signed-area accumulation is SD_AA_AREA (src/coverage.cyr).
var SD_FILL_SS = 4;

# Edge builder ctx: +0 edges(ptr, 4 i64/edge: ax,ay,bx,by)  +8 count  +16 cap.
# Horizontal edges (ay == by) contribute no crossings and are dropped.
fn sd_edge_add(ectx, ax, ay, bx, by): i64 {
    if (ay == by) { return 0; }
    var count = load64(ectx + 8);
    var cap = load64(ectx + 16);
    if (count >= cap) { return 0; }
    var e = load64(ectx + 0) + count * 32;
    store64(e + 0, ax);
    store64(e + 8, ay);
    store64(e + 16, bx);
    store64(e + 24, by);
    store64(ectx + 8, count + 1);
    return 0;
}

# Connect `cur` through the points a flatten ctx just emitted, as edges;
# returns the last point (the new current point).
fn sd_fill_edges_from(ectx, fctx, cur): i64 {
    var pts = load64(fctx + 0);
    var n = load64(fctx + 8);
    var prev = cur;
    var i = 0;
    while (i < n) {
        var p = load64(pts + i * 8);
        sd_edge_add(ectx, sd_point_x(prev), sd_point_y(prev), sd_point_x(p), sd_point_y(p));
        prev = p;
        i = i + 1;
    }
    return prev;
}

# Cast a +x ray from (sx, sy) and accumulate edge crossings to its right.
# `signed` = 1 -> signed winding number (nonzero rule); 0 -> crossing count
# (even-odd rule). Half-open [ylo, yhi) span test avoids double-counting a
# vertex shared by two edges.
fn sd_ray_cross(edges, n_edges, sx, sy, signed): i64 {
    var acc = 0;
    var ei = 0;
    while (ei < n_edges) {
        var e = edges + ei * 32;
        var ax = load64(e + 0);
        var ay = load64(e + 8);
        var bx = load64(e + 16);
        var by = load64(e + 24);
        var ylo = ay;
        var yhi = by;
        if (ay > by) { ylo = by; yhi = ay; }
        if (sy >= ylo) {
            if (sy < yhi) {
                var x = ax + ((bx - ax) * (sy - ay)) / (by - ay);
                if (x > sx) {
                    if (signed != 0) {
                        if (by > ay) { acc = acc + 1; } else { acc = acc - 1; }
                    } else {
                        acc = acc + 1;
                    }
                }
            }
        }
        ei = ei + 1;
    }
    return acc;
}

# Add analytic horizontal coverage for a covered span [xs, xe] (16.16 pixel-x)
# to the per-row accumulator `accrow`, weighted by `weight` (coverage per full
# pixel for one sub-scanline). Each touched pixel gets weight * overlap-width.
fn sd_span_add(accrow, w, xs, xe, weight): i64 {
    if (xe <= xs) { return 0; }
    var lo = xs;
    if (lo < 0) { lo = 0; }
    var wmax = w << SD_SHIFT;
    var hi = xe;
    if (hi > wmax) { hi = wmax; }
    if (hi <= lo) { return 0; }
    var px = lo >> SD_SHIFT;
    var stop = 0;
    while (stop == 0) {
        if (px >= w) {
            stop = 1;
        } else {
            var pl = px << SD_SHIFT;
            if (pl >= hi) {
                stop = 1;
            } else {
                var pr = (px + 1) << SD_SHIFT;
                var a = lo;
                if (a < pl) { a = pl; }
                var b = hi;
                if (b > pr) { b = pr; }
                if (b > a) {
                    var add = sd_fixed_mul(weight, b - a);
                    store64(accrow + px * 8, load64(accrow + px * 8) + add);
                }
                px = px + 1;
            }
        }
    }
    return 0;
}

# ================================================================
# sd_canvas_fill_path — rasterize `path` into the canvas coverage buffer
# under winding rule `rule` (SD_FILL_EVEN_ODD | SD_FILL_NONZERO), writing
# 0..255 anti-aliased coverage per pixel (overwrites the buffer).
#
# Pipeline: flatten curve verbs (de Casteljau) into a CLOSED edge list —
# each subpath is closed back to its moveto — then, per pixel, sample an
# SS*SS grid and cast a +x winding ray per sub-sample; coverage is the
# fraction of sub-samples inside.
# ================================================================
# @public — fill `path`'s AA coverage into `cv`, OVERWRITING the buffer.
fn sd_canvas_fill_path(cv, path, rule): i64 {
    return sd_fill_impl(cv, path, rule, 0);
}

# @public — fill `path`'s AA coverage, MAX-combined into the existing coverage
# (a union of shapes — orientation-independent for convex pieces; used by the
# stroker to accumulate overlapping segment rects + join discs).
fn sd_canvas_fill_union(cv, path, rule): i64 {
    return sd_fill_impl(cv, path, rule, 1);
}

# combine: 0 = overwrite the coverage buffer, 1 = max into it (union).
fn sd_fill_impl(cv, path, rule, combine): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (path == 0) { return SADISH_ERR_EMPTY_PATH; }
    var n_verbs = sd_path_verb_count(path);
    if (n_verbs == 0) { return SADISH_ERR_EMPTY_PATH; }

    var w = sd_canvas_width(cv);
    var h = sd_canvas_height(cv);
    var cov = sd_canvas_coverage(cv);
    var stride = sd_canvas_stride(cv);
    var tol = SD_ONE >> 2;

    # ---- build the closed-edge list (into the process-lifetime scratch) ----
    _sd_scratch_init();
    var ecap = SD_FLATTEN_CAP;
    var ectx = _sd_fill_ectx;
    store64(ectx + 0, _sd_fill_edges);
    store64(ectx + 8, 0);               # per-call reset: the edge count
    store64(ectx + 16, ecap);
    var fbuf = _sd_fill_fbuf;
    var fctx = _sd_fill_fctx;           # fields are (re)set before every flatten below

    var verbs = load64(path + SD_PATH_VERBS_OFFSET);
    var points = load64(path + SD_PATH_POINTS_OFFSET);
    var cur = 0;
    var sub_start = 0;
    var sub_open = 0;
    var vi = 0;
    var pi = 0;
    while (vi < n_verbs) {
        var verb = load64(verbs + vi * 8);
        if (verb == SD_VERB_MOVETO) {
            if (sub_open != 0) {
                sd_edge_add(ectx, sd_point_x(cur), sd_point_y(cur), sd_point_x(sub_start), sd_point_y(sub_start));
            }
            cur = load64(points + pi * 8);
            sub_start = cur;
            sub_open = 0;
            pi = pi + 1;
        }
        if (verb == SD_VERB_LINETO) {
            var lp = load64(points + pi * 8);
            sd_edge_add(ectx, sd_point_x(cur), sd_point_y(cur), sd_point_x(lp), sd_point_y(lp));
            cur = lp;
            sub_open = 1;
            pi = pi + 1;
        }
        if (verb == SD_VERB_QUADTO) {
            var qc = load64(points + pi * 8);
            var qe = load64(points + (pi + 1) * 8);
            store64(fctx + 0, fbuf);
            store64(fctx + 8, 0);
            store64(fctx + 16, SD_FLATTEN_CAP);
            sd_flatten_quad(fctx, cur, qc, qe, tol, SD_FLATTEN_MAX_DEPTH);
            cur = sd_fill_edges_from(ectx, fctx, cur);
            sub_open = 1;
            pi = pi + 2;
        }
        if (verb == SD_VERB_CUBICTO) {
            var k1 = load64(points + pi * 8);
            var k2 = load64(points + (pi + 1) * 8);
            var ke = load64(points + (pi + 2) * 8);
            store64(fctx + 0, fbuf);
            store64(fctx + 8, 0);
            store64(fctx + 16, SD_FLATTEN_CAP);
            sd_flatten_cubic(fctx, cur, k1, k2, ke, tol, SD_FLATTEN_MAX_DEPTH);
            cur = sd_fill_edges_from(ectx, fctx, cur);
            sub_open = 1;
            pi = pi + 3;
        }
        if (verb == SD_VERB_CLOSE) {
            sd_edge_add(ectx, sd_point_x(cur), sd_point_y(cur), sd_point_x(sub_start), sd_point_y(sub_start));
            cur = sub_start;
            sub_open = 0;
        }
        vi = vi + 1;
    }
    if (sub_open != 0) {
        sd_edge_add(ectx, sd_point_x(cur), sd_point_y(cur), sd_point_x(sub_start), sd_point_y(sub_start));
    }

    var n_edges = load64(ectx + 8);
    var edges = load64(ectx + 0);
    if (n_edges == 0) { return SADISH_OK; }

    # ---- SD_AA_AREA: exact 2-axis coverage (src/coverage.cyr), opt-in per canvas ----
    # ⛔ Only a canvas holding exactly SD_AA_AREA branches here; every other value runs the 0.4.0
    # loop below, untouched — the bytes agnos's refagree oracle is gated on.
    # ⛔ AND ONLY WHEN THE EDGE LIST CAN BE WHOLE. sd_edge_add drops edges silently once the list
    # holds ecap, leaving a contour OPEN. The loop below paints nothing right of a row's last
    # crossing, so an open contour costs it the shape and no more; the area engine's running sum
    # would stay non-zero to the canvas's right edge — a streak (MEASURED, 80x40, a triangle losing
    # its closing edge: 28 of 40 rows lit at x = 79, 255 at (60, 20)). A full list cannot tell
    # "exactly ecap" from "truncated", so an AREA fill that reaches ecap edges runs the loop below
    # instead (programs/area_test.cyr group N pins both sides of the bound) — ⚠ at that loop's
    # cost, which near the cap is steep (MEASURED 256x256, 8,000 edges: 10.9 s a fill, against the
    # area engine's 41 ms).
    if (load64(cv + SD_CANVAS_AA_OFFSET) == SD_AA_AREA) {
        if (n_edges < ecap) {
            var nonzero = 0;
            if (rule == SD_FILL_NONZERO) { nonzero = 1; }
            var mask = 0;
            var clipn = load64(cv + SD_CANVAS_CLIP_OFFSET);
            if (clipn != 0) { mask = load64(clipn + 0); }
            return _sd_area_fill(edges, n_edges, w, h, cov, stride, mask, nonzero, combine);
        }
    }

    # ---- analytic-horizontal coverage, SD_FILL_SS vertical sub-scanlines ----
    var want_signed = 0;
    if (rule == SD_FILL_NONZERO) { want_signed = 1; }
    var ssy = SD_FILL_SS;
    var weight = SD_ONE / ssy;         # coverage per full pixel per sub-scanline
    var accrow = _sd_fill_accrow_for(w);   # per-row fractional coverage (16.16); zeroed per row below
    var cross = _sd_fill_cross;            # (x, dir) crossings per sub-scanline; only [0, nc) is read

    var py = 0;
    while (py < h) {
        var zi = 0;
        while (zi < w) {
            store64(accrow + zi * 8, 0);
            zi = zi + 1;
        }

        var s = 0;
        while (s < ssy) {
            var sy = (py << SD_SHIFT) + (s * SD_ONE + (SD_ONE >> 1)) / ssy;
            # gather crossings at this sub-scanline
            var nc = 0;
            var ei = 0;
            while (ei < n_edges) {
                var e = edges + ei * 32;
                var ay = load64(e + 8);
                var by = load64(e + 24);
                var ylo = ay;
                var yhi = by;
                var dir = 1;
                if (ay > by) { ylo = by; yhi = ay; dir = 0 - 1; }
                if (sy >= ylo) {
                    if (sy < yhi) {
                        var ax = load64(e + 0);
                        var bx = load64(e + 16);
                        var xx = ax + ((bx - ax) * (sy - ay)) / (by - ay);
                        store64(cross + nc * 16, xx);
                        store64(cross + nc * 16 + 8, dir);
                        nc = nc + 1;
                    }
                }
                ei = ei + 1;
            }
            # insertion sort crossings by x
            var a = 1;
            while (a < nc) {
                var kx = load64(cross + a * 16);
                var kd = load64(cross + a * 16 + 8);
                var b = a - 1;
                var stop = 0;
                while (stop == 0) {
                    if (b < 0) {
                        stop = 1;
                    } else {
                        if (load64(cross + b * 16) > kx) {
                            store64(cross + (b + 1) * 16, load64(cross + b * 16));
                            store64(cross + (b + 1) * 16 + 8, load64(cross + b * 16 + 8));
                            b = b - 1;
                        } else {
                            stop = 1;
                        }
                    }
                }
                store64(cross + (b + 1) * 16, kx);
                store64(cross + (b + 1) * 16 + 8, kd);
                a = a + 1;
            }
            # walk crossings -> covered spans -> analytic horizontal coverage
            var wind = 0;
            var ci = 0;
            while (ci < nc - 1) {
                if (want_signed != 0) {
                    wind = wind + load64(cross + ci * 16 + 8);
                } else {
                    wind = wind + 1;
                }
                var inside = 0;
                if (want_signed != 0) {
                    if (wind != 0) { inside = 1; }
                } else {
                    if ((wind & 1) != 0) { inside = 1; }
                }
                if (inside != 0) {
                    sd_span_add(accrow, w, load64(cross + ci * 16), load64(cross + (ci + 1) * 16), weight);
                }
                ci = ci + 1;
            }
            s = s + 1;
        }

        # accumulator row -> coverage bytes (with clip + combine)
        var px = 0;
        while (px < w) {
            var cvg = load64(accrow + px * 8);
            var c = (cvg * 255) >> SD_SHIFT;
            if (c > 255) { c = 255; }
            var clipnode = load64(cv + SD_CANVAS_CLIP_OFFSET);
            if (clipnode != 0) {
                c = (c * load8(load64(clipnode + 0) + py * stride + px)) / 255;
            }
            if (combine != 0) {
                var oldc = load8(cov + py * stride + px);
                if (c < oldc) { c = oldc; }
            }
            store8(cov + py * stride + px, c);
            px = px + 1;
        }
        py = py + 1;
    }
    return SADISH_OK;
}

# ================================================================
# sd_canvas_blit_at — composite the canvas coverage onto an SdSurface `surface`
# with the canvas's (0,0) placed at surface pixel (dx, dy), using the solid
# `color` (0x00RRGGBB), the per-pixel coverage acting as the source alpha
# (src-over): out = src*cov/255 + dst*(255-cov)/255. (dx, dy) may be negative
# or beyond the surface — the blit is clipped to the surface on every side.
#
# ⚠ Rows are addressed by `sd_surface_stride(surface)`, NOT width*4. A surface
# that WRAPS a wider buffer (dhancha's dh_surface_wrap over a framebuffer or a
# sub-rect of a pane) has stride != width*4, and the pre-0.5.5 sd_canvas_blit
# used `sw` as the pitch — right for every packed surface sadish makes itself,
# and one row's worth of shear per row on a wrapped one. Same src-over math
# as before, verbatim; only the addressing changed.
#
# Gradient paint (linear / radial, multi-stop) is sd_canvas_blit_paint_at in src/paint.cyr (0.6.0).
# TODO: a whole-canvas fast path routed through the AGNOS blit#39.
# ================================================================
# @public
fn sd_canvas_blit_at(cv, surface, color, dx, dy): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (surface == 0) { return SADISH_ERR_BOUNDS; }
    var cw = sd_canvas_width(cv);
    var ch = sd_canvas_height(cv);
    var covbuf = sd_canvas_coverage(cv);
    var covstride = sd_canvas_stride(cv);
    var sw = sd_surface_width(surface);
    var sh = sd_surface_height(surface);
    var spx = sd_surface_pixels(surface);
    var pitch = sd_surface_stride(surface);

    var sr = (color >> 16) & 255;
    var sg = (color >> 8) & 255;
    var sb = color & 255;

    # Clip the canvas rect [dx, dx+cw) x [dy, dy+ch) to the surface: x0..x1 / y0..y1
    # are CANVAS coordinates of the visible part.
    var x0 = 0;
    if (dx < 0) { x0 = 0 - dx; }
    var y0 = 0;
    if (dy < 0) { y0 = 0 - dy; }
    var x1 = cw;
    if (dx + x1 > sw) { x1 = sw - dx; }
    var y1 = ch;
    if (dy + y1 > sh) { y1 = sh - dy; }

    var y = y0;
    while (y < y1) {
        var x = x0;
        while (x < x1) {
            var a = load8(covbuf + y * covstride + x);
            if (a != 0) {
                var off = (y + dy) * pitch + (x + dx) * 4;
                if (a == 255) {
                    store8(spx + off, sb);
                    store8(spx + off + 1, sg);
                    store8(spx + off + 2, sr);
                    store8(spx + off + 3, 255);
                } else {
                    var ia = 255 - a;
                    var nb = (sb * a + load8(spx + off) * ia) / 255;
                    var ng = (sg * a + load8(spx + off + 1) * ia) / 255;
                    var nr = (sr * a + load8(spx + off + 2) * ia) / 255;
                    store8(spx + off, nb);
                    store8(spx + off + 1, ng);
                    store8(spx + off + 2, nr);
                    store8(spx + off + 3, 255);
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return SADISH_OK;
}

# @public — sd_canvas_blit_at with the canvas at the surface origin. On a packed
# surface (stride == width*4) the bytes are identical to the pre-0.5.5 blit
# (asserted pixel-for-pixel in programs/alloc_test.cyr).
fn sd_canvas_blit(cv, surface, color): i64 {
    return sd_canvas_blit_at(cv, surface, color, 0, 0);
}

# ================================================================
# sd_canvas_blit_gradient — like sd_canvas_blit, but the source color is a
# LINEAR GRADIENT from `c0` (at pixel (x0,y0)) to `c1` (at (x1,y1)): each
# pixel's color is c0..c1 lerped by its projection onto the axis (clamped to
# the endpoints), then src-over with coverage. Colors 0x00RRGGBB; endpoints in
# whole pixels. A degenerate axis (x0,y0 == x1,y1) paints solid c0.
# ⚠ Kept byte-identical for existing callers. Radial + multi-stop + spread, sampled at pixel
# CENTRES with 16.16 endpoints, is the SdGradient paint in src/paint.cyr (0.6.0).
# ================================================================
# @public
fn sd_canvas_blit_gradient(cv, surface, x0, y0, c0, x1, y1, c1): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (surface == 0) { return SADISH_ERR_BOUNDS; }
    var cw = sd_canvas_width(cv);
    var ch = sd_canvas_height(cv);
    var covbuf = sd_canvas_coverage(cv);
    var covstride = sd_canvas_stride(cv);
    var sw = sd_surface_width(surface);
    var sh = sd_surface_height(surface);
    var spx = sd_surface_pixels(surface);
    var pitch = sd_surface_stride(surface);   # ⚠ row pitch in bytes, not sw*4 (see sd_canvas_blit_at)

    var dx = x1 - x0;
    var dy = y1 - y0;
    var td = dx * dx + dy * dy;   # squared axis length
    var r0 = (c0 >> 16) & 255;
    var g0 = (c0 >> 8) & 255;
    var b0 = c0 & 255;
    var r1 = (c1 >> 16) & 255;
    var g1 = (c1 >> 8) & 255;
    var b1 = c1 & 255;

    var w = cw;
    if (sw < w) { w = sw; }
    var h = ch;
    if (sh < h) { h = sh; }

    var y = 0;
    while (y < h) {
        var x = 0;
        while (x < w) {
            var a = load8(covbuf + y * covstride + x);
            if (a != 0) {
                var sr = r0;
                var sg = g0;
                var sb = b0;
                if (td > 0) {
                    var tn = (x - x0) * dx + (y - y0) * dy;
                    if (tn < 0) { tn = 0; }
                    if (tn > td) { tn = td; }
                    sr = r0 + ((r1 - r0) * tn) / td;
                    sg = g0 + ((g1 - g0) * tn) / td;
                    sb = b0 + ((b1 - b0) * tn) / td;
                }
                var off = y * pitch + x * 4;
                if (a == 255) {
                    store8(spx + off, sb);
                    store8(spx + off + 1, sg);
                    store8(spx + off + 2, sr);
                    store8(spx + off + 3, 255);
                } else {
                    var ia = 255 - a;
                    var nb = (sb * a + load8(spx + off) * ia) / 255;
                    var ng = (sg * a + load8(spx + off + 1) * ia) / 255;
                    var nr = (sr * a + load8(spx + off + 2) * ia) / 255;
                    store8(spx + off, nb);
                    store8(spx + off + 1, ng);
                    store8(spx + off + 2, nr);
                    store8(spx + off + 3, 255);
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return SADISH_OK;
}

# ---- clipping (v0.4.0) -----------------------------------------
# A clip is a coverage MASK (0..255 per pixel), the top of a stack held on the
# canvas (SD_CANVAS_CLIP_OFFSET). fill_impl multiplies each pixel's coverage by
# the active mask, so fills + strokes are bounded to the clip region; blit then
# composites the already-clipped coverage. Push intersects (multiplies) a new
# shape into the current clip; pop restores the previous region.
# SdClip node (16 bytes): +0 mask(ptr, w*h)  +8 prev(SdClip | 0).

# Intersect `shape` (a w*h mask) with the current clip IN PLACE, then push it.
fn sd_clip_push_mask(cv, shape): i64 {
    var w = sd_canvas_width(cv);
    var h = sd_canvas_height(cv);
    var cur = load64(cv + SD_CANVAS_CLIP_OFFSET);
    if (cur != 0) {
        var curmask = load64(cur + 0);
        var n = w * h;
        var i = 0;
        while (i < n) {
            store8(shape + i, (load8(shape + i) * load8(curmask + i)) / 255);
            i = i + 1;
        }
    }
    var node = sd_alloc(16);
    store64(node + 0, shape);
    store64(node + 8, cur);
    store64(cv + SD_CANVAS_CLIP_OFFSET, node);
    return SADISH_OK;
}

# @public — intersect a rectangle [x0,x1) x [y0,y1) (whole pixels) into the
# clip and push it.
fn sd_canvas_clip_push_rect(cv, x0, y0, x1, y1): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    var w = sd_canvas_width(cv);
    var h = sd_canvas_height(cv);
    var shape = sd_alloc(w * h);
    var y = 0;
    while (y < h) {
        var x = 0;
        while (x < w) {
            var v = 0;
            if (x >= x0) {
                if (x < x1) {
                    if (y >= y0) {
                        if (y < y1) { v = 255; }
                    }
                }
            }
            store8(shape + y * w + x, v);
            x = x + 1;
        }
        y = y + 1;
    }
    return sd_clip_push_mask(cv, shape);
}

# @public — intersect a filled PATH (its coverage) into the clip and push it.
fn sd_canvas_clip_push_path(cv, path, rule): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (path == 0) { return SADISH_ERR_EMPTY_PATH; }
    var w = sd_canvas_width(cv);
    var h = sd_canvas_height(cv);
    var tmp = sd_canvas_new(w, h);        # fresh (unclipped) -> raw shape coverage
    sd_canvas_set_aa(tmp, sd_canvas_aa(cv));   # the mask uses the parent's coverage engine
    sd_canvas_fill_path(tmp, path, rule);
    return sd_clip_push_mask(cv, sd_canvas_coverage(tmp));
}

# @public — pop the top clip, restoring the previous region (0 = unclipped).
fn sd_canvas_clip_pop(cv): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    var cur = load64(cv + SD_CANVAS_CLIP_OFFSET);
    if (cur != 0) {
        store64(cv + SD_CANVAS_CLIP_OFFSET, load64(cur + 8));
    }
    return SADISH_OK;
}

# ================================================================
# Version probe — packed as major*10000 + minor*100 + patch.
# 0.4.0 -> 400; 0.4.1 -> 401; 0.5.5 -> 505; 0.6.0 -> 600.
# ================================================================
# @public
fn sadish_version(): i64 {
    return 600;
}

# --- stroke.cyr ---

# @public — sadish stroker: path -> stroke coverage, round (0.4.0) or styled caps + joins.
#
# stroke.cyr — two entry points over one flatten step:
#   sd_canvas_stroke_path(cv, path, width)                                  round caps, round joins
#   sd_canvas_stroke_path_ex(cv, path, width, cap, join, miter_limit)       SD_CAP_* x SD_JOIN_*
# Both flatten curve verbs at tol = SD_ONE >> 2 into the stroker's run (the _sd_stroke_* scratch in
# raster.cyr) and MAX-combine the stroke into the canvas coverage, so it unions with whatever the
# canvas already holds and honours the clip.
#
# ⛔ ROUND/ROUND IS THE 0.4.0 STROKER, UNCHANGED. `_ex(cv, p, w, SD_CAP_ROUND, SD_JOIN_ROUND, any)`
# returns `sd_canvas_stroke_path(cv, p, w)`, whose code moved here from raster.cyr verbatim: a
# rect per flattened segment, then a 16-gon disc per run point (duplicates, collinear points and
# the closing vertex included), each its OWN sd_canvas_fill_union pass. Byte-identical to 0.5.5,
# asserted against a verbatim copy in programs/stroke_style_test.cyr. ⚠ So ROUND/ROUND alone keeps
# three 0.4.0 behaviours no other cap/join pair has: a drawing verb after CLOSE continues the same
# run ("M 4,4 L 28,4 L 28,20 Z L 4,20" strokes a closed rectangle; the styled path, like the fill,
# reads a triangle and then (4,4) -> (4,20)); a pixel two pieces split reads the MAX of their
# parts, not their sum (below); and 34,432 B of paths per closed-rect stroke, on the seam.
#
# ⭐ THE STYLED PATH COLLECTS ITS PIECES AS ONE EDGE LIST AND FILLS IT ONCE. Piece-per-pass MAX
# union is not a union: where two pieces share an edge INSIDE a pixel, the pixel gets max(a, b),
# not a + b. MEASURED: two 3-px-tall rects meeting at x = 4.5, fill_union'd separately, leave pixel
# 4 at 127; as one nonzero fill, 255. The round stroker hides that seam under the disc it puts on
# every vertex; a BUTT/MITER/BEVEL stroke has nothing to hide it. So the pieces (segment rects, join
# triangles, discs, square caps) go into a process-lifetime edge batch, every one wound the SAME
# way (negative shoelace, like the segment rect) — winding adds, overlap is exact, and a piece of
# the opposite winding would punch a hole, which is why each triangle's order is decided from its
# own signed area rather than reasoned about.
# ⭐ AND IT FILLS THAT BATCH WITH ITS OWN WALK (_sd_sb_flush), NOT sd_canvas_fill_union. Same
# sampling as the default fill — SD_FILL_SS sub-scanlines, analytic x, the same crossing formula —
# but a run of overlapping or touching pieces is ONE span. sd_fill_impl's nonzero walk adds a span
# per crossing and floors each, so a solid pixel that a piece edge crosses reads 254. MEASURED, a
# width-8 cubic filled through fill_union: 120 such pixels under MITER, 282 under ROUND joins; a
# straight polyline with 10 fractional vertices at width 4: 36. Through the merged walk: 2, 2 and 0
# — the cubic's two sit on the band's rim, where the 0.4.0 round stroker reads 254 too.
# ⚠ The default fill is not changed for this: merging spans there would move its bytes for
# self-overlapping nonzero paths. ⚠ And because the flush does not go through sd_fill_impl, a
# coverage choice made there does not reach styled strokes unless the flush is taught it — so it
# IS taught the one that exists: on an SD_AA_AREA canvas the batch goes to _sd_area_fill
# (src/coverage.cyr) as a nonzero MAX-combine, where touching pieces add exactly and no bridge is
# needed. Same guard as sd_fill_impl: only a batch that cannot have dropped an edge (n < limit).
#
# SEMANTICS (styled path).
#   · Consecutive coincident points are dropped first; a closed subpath whose last point equals
#     its moveto point loses that duplicate, so a zero-length closing segment makes no join.
#   · Open subpath: a cap at each end, a join at every interior vertex. Closed (SD_VERB_CLOSE): no
#     caps, a join at EVERY vertex, the start/end vertex included. A drawing verb after a CLOSE
#     starts a new subpath at the moveto point, as the fill reads it.
#   · A subpath with no non-zero-length segment (a lone moveto, or every point coincident, closed
#     or not): ROUND -> a disc of radius hw, SQUARE -> an axis-aligned square of side 2*hw centred
#     on the point, BUTT -> nothing. This is the common renderer behaviour for "M x y Z" (strict
#     SVG draws nothing for a lone moveto).
#   · BUTT: the segment rect only. SQUARE: a rect extending the segment by hw past its end.
#     ROUND: the disc.
#   · Joins, at vertex V with offsets n_in / n_out (length hw, the segment rects' own corners):
#     collinear continuation -> nothing (the rects meet edge to edge); ROUND -> the disc; BEVEL ->
#     triangle (V, V + s*n_in, V + s*n_out) on the side the offsets diverge; MITER -> that
#     triangle plus (V + s*n_in, tip, V + s*n_out), or the bevel alone past the limit. A full 180°
#     reversal is an infinite miter and a zero-area bevel: a flat, butt-like end.
#   · ⚠ INSIDE A CURVE THE JOIN STYLE DOES NOT APPLY. A vertex the flattener put inside one quad or
#     cubic stands in for a smooth curve, whose stroke is the sweep of a disc: it mitres while the
#     tip stays within the flatten tolerance of that disc — ratio <= 1 + 0.25 px / hw — and takes
#     the round join past it. A MITER join there at the user's limit drew the cusp of
#     "M 10,30 C 50,5 10,5 50,30" (a 150° flattened turn, ratio 3.86 < 4) as a 6 px spike on a 4 px
#     stroke, MEASURED; now it is round. The style applies wherever two VERBS meet, and at a closed
#     subpath's start.
#   · miter_limit is a 16.16 RATIO, SVG `stroke-miterlimit`: miterLength / strokeWidth =
#     1 / sin(theta / 2), theta the INTERIOR angle between the segments; above the limit the join
#     is a bevel, AT the limit it is still a miter. Clamped to [SD_ONE, SD_MITER_LIMIT_MAX].
#
# ⚠ THE LIMIT TEST IS INTEGER MATH, WITHOUT OVERFLOW. Each segment direction is rescaled by a power
# of two so its larger component lies in [2^13, 2^14); with P = isqrt(|e1|^2 |e2|^2) < 2^29 and
# D = e1.e2, "ratio > limit" is 2P > L^2 (P + D), tested as L(P + D) < ceil(P * 2^33 / L) — every
# intermediate below 2^62 for any L <= 2^31, at any coordinate magnitude. It is EXACT when both
# rescalings shed only zero bits (pixel and half-pixel geometry) and |e1||e2| is an integer: a
# (25,0) / (7,24) turn is a ratio of exactly 1.25, and the suite asserts both sides of it, as it
# does 377,108 / 377,109 around the irrational sqrt(298)/3. Otherwise the 13 kept bits of each
# direction put the decision within ~0.1 % of the limit at SVG's default 4 (derived, not measured;
# wider toward a reversal).
# ⚠ MAGNITUDES. The offsets rescale each direction first (_sd_seg_normal), so no segment length
# overflows. A miter tip lies at most miter_limit * hw from its vertex, and the walk's
# (bx - ax) * (sy - ay) needs edge extents under ~46,000 px: SD_MITER_LIMIT_MAX = 1024.0 keeps
# every tip in range up to hw ~ 45 px, and a join past that ratio turns within 0.11° of a reversal.
# ⚠ BATCHES. The batch holds SD_STROKE_BATCH_CAP = 8,192 edges (horizontal ones are dropped, as the
# fill drops them) — about 800 miter segments, 400 with round joins. A subpath that overflows it is
# flushed mid-way; the next batch re-emits the stretch before the flush (until 2*hw + 3 px of it or
# 16 segments, whichever comes first), and a closed subpath's closing join is followed by the same
# stretch after its vertex 0, so every seam ALONG the path falls where one batch is complete: the
# suite sweeps rings, irregular wiggles and blobs across lowered limits, all within 1 level of one
# batch. ⚠ Pieces from DIFFERENT batches still meet by MAX, and where a subpath longer than a batch
# CROSSES or returns onto itself that loss is not bounded — MEASURED on 60 random self-crossing
# walks of 700..1,100 segments (64x64, widths 0.3..5.3 px, MITER/BEVEL) against one 16,384-edge
# batch: 22 split, every one of them more than 3 levels off somewhere, worst 101. (The same 60 walks
# at 300..450 segments fit one batch; at an earlier 4,096-edge cap 14 of them split, worst 93.)
# ⚠ Single-threaded, like the fill: one edge batch and one run for the process.

# ---- cap / join styles ------------------------------------------
var SD_CAP_BUTT   = 0;
var SD_CAP_ROUND  = 1;
var SD_CAP_SQUARE = 2;

var SD_JOIN_MITER = 0;
var SD_JOIN_ROUND = 1;
var SD_JOIN_BEVEL = 2;

# Upper clamp for the miter limit ratio: 1024.0 in 16.16.
var SD_MITER_LIMIT_MAX = 67108864;

# ---- stroking (v0.4.0) -----------------------------------------
# A segment's rectangle: offset both endpoints by `hw` along the segment's
# perpendicular (magnitude via sd_isqrt), fill-union it. Round caps + round
# joins come from a disc at every vertex, so no bevel/miter math is needed.
# Each piece is MAX-unioned so overlaps combine regardless of winding.
fn sd_stroke_seg(cv, ax, ay, bx, by, hw): i64 {
    var dx = bx - ax;
    var dy = by - ay;
    var len2 = dx * dx + dy * dy;
    if (len2 == 0) { return 0; }     # zero-length -> the vertex disc covers it
    var l = sd_isqrt(len2);          # length in 16.16
    if (l == 0) { return 0; }
    var ox = ((0 - dy) * hw) / l;    # perpendicular offset, magnitude hw
    var oy = (dx * hw) / l;
    var rp = sd_path_new();
    sd_path_moveto(rp, ax + ox, ay + oy);
    sd_path_lineto(rp, bx + ox, by + oy);
    sd_path_lineto(rp, bx - ox, by - oy);
    sd_path_lineto(rp, ax - ox, ay - oy);
    sd_path_close(rp);
    sd_canvas_fill_union(cv, rp, SD_FILL_NONZERO);
    return 0;
}

# A radius-hw disc (16-gon) at (cx, cy) — round cap / round join filler.
fn sd_stroke_disc(cv, cx, cy, hw): i64 {
    var dp = sd_path_new();
    var step = 411775 / 16;          # 2*pi / 16 in 16.16
    var k = 0;
    while (k < 16) {
        var ang = k * step;
        var px = cx + sd_fixed_mul(hw, sd_cos(ang));
        var py = cy + sd_fixed_mul(hw, sd_sin(ang));
        if (k == 0) { sd_path_moveto(dp, px, py); } else { sd_path_lineto(dp, px, py); }
        k = k + 1;
    }
    sd_path_close(dp);
    sd_canvas_fill_union(cv, dp, SD_FILL_NONZERO);
    return 0;
}

# Append a flatten ctx's points to the run buffer (bounded by SD_FLATTEN_CAP).
fn sd_stroke_append(run, run_n, fctx): i64 {
    var pts = load64(fctx + 0);
    var n = load64(fctx + 8);
    var i = 0;
    while (i < n) {
        if (run_n < SD_FLATTEN_CAP) {
            store64(run + run_n * 8, load64(pts + i * 8));
            run_n = run_n + 1;
        }
        i = i + 1;
    }
    return run_n;
}

# Stroke one flattened subpath run: a rect per segment + a disc per vertex.
fn sd_stroke_run(cv, run, n, closed, hw): i64 {
    var i = 0;
    while (i < n - 1) {
        var a = load64(run + i * 8);
        var b = load64(run + (i + 1) * 8);
        sd_stroke_seg(cv, sd_point_x(a), sd_point_y(a), sd_point_x(b), sd_point_y(b), hw);
        i = i + 1;
    }
    if (closed != 0) {
        if (n > 1) {
            var a2 = load64(run + (n - 1) * 8);
            var b2 = load64(run + 0);
            sd_stroke_seg(cv, sd_point_x(a2), sd_point_y(a2), sd_point_x(b2), sd_point_y(b2), hw);
        }
    }
    var k = 0;
    while (k < n) {
        var v = load64(run + k * 8);
        sd_stroke_disc(cv, sd_point_x(v), sd_point_y(v), hw);
        k = k + 1;
    }
    return 0;
}

# ================================================================
# sd_canvas_stroke_path — stroke `path` with the given `width` (16.16) onto
# `cv`'s coverage, with round caps + round joins. Flattens curves, then per
# subpath draws a rectangle per segment and a disc per vertex, MAX-combined
# into the coverage buffer.
#
# Styled caps/joins are sd_canvas_stroke_path_ex below; this entry stays the
# 0.4.0 piece-per-pass stroker, byte-identical.
# TODO(v0.5): batch the round pieces — this still allocs a PATH (on the seam)
# + runs a fill pass per segment/vertex (correctness-first); the fixed scratch
# underneath is process-lifetime (0.5.5).
# ================================================================
# @public
fn sd_canvas_stroke_path(cv, path, width): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (path == 0) { return SADISH_ERR_EMPTY_PATH; }
    var n_verbs = sd_path_verb_count(path);
    if (n_verbs == 0) { return SADISH_ERR_EMPTY_PATH; }
    var hw = sd_asr(width, 1);
    if (hw <= 0) { return SADISH_OK; }
    var tol = SD_ONE >> 2;

    # The stroker's OWN scratch set — `run` stays live across the fill_union passes below, which
    # use the fill set (see the scratch block in raster.cyr).
    _sd_scratch_init();
    var run = _sd_stroke_run;
    var run_n = 0;
    var fbuf = _sd_stroke_fbuf;
    var fctx = _sd_stroke_fctx;

    var verbs = load64(path + SD_PATH_VERBS_OFFSET);
    var points = load64(path + SD_PATH_POINTS_OFFSET);
    var cur = 0;
    var closed = 0;
    var vi = 0;
    var pi = 0;
    while (vi < n_verbs) {
        var verb = load64(verbs + vi * 8);
        if (verb == SD_VERB_MOVETO) {
            if (run_n > 0) { sd_stroke_run(cv, run, run_n, closed, hw); }
            run_n = 0;
            closed = 0;
            cur = load64(points + pi * 8);
            store64(run + run_n * 8, cur);
            run_n = run_n + 1;
            pi = pi + 1;
        }
        if (verb == SD_VERB_LINETO) {
            cur = load64(points + pi * 8);
            if (run_n < SD_FLATTEN_CAP) {
                store64(run + run_n * 8, cur);
                run_n = run_n + 1;
            }
            pi = pi + 1;
        }
        if (verb == SD_VERB_QUADTO) {
            var qc = load64(points + pi * 8);
            var qe = load64(points + (pi + 1) * 8);
            store64(fctx + 0, fbuf);
            store64(fctx + 8, 0);
            store64(fctx + 16, SD_FLATTEN_CAP);
            sd_flatten_quad(fctx, cur, qc, qe, tol, SD_FLATTEN_MAX_DEPTH);
            run_n = sd_stroke_append(run, run_n, fctx);
            cur = qe;
            pi = pi + 2;
        }
        if (verb == SD_VERB_CUBICTO) {
            var k1 = load64(points + pi * 8);
            var k2 = load64(points + (pi + 1) * 8);
            var ke = load64(points + (pi + 2) * 8);
            store64(fctx + 0, fbuf);
            store64(fctx + 8, 0);
            store64(fctx + 16, SD_FLATTEN_CAP);
            sd_flatten_cubic(fctx, cur, k1, k2, ke, tol, SD_FLATTEN_MAX_DEPTH);
            run_n = sd_stroke_append(run, run_n, fctx);
            cur = ke;
            pi = pi + 3;
        }
        if (verb == SD_VERB_CLOSE) {
            closed = 1;
        }
        vi = vi + 1;
    }
    if (run_n > 0) { sd_stroke_run(cv, run, run_n, closed, hw); }
    return SADISH_OK;
}

# ---- styled stroking: the edge batch -----------------------------
# Edges one batch holds before it is filled — at most SD_FLATTEN_CAP, the crossings array the flush
# borrows from the fill. The edge array is sized from it at the first styled stroke; after that it
# is read through _sd_sb_limit, which holds it within [SD_STROKE_BATCH_MIN, the allocated capacity],
# so raising it later cannot write past the array and lowering it (the suite does, to force
# flushes) cannot starve a re-emission.
var SD_STROKE_BATCH_CAP = 8192;
# Room reserved before one unit. A unit is at most 39 edges: a join (a 16-gon disc, or 3 bevel + 16
# for a curve vertex past its tolerance), the rect (4), and an end cap or the closing join (16).
var SD_STROKE_UNIT_EDGES = 40;
# The smallest limit that holds what may follow a flush without another: 16 re-emitted units back
# (<= 23 edges each — never a last unit), the unit, and a closed subpath's 16 forward: 775 edges.
var SD_STROKE_BATCH_MIN = 800;

# ⛔ Process-lifetime, from the GLOBAL alloc, allocated by the first styled stroke — not by
# _sd_scratch_init, so a process that never strokes with styles never pays for it. Same reason as
# raster.cyr's scratch: a consumer's hook is an arena that gets reset. MEASURED one-time cost
# 270,592 B (8,192 * 32 edges + 256 trig + 8,192 curve flags); after it a straight-line styled
# stroke costs the heap 0 B, and curves only their flatten mid-points. The flush's crossings use
# the fill's _sd_fill_cross (SD_FLATTEN_CAP * 16): a per-fill working array, not held across a
# call, which the flush IS — so it is borrowed, not duplicated.
var _sd_sb_edges = 0;   # _sd_sb_cap * 32 — (ax, ay, bx, by) per edge, a -> b in winding order
var _sd_sb_cap = 0;     # edges the arrays hold
var _sd_sb_n = 0;       # edges in the batch
var _sd_sb_trig = 0;    # 16 (cos, sin) pairs — the 16-gon disc, sd_stroke_disc's angles
# _sd_sb_inner is never read at run[0]: a subpath's first point takes a cap, or the closing join,
# which is passed 0.
var _sd_sb_inner = 0;   # SD_FLATTEN_CAP bytes, parallel to the run: 1 = inside a curve's flattening

fn _sd_sb_init(): i64 {
    if (_sd_sb_edges != 0) { return 0; }
    var cap = SD_STROKE_BATCH_CAP;
    if (cap < SD_STROKE_BATCH_MIN) { cap = SD_STROKE_BATCH_MIN; }
    if (cap > SD_FLATTEN_CAP) { cap = SD_FLATTEN_CAP; }   # n edges make at most n crossings
    _sd_sb_trig = alloc(16 * 16);
    var step = 411775 / 16;          # 2*pi / 16 in 16.16, as sd_stroke_disc
    var k = 0;
    while (k < 16) {
        store64(_sd_sb_trig + k * 16, sd_cos(k * step));
        store64(_sd_sb_trig + k * 16 + 8, sd_sin(k * step));
        k = k + 1;
    }
    _sd_sb_inner = alloc(SD_FLATTEN_CAP);
    _sd_sb_cap = cap;
    _sd_sb_edges = alloc(cap * 32);
    return 0;
}

# The batch's edge limit: SD_STROKE_BATCH_CAP within [SD_STROKE_BATCH_MIN, _sd_sb_cap].
fn _sd_sb_limit(): i64 {
    var lim = SD_STROKE_BATCH_CAP;
    if (lim < SD_STROKE_BATCH_MIN) { lim = SD_STROKE_BATCH_MIN; }
    if (lim > _sd_sb_cap) { lim = _sd_sb_cap; }
    return lim;
}

# 1 if `k` more edges fit in the batch.
fn _sd_sb_room(k): i64 {
    if (_sd_sb_n + k <= _sd_sb_limit()) { return 1; }
    return 0;
}

# Append the edge a -> b. Horizontal edges cross no sub-scanline and are dropped. The unit reserve
# keeps a batch within its limit; the limit check is the backstop that turns a broken reserve into
# a dropped edge instead of a write past the array (the limit never exceeds the allocation).
fn _sd_sb_edge(ax, ay, bx, by): i64 {
    if (ay == by) { return 0; }
    if (_sd_sb_n >= _sd_sb_limit()) { return 0; }
    var e = _sd_sb_edges + _sd_sb_n * 32;
    store64(e + 0, ax);
    store64(e + 8, ay);
    store64(e + 16, bx);
    store64(e + 24, by);
    _sd_sb_n = _sd_sb_n + 1;
    return 0;
}

# Fill the batch into `cv` — MAX-combined, through the clip — and empty it. The default fill's
# sampling (SD_FILL_SS sub-scanlines, analytic x, sd_fill_impl's crossing formula and sort), but
# the nonzero walk opens a span where the winding leaves 0 and closes it where it returns, so
# overlapping pieces are one span and one floor. ⚠ And where the winding returns to 0 and the next
# crossing reopens within 1 LSB, the span carries on: two pieces that only TOUCH (a join
# triangle's side lies along the rect's end edge; consecutive rects share one) compute that shared
# line's crossing from different endpoints, each truncation under 1 LSB off the true x — so they
# differ by at most 1, and a split there would floor the pixel to 254 all over again (MEASURED,
# a 40-gon ring at width 5 under MITER: 53 pixels at 254 without the bridge; with it 2, both on the
# band's rim, where the round stroker reads 254 too).
# Bridging a real 1-LSB gap adds 1/4 of a raw unit of coverage. Rows outside the batch's y range
# are skipped: they would MAX a 0 into the coverage.
fn _sd_sb_flush(cv): i64 {
    var n = _sd_sb_n;
    if (n == 0) { return 0; }
    _sd_sb_n = 0;
    var edges = _sd_sb_edges;
    var cross = _sd_fill_cross;
    var w = sd_canvas_width(cv);
    var h = sd_canvas_height(cv);
    var cov = sd_canvas_coverage(cv);
    var stride = sd_canvas_stride(cv);
    # ⛔ SD_AA_AREA canvas: the exact engine, nonzero, MAX-combined through the clip. Every piece is
    # a closed polygon, so the list is whole unless the backstop in _sd_sb_edge dropped an edge —
    # which it only does once the batch is AT its limit, so a batch below it is provably whole and a
    # full one takes the walk below (a dropped edge would streak the area engine to the right edge).
    if (sd_canvas_aa(cv) == SD_AA_AREA) {
        if (n < _sd_sb_limit()) {
            var mask = 0;
            var clipn = load64(cv + SD_CANVAS_CLIP_OFFSET);
            if (clipn != 0) { mask = load64(clipn + 0); }
            return _sd_area_fill(edges, n, w, h, cov, stride, mask, 1, 1);
        }
    }
    var ymin = load64(edges + 8);
    var ymax = ymin;
    var ei = 0;
    while (ei < n) {
        var ey0 = load64(edges + ei * 32 + 8);
        var ey1 = load64(edges + ei * 32 + 24);
        if (ey0 < ymin) { ymin = ey0; }
        if (ey1 < ymin) { ymin = ey1; }
        if (ey0 > ymax) { ymax = ey0; }
        if (ey1 > ymax) { ymax = ey1; }
        ei = ei + 1;
    }
    var py = sd_asr(ymin, SD_SHIFT);
    if (py < 0) { py = 0; }
    var py_end = sd_asr(ymax, SD_SHIFT) + 1;
    if (py_end > h) { py_end = h; }
    var ssy = SD_FILL_SS;
    var weight = SD_ONE / ssy;
    var accrow = _sd_fill_accrow_for(w);
    while (py < py_end) {
        var zi = 0;
        while (zi < w) {
            store64(accrow + zi * 8, 0);
            zi = zi + 1;
        }
        var s = 0;
        while (s < ssy) {
            var sy = (py << SD_SHIFT) + (s * SD_ONE + (SD_ONE >> 1)) / ssy;
            var nc = 0;
            ei = 0;
            while (ei < n) {
                var e = edges + ei * 32;
                var ay = load64(e + 8);
                var by = load64(e + 24);
                var ylo = ay;
                var yhi = by;
                var dir = 1;
                if (ay > by) {
                    ylo = by;
                    yhi = ay;
                    dir = 0 - 1;
                }
                if (sy >= ylo) {
                    if (sy < yhi) {
                        var ax = load64(e + 0);
                        var bx = load64(e + 16);
                        store64(cross + nc * 16, ax + ((bx - ax) * (sy - ay)) / (by - ay));
                        store64(cross + nc * 16 + 8, dir);
                        nc = nc + 1;
                    }
                }
                ei = ei + 1;
            }
            var a = 1;
            while (a < nc) {
                var kx = load64(cross + a * 16);
                var kd = load64(cross + a * 16 + 8);
                var b = a - 1;
                var stop = 0;
                while (stop == 0) {
                    if (b < 0) {
                        stop = 1;
                    } else {
                        if (load64(cross + b * 16) > kx) {
                            store64(cross + (b + 1) * 16, load64(cross + b * 16));
                            store64(cross + (b + 1) * 16 + 8, load64(cross + b * 16 + 8));
                            b = b - 1;
                        } else {
                            stop = 1;
                        }
                    }
                }
                store64(cross + (b + 1) * 16, kx);
                store64(cross + (b + 1) * 16 + 8, kd);
                a = a + 1;
            }
            var wind = 0;
            var open = 0;
            var xs = 0;
            var ci = 0;
            while (ci < nc) {
                var cx = load64(cross + ci * 16);
                if (open == 0) {
                    xs = cx;
                    open = 1;
                }
                wind = wind + load64(cross + ci * 16 + 8);
                if (wind == 0) {
                    var bridge = 0;
                    if (ci + 1 < nc) {
                        if (load64(cross + (ci + 1) * 16) - cx <= 1) { bridge = 1; }
                    }
                    if (bridge == 0) {
                        sd_span_add(accrow, w, xs, cx, weight);
                        open = 0;
                    }
                }
                ci = ci + 1;
            }
            s = s + 1;
        }
        var px = 0;
        while (px < w) {
            var c = (load64(accrow + px * 8) * 255) >> SD_SHIFT;
            if (c > 255) { c = 255; }
            var clipnode = load64(cv + SD_CANVAS_CLIP_OFFSET);
            if (clipnode != 0) {
                c = (c * load8(load64(clipnode + 0) + py * stride + px)) / 255;
            }
            var oldc = load8(cov + py * stride + px);
            if (c < oldc) { c = oldc; }
            store8(cov + py * stride + px, c);
            px = px + 1;
        }
        py = py + 1;
    }
    return 0;
}

# The rect A+o, B+o, B-o, A-o — sd_stroke_seg's corners. With o = perp(B - A) * hw / |B - A| its
# shoelace sum is negative for every direction: the winding every batch piece is given.
fn _sd_sb_rect(ax, ay, bx, by, ox, oy): i64 {
    if (ox == 0) {
        if (oy == 0) { return 0; }
    }
    _sd_sb_edge(ax + ox, ay + oy, bx + ox, by + oy);
    _sd_sb_edge(bx + ox, by + oy, bx - ox, by - oy);
    _sd_sb_edge(bx - ox, by - oy, ax - ox, ay - oy);
    return _sd_sb_edge(ax - ox, ay - oy, ax + ox, ay + oy);
}

# max(|a|, |b|).
fn _sd_max_abs(a, b): i64 {
    var m = sd_abs(a);
    if (sd_abs(b) > m) { m = sd_abs(b); }
    return m;
}

# Sign (-1, 0, 1) of cross((ax, ay), (bx, by)). The four components are halved together until
# they are below 2^30, so the products cannot overflow at any magnitude.
fn _sd_cross_sign(ax, ay, bx, by): i64 {
    var a = ax;
    var b = ay;
    var c = bx;
    var d = by;
    while (_sd_max_abs(_sd_max_abs(a, b), _sd_max_abs(c, d)) >= 1073741824) {
        a = sd_asr(a, 1);
        b = sd_asr(b, 1);
        c = sd_asr(c, 1);
        d = sd_asr(d, 1);
    }
    var cr = a * d - b * c;
    if (cr < 0) { return 0 - 1; }
    if (cr > 0) { return 1; }
    return 0;
}

# A triangle, wound like the rect (negative shoelace) whatever order its corners arrive in;
# zero area emits nothing.
fn _sd_sb_tri(x0, y0, x1, y1, x2, y2): i64 {
    var sg = _sd_cross_sign(x1 - x0, y1 - y0, x2 - x0, y2 - y0);
    if (sg == 0) { return 0; }
    if (sg < 0) {
        _sd_sb_edge(x0, y0, x1, y1);
        _sd_sb_edge(x1, y1, x2, y2);
        return _sd_sb_edge(x2, y2, x0, y0);
    }
    _sd_sb_edge(x0, y0, x2, y2);
    _sd_sb_edge(x2, y2, x1, y1);
    return _sd_sb_edge(x1, y1, x0, y0);
}

# sd_stroke_disc's 16-gon at (cx, cy), walked backwards: increasing angle is the positive winding.
fn _sd_sb_disc(cx, cy, hw): i64 {
    var fx = cx + sd_fixed_mul(hw, load64(_sd_sb_trig + 15 * 16));
    var fy = cy + sd_fixed_mul(hw, load64(_sd_sb_trig + 15 * 16 + 8));
    var lx = fx;
    var ly = fy;
    var k = 14;
    while (k >= 0) {
        var px = cx + sd_fixed_mul(hw, load64(_sd_sb_trig + k * 16));
        var py = cy + sd_fixed_mul(hw, load64(_sd_sb_trig + k * 16 + 8));
        _sd_sb_edge(lx, ly, px, py);
        lx = px;
        ly = py;
        k = k - 1;
    }
    return _sd_sb_edge(lx, ly, fx, fy);
}

# ---- styled stroking: geometry -----------------------------------
# The perpendicular offset of segment A -> B, magnitude hw: (-dy, dx) * hw / |d|, the direction
# first rescaled by a power of two so its larger component is in [2^20, 2^21). Its rect, its caps
# and both joins call this with the same endpoints, so their shared corners coincide exactly.
# ⚠ Not sd_stroke_seg's `(dy * hw) / isqrt(len2)` on the raw deltas: for a 1-LSB diagonal that
# isqrt is 1, not 1.414, and the join corner lands 41 % of hw outside the band. Rescaled, |d| is
# exact to 2^-20 for any length, and no length overflows (|dy| < 2^21, so hw < 2^42).
# (0, 0) for a zero-length segment.
fn _sd_seg_normal(ax, ay, bx, by, hw): (i64, i64) {
    var dx = bx - ax;
    var dy = by - ay;
    if (dx == 0) {
        if (dy == 0) { return (0, 0); }
    }
    while (_sd_max_abs(dx, dy) >= 2097152) {
        dx = sd_asr(dx, 1);
        dy = sd_asr(dy, 1);
    }
    while (_sd_max_abs(dx, dy) < 1048576) {
        dx = dx << 1;
        dy = dy << 1;
    }
    var l = sd_isqrt(dx * dx + dy * dy);
    return (((0 - dy) * hw) / l, (dx * hw) / l);
}

# Rescale a direction by a power of two until its larger component is in [2^13, 2^14). Scaling
# does not change an angle; for 16.16 pixel coordinates the down-shifts only drop zero bits.
fn _sd_dir_reduce(dx, dy): (i64, i64) {
    var x = dx;
    var y = dy;
    if (x == 0) {
        if (y == 0) { return (0, 0); }
    }
    while (_sd_max_abs(x, y) >= 16384) {
        x = sd_asr(x, 1);
        y = sd_asr(y, 1);
    }
    while (_sd_max_abs(x, y) < 8192) {
        x = x << 1;
        y = y << 1;
    }
    return (x, y);
}

# The join at V between segments P -> V and V -> Q (both non-zero length). `inner` != 0 when V lies
# inside one curve's flattening: the style is replaced by a miter held to 1 + 0.25 px / hw (the
# flatten tolerance over the half-width) that falls back to the round join, not the bevel.
fn _sd_sb_join(px, py, vx, vy, qx, qy, hw, join, ml, inner): i64 {
    var n1x, n1y = _sd_seg_normal(px, py, vx, vy, hw);
    var n2x, n2y = _sd_seg_normal(vx, vy, qx, qy, hw);
    var cr = n1x * n2y - n1y * n2x;     # |n| <= hw, so < hw^2: no overflow
    if (cr == 0) {
        if (n1x * n2x + n1y * n2y >= 0) { return 0; }    # straight on
    }
    var jn = join;
    var lim = ml;
    if (inner != 0) {
        # <= 2^30 + 2^16 (hw >= 1): inside the limit test's L <= 2^31. Unclamped, as it needs no
        # clamp: the tip it admits lies within hw + 0.25 px of V at any hw.
        jn = SD_JOIN_MITER;
        lim = SD_ONE + ((SD_ONE >> 2) << SD_SHIFT) / hw;
    }
    if (jn == SD_JOIN_ROUND) { return _sd_sb_disc(vx, vy, hw); }
    if (cr == 0) {
        # A reversal: the bevel has no area. Inside a curve it is a cusp, which the disc rounds.
        if (inner != 0) { return _sd_sb_disc(vx, vy, hw); }
        return 0;
    }
    # cross > 0 turns toward +n, so the offsets diverge on the -n side, and vice versa.
    var sg = 1;
    if (cr > 0) { sg = 0 - 1; }
    var p1x = vx + sg * n1x;
    var p1y = vy + sg * n1y;
    var p2x = vx + sg * n2x;
    var p2y = vy + sg * n2y;
    _sd_sb_tri(vx, vy, p1x, p1y, p2x, p2y);
    if (jn == SD_JOIN_BEVEL) { return 0; }

    # MITER. cos(phi) = D / P for the turn phi = pi - theta; ratio^2 = 1 / cos^2(phi/2) =
    # 2P / (P + D). Past the limit when 2P > L^2 (P + D), i.e. L * u < P * 2^33 with u = L(P + D)
    # (L in 16.16), i.e. u < ceil(P * 2^33 / L) — exact in integers (see the header).
    var e1x, e1y = _sd_dir_reduce(vx - px, vy - py);
    var e2x, e2y = _sd_dir_reduce(qx - vx, qy - vy);
    var s1 = e1x * e1x + e1y * e1y;     # < 2^29
    var s2 = e2x * e2x + e2y * e2y;
    var pp = sd_isqrt(s1 * s2);         # |e1||e2| < 2^29
    var q = pp + e1x * e2x + e1y * e2y; # P + D, below 2^30
    # P >= 2^26 (both reduced components reach 2^13), so the right side is >= 1: a reversal
    # (q <= 0) always bevels here, and q > 0 below.
    if (lim * q < ((pp << 33) + lim - 1) / lim) {
        if (inner != 0) { return _sd_sb_disc(vx, vy, hw); }
        return 0;
    }
    # tip = V + s * hw * (u1 + u2) / (1 + cos(phi)), u the unit normals; over the common |e1||e2|
    # that is s * hw * W / (P + D) with W = (-(e1y |e2| + e2y |e1|), e1x |e2| + e2x |e1|).
    var l1 = sd_isqrt(s1);
    var l2 = sd_isqrt(s2);
    var tx = vx + sg * ((hw * (0 - (e1y * l2 + e2y * l1))) / q);
    var ty = vy + sg * ((hw * (e1x * l2 + e2x * l1)) / q);
    return _sd_sb_tri(p1x, p1y, tx, ty, p2x, p2y);
}

# A cap at V for the adjacent segment's offset (ox, oy); `fwd` = 1 at the subpath's end (extend
# along the segment), 0 at its start (extend backwards). e = (oy, -ox) is the direction * hw.
fn _sd_sb_endcap(vx, vy, ox, oy, fwd, cap, hw): i64 {
    if (cap == SD_CAP_ROUND) { return _sd_sb_disc(vx, vy, hw); }
    if (cap == SD_CAP_SQUARE) {
        if (fwd != 0) { return _sd_sb_rect(vx, vy, vx + oy, vy - ox, ox, oy); }
        return _sd_sb_rect(vx - oy, vy + ox, vx, vy, ox, oy);
    }
    return 0;
}

# Length (16.16) of segment j of an m-vertex subpath (j + 1 wraps to 0).
fn _sd_sb_seglen(run, m, j): i64 {
    var bj = j + 1;
    if (bj == m) { bj = 0; }
    var a = load64(run + j * 8);
    var b = load64(run + bj * 8);
    var dx = sd_point_x(b) - sd_point_x(a);
    var dy = sd_point_y(b) - sd_point_y(a);
    return sd_isqrt(dx * dx + dy * dy);
}

# One unit of a de-duplicated subpath: whatever sits at vertex i (the start cap, or the join),
# segment i's rect, and — after the LAST segment — the end cap or the closing join at vertex 0.
fn _sd_sb_unit(run, m, closed, i, hw, cap, join, ml): i64 {
    var bi = i + 1;
    if (bi == m) { bi = 0; }
    var a = load64(run + i * 8);
    var b = load64(run + bi * 8);
    var ax = sd_point_x(a);
    var ay = sd_point_y(a);
    var bx = sd_point_x(b);
    var by = sd_point_y(b);
    var ox, oy = _sd_seg_normal(ax, ay, bx, by, hw);
    if (i == 0) {
        if (closed == 0) { _sd_sb_endcap(ax, ay, ox, oy, 0, cap, hw); }
    } else {
        var pv = load64(run + (i - 1) * 8);
        _sd_sb_join(sd_point_x(pv), sd_point_y(pv), ax, ay, bx, by, hw, join, ml, load8(_sd_sb_inner + i));
    }
    _sd_sb_rect(ax, ay, bx, by, ox, oy);
    if (bi == 0) {
        # closed: the vertex-0 join, between this closing segment and segment 0 — a moveto point,
        # so never inside a curve
        var nx = load64(run + 8);
        _sd_sb_join(ax, ay, bx, by, sd_point_x(nx), sd_point_y(nx), hw, join, ml, 0);
    } else {
        if (closed == 0) {
            if (bi == m - 1) { _sd_sb_endcap(bx, by, ox, oy, 1, cap, hw); }
        }
    }
    return 0;
}

# Stroke one flattened subpath run (n points, curve flags in _sd_sb_inner) into the batch.
fn _sd_sb_subpath(cv, run, n, closed, hw, cap, join, ml): i64 {
    # Drop consecutive coincident points, in place (the write index never passes the read index).
    # A kept point is inside a curve only if every point it absorbs is: where a verb's end meets
    # a coincident curve point, the verbs' join style wins.
    var inner = _sd_sb_inner;
    var m = 0;
    var k = 0;
    while (k < n) {
        var p = load64(run + k * 8);
        var keep = 1;
        if (m > 0) {
            var last = load64(run + (m - 1) * 8);
            if (sd_point_x(p) == sd_point_x(last)) {
                if (sd_point_y(p) == sd_point_y(last)) { keep = 0; }
            }
        }
        if (keep != 0) {
            store64(run + m * 8, p);
            store8(inner + m, load8(inner + k));
            m = m + 1;
        } else {
            store8(inner + m - 1, load8(inner + m - 1) & load8(inner + k));
        }
        k = k + 1;
    }
    if (closed != 0) {
        if (m > 1) {
            var z0 = load64(run + 0);
            var zl = load64(run + (m - 1) * 8);
            if (sd_point_x(z0) == sd_point_x(zl)) {
                if (sd_point_y(z0) == sd_point_y(zl)) { m = m - 1; }
            }
        }
    }

    if (m == 1) {
        if (_sd_sb_room(SD_STROKE_UNIT_EDGES) == 0) { _sd_sb_flush(cv); }
        var v = load64(run + 0);
        var vx = sd_point_x(v);
        var vy = sd_point_y(v);
        if (cap == SD_CAP_ROUND) { _sd_sb_disc(vx, vy, hw); }
        if (cap == SD_CAP_SQUARE) { _sd_sb_rect(vx - hw, vy, vx + hw, vy, 0, hw); }
        return 0;
    }

    var s = m - 1;
    if (closed != 0) { s = m; }
    var flushed = 0;
    var i = 0;
    while (i < s) {
        var need = SD_STROKE_UNIT_EDGES;
        if (closed != 0) {
            if (i == s - 1) { need = SD_STROKE_UNIT_EDGES * 17; }   # + the forward re-emit below
        }
        if (_sd_sb_room(need) == 0) {
            _sd_sb_flush(cv);
            if (i > 0) { flushed = 1; }
            # Re-emit the stretch before unit i so its pieces meet unit i inside one fill.
            var j = i;
            var back = 0;
            var going = 1;
            while (going != 0) {
                going = 0;
                if (j > 0) {
                    if (i - j < 16) {
                        if (back < 2 * hw + 3 * SD_ONE) {
                            j = j - 1;
                            back = back + _sd_sb_seglen(run, m, j);
                            going = 1;
                        }
                    }
                }
            }
            while (j < i) {
                _sd_sb_unit(run, m, closed, j, hw, cap, join, ml);
                j = j + 1;
            }
        }
        _sd_sb_unit(run, m, closed, i, hw, cap, join, ml);
        i = i + 1;
    }
    if (closed != 0) {
        if (flushed != 0) {
            # The vertex-0 join just went into a batch that may not hold segment 0's side of it.
            var f = 0;
            var ahead = 0;
            while (f < 16) {
                if (ahead < 2 * hw + 3 * SD_ONE) {
                    if (f < s - 1) {
                        _sd_sb_unit(run, m, closed, f, hw, cap, join, ml);
                        ahead = ahead + _sd_sb_seglen(run, m, f);
                    }
                }
                f = f + 1;
            }
        }
    }
    return 0;
}

# (Re)open a subpath at `cur` when a drawing verb follows a CLOSE: the run restarts at the moveto
# point, as the fill restarts its edges there.
fn _sd_sb_restart(run, run_n, cur): i64 {
    if (run_n == 0) {
        if (cur != 0) {
            store64(run + 0, cur);
            return 1;
        }
    }
    return run_n;
}

# Flag run[n0, n) as one curve verb's flattening: every point is inside the curve but the last,
# the verb's own end point, where the next verb's join style applies.
fn _sd_sb_mark_curve(n0, n): i64 {
    var k = n0;
    while (k < n) {
        store8(_sd_sb_inner + k, 1);
        k = k + 1;
    }
    if (n > n0) { store8(_sd_sb_inner + n - 1, 0); }
    return 0;
}

# ================================================================
# sd_canvas_stroke_path_ex — stroke `path` at `width` (16.16 full width) with cap style `cap`
# (SD_CAP_BUTT | SD_CAP_ROUND | SD_CAP_SQUARE), join style `join` (SD_JOIN_MITER |
# SD_JOIN_ROUND | SD_JOIN_BEVEL) and `miter_limit` (16.16 ratio, SVG stroke-miterlimit; SVG's
# default is 4.0 = 4 * SD_ONE; used only by SD_JOIN_MITER), MAX-combined into `cv`'s coverage.
#
# Returns SADISH_ERR_BOUNDS for cv == 0 or an unknown cap/join (nothing drawn),
# SADISH_ERR_EMPTY_PATH for a 0 or verb-less path, SADISH_OK otherwise — width <= 0 draws nothing.
# ⚠ SD_CAP_ROUND + SD_JOIN_ROUND IS sd_canvas_stroke_path, exactly — and so, alone among the nine
# pairs, keeps its 0.4.0 geometry: a drawing verb after CLOSE continues the closed run instead of
# starting at the moveto point, and pieces meet by per-pass MAX (a pixel two of them split reads
# the larger part, not the sum). Semantics + bounds: the header of this file.
# ================================================================
# @public
fn sd_canvas_stroke_path_ex(cv, path, width, cap, join, miter_limit): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (path == 0) { return SADISH_ERR_EMPTY_PATH; }
    var n_verbs = sd_path_verb_count(path);
    if (n_verbs == 0) { return SADISH_ERR_EMPTY_PATH; }
    if (cap < SD_CAP_BUTT) { return SADISH_ERR_BOUNDS; }
    if (cap > SD_CAP_SQUARE) { return SADISH_ERR_BOUNDS; }
    if (join < SD_JOIN_MITER) { return SADISH_ERR_BOUNDS; }
    if (join > SD_JOIN_BEVEL) { return SADISH_ERR_BOUNDS; }
    if (cap == SD_CAP_ROUND) {
        if (join == SD_JOIN_ROUND) { return sd_canvas_stroke_path(cv, path, width); }
    }
    var hw = sd_asr(width, 1);
    if (hw <= 0) { return SADISH_OK; }
    var ml = miter_limit;
    if (ml < SD_ONE) { ml = SD_ONE; }
    if (ml > SD_MITER_LIMIT_MAX) { ml = SD_MITER_LIMIT_MAX; }
    var tol = SD_ONE >> 2;

    # The stroker's run/fbuf/fctx (raster.cyr) stay live across the batch flushes; the batch is
    # this file's own scratch.
    _sd_scratch_init();
    _sd_sb_init();                      # the batch is empty: every call ends in _sd_sb_flush
    var run = _sd_stroke_run;
    var run_n = 0;
    var fbuf = _sd_stroke_fbuf;
    var fctx = _sd_stroke_fctx;

    var verbs = load64(path + SD_PATH_VERBS_OFFSET);
    var points = load64(path + SD_PATH_POINTS_OFFSET);
    var cur = 0;
    var start = 0;
    var vi = 0;
    var pi = 0;
    while (vi < n_verbs) {
        var verb = load64(verbs + vi * 8);
        if (verb == SD_VERB_MOVETO) {
            if (run_n > 0) { _sd_sb_subpath(cv, run, run_n, 0, hw, cap, join, ml); }
            cur = load64(points + pi * 8);
            start = cur;
            store64(run + 0, cur);
            run_n = 1;
            pi = pi + 1;
        }
        if (verb == SD_VERB_LINETO) {
            run_n = _sd_sb_restart(run, run_n, cur);
            cur = load64(points + pi * 8);
            if (run_n < SD_FLATTEN_CAP) {
                store64(run + run_n * 8, cur);
                store8(_sd_sb_inner + run_n, 0);
                run_n = run_n + 1;
            }
            pi = pi + 1;
        }
        if (verb == SD_VERB_QUADTO) {
            run_n = _sd_sb_restart(run, run_n, cur);
            var qc = load64(points + pi * 8);
            var qe = load64(points + (pi + 1) * 8);
            store64(fctx + 0, fbuf);
            store64(fctx + 8, 0);
            store64(fctx + 16, SD_FLATTEN_CAP);
            sd_flatten_quad(fctx, cur, qc, qe, tol, SD_FLATTEN_MAX_DEPTH);
            var qn0 = run_n;
            run_n = sd_stroke_append(run, run_n, fctx);
            _sd_sb_mark_curve(qn0, run_n);
            cur = qe;
            pi = pi + 2;
        }
        if (verb == SD_VERB_CUBICTO) {
            run_n = _sd_sb_restart(run, run_n, cur);
            var k1 = load64(points + pi * 8);
            var k2 = load64(points + (pi + 1) * 8);
            var ke = load64(points + (pi + 2) * 8);
            store64(fctx + 0, fbuf);
            store64(fctx + 8, 0);
            store64(fctx + 16, SD_FLATTEN_CAP);
            sd_flatten_cubic(fctx, cur, k1, k2, ke, tol, SD_FLATTEN_MAX_DEPTH);
            var cn0 = run_n;
            run_n = sd_stroke_append(run, run_n, fctx);
            _sd_sb_mark_curve(cn0, run_n);
            cur = ke;
            pi = pi + 3;
        }
        if (verb == SD_VERB_CLOSE) {
            if (run_n > 0) { _sd_sb_subpath(cv, run, run_n, 1, hw, cap, join, ml); }
            run_n = 0;
            cur = start;
        }
        vi = vi + 1;
    }
    if (run_n > 0) { _sd_sb_subpath(cv, run, run_n, 0, hw, cap, join, ml); }
    _sd_sb_flush(cv);
    return SADISH_OK;
}

# --- paint.cyr ---

# @public — sadish gradient paint: linear + radial, multi-stop, pad / repeat / reflect.
#
# paint.cyr — an SdGradient is a PAINT: a colour for every point of canvas space. It is built once
# (constructor + stops + spread) and composited through a canvas's coverage with
# sd_canvas_blit_paint_at, which is sd_canvas_blit_at with the solid colour replaced by the paint.
#
#   var g = sd_gradient_linear(x0, y0, x1, y1);    # or sd_gradient_radial(cx, cy, r) — all 16.16
#   sd_gradient_add_stop(g, 0, sd_rgb(255, 0, 0));
#   sd_gradient_add_stop(g, SD_ONE, sd_rgb(0, 0, 255));
#   sd_gradient_set_spread(g, SD_SPREAD_REFLECT);  # default SD_SPREAD_PAD
#   sd_canvas_blit_paint_at(cv, surface, g, dx, dy);
#
# THE CONTRACT.
#   · Geometry is in CANVAS pixel space: moving the canvas with (dx, dy) moves the paint with it.
#   · Each pixel is sampled at its CENTRE (x + 0.5, y + 0.5). ⚠ The legacy
#     sd_canvas_blit_gradient samples the top-left CORNER (x, y) with whole-pixel endpoints; the two
#     are deliberately not interchangeable, and the legacy fn is untouched.
#   · Linear: t = ((p - p0) · (p1 - p0)) / |p1 - p0|^2.  Radial: t = |p - c| / r.
#   · t is EXACT at every pixel: a pixel reads floor(t * 2^16) — linear steps floor(t * 2^32) WITH
#     its remainder, radial takes its root to 16 fraction bits — so a pixel centre that lies
#     exactly on a stop takes that stop, on any axis length, and every pixel paints
#     sd_gradient_color_at of its spread-mapped floor(t * 2^16).
#   · Spread maps t into [0, 1]: PAD clamps, REPEAT takes fract(t) (floor-based, so t = -0.25 reads
#     0.75), REFLECT is the period-2 triangle wave (t = -0.25 and t = 1.75 both read 0.25). REFLECT
#     mirrors the exact t, so floor(2 - t) is taken as 2 - ceil(t), not 2 - floor(t).
#   · Stops: offset 16.16, clamped to [0, SD_ONE]; kept sorted by a STABLE insert, so stops may be
#     added in any order and equal offsets keep insertion order — two stops at one offset are a
#     hard transition, and t >= offset takes the LATER one. ⚠ SVG instead raises an out-of-order
#     offset to its predecessor's (document order); a consumer that wants that clamps before adding.
#   · Colours are 0xAARRGGBB under the LEGACY alpha rule (sd_alpha_of: an alpha byte of 0 is
#     OPAQUE). Interpolation is per channel, alpha included, in STRAIGHT (non-premultiplied) values —
#     SVG's default. The source alpha of a pixel is coverage * interpolated_alpha / 255, then exactly
#     sd_canvas_blit_at's src-over: every pixel with coverage != 0 is written and gets dst alpha 255,
#     even when that product rounds to 0 (its colour bytes then come back unchanged). ⇒ An opaque
#     one-stop gradient paints the same bytes as sd_canvas_blit_at with that colour.
#   · Zero stops paint NOTHING and return SADISH_OK (SVG: as if the paint were 'none'); one stop is
#     solid. A zero-length linear axis — |p1 - p0| < 2^-8 px — and a radius r <= 0 paint the colour
#     at t = 1 everywhere, which is the LAST stop (SVG). ⚠ The 2^-8 px floor is sadish's, not SVG's:
#     below it t * 2^32 would leave i64 inside the precision bound.
#
# ⭐ THE RAMP. Stops are resolved into a 1025-entry lookup table (4 B each, 0xAARRGGBB with the
# ACTUAL alpha) inside the gradient, rebuilt lazily when a stop is added. Entry i is the colour at
# EXACTLY t = i/1024, and a pixel reads the entry at floor(t * 1024) — no stop search. What that
# buys and what it costs:
#   · A cell (i/1024, (i+1)/1024) with a stop strictly INSIDE it is marked (its entry is 0 — alpha
#     byte 0, which no real colour has) and a pixel landing there evaluates the stops from its 16.16 t.
#     ⇒ Hard stops and bands narrower than a cell land on EXACTLY the pixels whose t >= offset, at
#     any axis length (a 0.3 stop on a 4096 px axis flips at pixel 1229; a 3.5 px band keeps its 4
#     pixels) — asserted in programs/paint_test.cyr. At most one cell per stop pays the search; a
#     stop exactly ON a cell edge marks nothing (the entry past it already starts there).
#   · The endpoints are exact: t <= 0 reads the colour at 0, t >= 1 (PAD) the colour at 1.
#   · A SMOOTH stretch (a cell holding no stop) reads the colour at the cell's left edge: it lags
#     the analytic colour by less than one cell (gradient length / 1024), i.e. by less than the
#     colour change across one cell — under 1/4 level for a full-range 2-stop ramp. On a 256 px
#     axis from a pixel boundary every centre lands ON an entry, so the paint there is exact.
#   · Spread is applied to t BEFORE the lookup, so set_spread never rebuilds anything.
#   · MEASURED (256x256 full coverage, 50 blits, this host): linear PAD 14.2 ns/px — the legacy
#     2-stop sd_canvas_blit_gradient is 13.7, the solid sd_canvas_blit_at 7.0; radial 44.3 ns/px,
#     most of it the per-pixel root (16 ns per _sd_paint_isqrt; sd_isqrt 82) and the exact 16-bit
#     fraction (an accumulated-t / floor-root version measured 13.8 and 35.1 in the same run).
#
# ⚠ PRECISION BOUND. Every gradient coordinate must lie within ±16,383 px and every canvas pixel
# centre below 16,383 px (16.16 magnitude < 2^30), so any difference between them is < 2^31 raw and
# any product of two, or sum of two such products, is < 2^63. Within it:
#   · Linear works in t * 2^32. N = (centre - p0) · d is long-divided ONCE per blit into
#     floor(N * 2^32 / |d|^2) and its remainder; the per-pixel and per-row steps
#     floor(2^48 * d / |d|^2) carry their remainders like a line DDA, so t * 2^32 is floor-exact at
#     every pixel. The division never doubles a remainder past |d|^2 (< 2^63): it compares
#     rem >= b - rem. With |d| >= 2^-8 px, |t| < 2^23 and |t * 2^32| < 2^55. (A 16.16 dot product
#     scaled by 2^16 overflows once |p - p0| * |d| passes 2^15 px^2 — 182 px by 182 px — which is
#     why t is never formed that way.)
#   · Radial squares a < 2^31 raw difference per axis (sum < 2^63) and takes floor(sqrt(d^2) * 2^16)
#     exactly with i64 products (_sd_paint_radial_t); t = that / r, < 2^48.
#   · Outside the bound the COLOURS may be wrong, but the ramp index is always clamped (PAD) or
#     masked (REPEAT/REFLECT) into the table: no input reads or writes out of bounds.
#
# ⚠ ALLOCATION. The gradient object (88 B), its stops (16 B each, doubling from 4, like
# sd_path_grow) and the ramp (4,100 B) come from sd_alloc — MEASURED 4,256 B for a constructed
# gradient, all of it on the consumer's hook when one is set. A blit allocates NOTHING, not even on
# its first call (the ramp is rebuilt in place): MEASURED 0 B on the heap and 0 B on an arena hook,
# asserted exactly in programs/paint_test.cyr. ⛔ A gradient made under an arena hook dies with that
# arena's reset, exactly like a path.
# ⚠ SINGLE-THREADED, as the rest of the rasterizer: the lazy ramp rebuild writes into the gradient
# from inside a blit or sd_gradient_color_at, and the division helpers hand back their second result
# through a module global.

# ---- kinds + spread modes ----------------------------------------
var SD_GRADIENT_LINEAR = 0;
var SD_GRADIENT_RADIAL = 1;
var SD_SPREAD_PAD     = 0;
var SD_SPREAD_REPEAT  = 1;
var SD_SPREAD_REFLECT = 2;

# The ramp: 2^10 cells over t in [0, 1], stored as N + 1 entries so t = 1 has its own.
var SD_GRADIENT_RAMP_BITS = 10;
var SD_GRADIENT_RAMP_N    = 1024;
# Initial stop capacity; sd_gradient_add_stop doubles it on overflow.
var SD_GRADIENT_STOP_CAP  = 4;

# ================================================================
# SdGradient (88 bytes):
#   +0:  kind      (SD_GRADIENT_LINEAR | SD_GRADIENT_RADIAL)
#   +8:  spread    (SD_SPREAD_*)
#   +16: x0 | cx   (16.16)
#   +24: y0 | cy   (16.16)
#   +32: x1 | r    (16.16)
#   +40: y1 | 0    (16.16)
#   +48: stops     (ptr — cap * 16 B, sorted: +0 offset 16.16, +8 colour as given)
#   +56: n_stops   (i64)
#   +64: cap       (i64 — stops the block holds)
#   +72: ramp      (ptr — (SD_GRADIENT_RAMP_N + 1) * 4 B, 0xAARRGGBB, actual alpha; 0 = marked cell)
#   +80: dirty     (i64 — 1 = stops changed since the ramp was built)
# ================================================================
var SD_GRADIENT_KIND_OFFSET   = 0;
var SD_GRADIENT_SPREAD_OFFSET = 8;
var SD_GRADIENT_A_OFFSET      = 16;
var SD_GRADIENT_B_OFFSET      = 24;
var SD_GRADIENT_C_OFFSET      = 32;
var SD_GRADIENT_D_OFFSET      = 40;
var SD_GRADIENT_STOPS_OFFSET  = 48;
var SD_GRADIENT_NSTOPS_OFFSET = 56;
var SD_GRADIENT_CAP_OFFSET    = 64;
var SD_GRADIENT_RAMP_OFFSET   = 72;
var SD_GRADIENT_DIRTY_OFFSET  = 80;
var SD_GRADIENT_SIZE          = 88;

# The second result of _sd_paint_divq (the remainder) and _sd_paint_radial_t (1 = inexact).
var _sd_paint_rem = 0;

fn _sd_gradient_new(kind, a, b, c, d): i64 {
    var g = sd_alloc(SD_GRADIENT_SIZE);
    if (g == 0) { return 0; }
    var stops = sd_alloc(SD_GRADIENT_STOP_CAP * 16);
    if (stops == 0) { return 0; }
    var ramp = sd_alloc((SD_GRADIENT_RAMP_N + 1) * 4);
    if (ramp == 0) { return 0; }
    store64(g + SD_GRADIENT_KIND_OFFSET, kind);
    store64(g + SD_GRADIENT_SPREAD_OFFSET, SD_SPREAD_PAD);
    store64(g + SD_GRADIENT_A_OFFSET, a);
    store64(g + SD_GRADIENT_B_OFFSET, b);
    store64(g + SD_GRADIENT_C_OFFSET, c);
    store64(g + SD_GRADIENT_D_OFFSET, d);
    store64(g + SD_GRADIENT_STOPS_OFFSET, stops);
    store64(g + SD_GRADIENT_NSTOPS_OFFSET, 0);
    store64(g + SD_GRADIENT_CAP_OFFSET, SD_GRADIENT_STOP_CAP);
    store64(g + SD_GRADIENT_RAMP_OFFSET, ramp);
    store64(g + SD_GRADIENT_DIRTY_OFFSET, 1);
    return g;
}

# @public — a linear gradient along (x0, y0) -> (x1, y1), 16.16 canvas coordinates. No stops yet;
# spread PAD. Returns the SdGradient ptr, or 0 on OOM.
fn sd_gradient_linear(x0, y0, x1, y1): i64 {
    return _sd_gradient_new(SD_GRADIENT_LINEAR, x0, y0, x1, y1);
}

# @public — a radial gradient centred on (cx, cy) with radius r, all 16.16 canvas coordinates;
# t = distance / r. No stops yet; spread PAD. Returns the SdGradient ptr, or 0 on OOM.
fn sd_gradient_radial(cx, cy, r): i64 {
    return _sd_gradient_new(SD_GRADIENT_RADIAL, cx, cy, r, 0);
}

# @public
fn sd_gradient_stop_count(g): i64 { return load64(g + SD_GRADIENT_NSTOPS_OFFSET); }

# @public — add a colour stop. `offset` is 16.16, clamped to [0, SD_ONE]; `color` is 0xAARRGGBB
# under the legacy alpha rule (alpha byte 0 == opaque). Inserted after every stop whose offset is
# <= this one (stable). Returns SADISH_OK, SADISH_ERR_BOUNDS for g == 0, or SADISH_ERR_OOM when
# growing the stop block fails (the gradient is unchanged).
fn sd_gradient_add_stop(g, offset, color): i64 {
    if (g == 0) { return SADISH_ERR_BOUNDS; }
    var o = offset;
    if (o < 0) { o = 0; }
    if (o > SD_ONE) { o = SD_ONE; }
    var stops = load64(g + SD_GRADIENT_STOPS_OFFSET);
    var n = load64(g + SD_GRADIENT_NSTOPS_OFFSET);
    var cap = load64(g + SD_GRADIENT_CAP_OFFSET);
    if (n >= cap) {
        var ncap = cap * 2;
        var grown = sd_alloc(ncap * 16);
        if (grown == 0) { return SADISH_ERR_OOM; }
        memcpy(grown, stops, n * 16);
        stops = grown;
        store64(g + SD_GRADIENT_STOPS_OFFSET, stops);
        store64(g + SD_GRADIENT_CAP_OFFSET, ncap);
    }
    # Shift every stop with a strictly GREATER offset up one slot; equal offsets stay in front.
    var i = n;
    var stop = 0;
    while (stop == 0) {
        if (i == 0) {
            stop = 1;
        } else {
            var prev = stops + (i - 1) * 16;
            if (load64(prev) > o) {
                store64(prev + 16, load64(prev));
                store64(prev + 24, load64(prev + 8));
                i = i - 1;
            } else {
                stop = 1;
            }
        }
    }
    store64(stops + i * 16, o);
    store64(stops + i * 16 + 8, color);
    store64(g + SD_GRADIENT_NSTOPS_OFFSET, n + 1);
    store64(g + SD_GRADIENT_DIRTY_OFFSET, 1);
    return SADISH_OK;
}

# @public — set the spread mode (SD_SPREAD_PAD | _REPEAT | _REFLECT). Returns SADISH_OK, or
# SADISH_ERR_BOUNDS for g == 0 / an unknown mode (the gradient is unchanged).
fn sd_gradient_set_spread(g, spread): i64 {
    if (g == 0) { return SADISH_ERR_BOUNDS; }
    if (spread < SD_SPREAD_PAD) { return SADISH_ERR_BOUNDS; }
    if (spread > SD_SPREAD_REFLECT) { return SADISH_ERR_BOUNDS; }
    store64(g + SD_GRADIENT_SPREAD_OFFSET, spread);
    return SADISH_OK;
}

# The colour of `n` sorted stops at t (16.16, [0, SD_ONE]), given k = the LAST stop whose offset is
# <= t (0 when t lies before every stop): stop k's colour before the first stop and from the last
# one on, otherwise the per-channel interpolation to stop k + 1, rounded to nearest. 0xAARRGGBB with
# the actual alpha.
fn _sd_gradient_lerp(stops, n, k, t): i64 {
    var lo = stops + k * 16;
    var c = load64(lo + 8);
    var e = sd_rgba(sd_color_r(c), sd_color_g(c), sd_color_b(c), sd_alpha_of(c));
    if (t < load64(lo)) { return e; }
    if (k + 1 >= n) { return e; }
    # load64(lo) <= t < offset[k+1], so the span is > 0.
    var hi = lo + 16;
    var c1 = load64(hi + 8);
    var span = load64(hi) - load64(lo);
    var w1 = t - load64(lo);
    var w0 = span - w1;
    var half = span >> 1;
    var r = (sd_color_r(c) * w0 + sd_color_r(c1) * w1 + half) / span;
    var gg = (sd_color_g(c) * w0 + sd_color_g(c1) * w1 + half) / span;
    var b = (sd_color_b(c) * w0 + sd_color_b(c1) * w1 + half) / span;
    var a = (sd_alpha_of(c) * w0 + sd_alpha_of(c1) * w1 + half) / span;
    return sd_rgba(r, gg, b, a);
}

# The colour at t (16.16, [0, SD_ONE]) by a stop search — for t inside a marked ramp cell.
fn _sd_gradient_eval(g, t): i64 {
    var stops = load64(g + SD_GRADIENT_STOPS_OFFSET);
    var n = load64(g + SD_GRADIENT_NSTOPS_OFFSET);
    var k = 0;
    var adv = 0;
    while (adv == 0) {
        if (k + 1 >= n) {
            adv = 1;
        } else {
            if (load64(stops + (k + 1) * 16) <= t) { k = k + 1; } else { adv = 1; }
        }
    }
    return _sd_gradient_lerp(stops, n, k, t);
}

# Resolve the sorted stops into the ramp: entry i = the colour at t = i * 64 (16.16), or 0 (alpha
# byte 0: no real entry has it) when a stop lies strictly inside (i * 64, (i + 1) * 64). Requires
# n_stops >= 1. Entry 1024 is never marked: no offset exceeds SD_ONE.
fn _sd_gradient_build_ramp(g): i64 {
    var stops = load64(g + SD_GRADIENT_STOPS_OFFSET);
    var n = load64(g + SD_GRADIENT_NSTOPS_OFFSET);
    var ramp = load64(g + SD_GRADIENT_RAMP_OFFSET);
    var cell = SD_ONE >> SD_GRADIENT_RAMP_BITS;
    var k = 0;                       # the LAST stop whose offset <= t (0 while t is before them all)
    var i = 0;
    while (i <= SD_GRADIENT_RAMP_N) {
        var t = i * cell;
        var adv = 0;
        while (adv == 0) {
            if (k + 1 >= n) {
                adv = 1;
            } else {
                if (load64(stops + (k + 1) * 16) <= t) { k = k + 1; } else { adv = 1; }
            }
        }
        var e = _sd_gradient_lerp(stops, n, k, t);
        # The first stop with an offset > t: k + 1, or k itself while t is before every stop.
        var nxt = k + 1;
        if (load64(stops + k * 16) > t) { nxt = k; }
        if (nxt < n) {
            if (load64(stops + nxt * 16) < t + cell) { e = 0; }
        }
        store32(ramp + i * 4, e);
        i = i + 1;
    }
    store64(g + SD_GRADIENT_DIRTY_OFFSET, 0);
    return 0;
}

# Map t = floor(true_t * one) (`one` a power of two) into [0, one] under `spread`, still a floor.
# `frac` is 1 when true_t * one is not an integer. Two's-complement `&` IS the floor-based modulo, so
# negative t needs no special case; REFLECT mirrors through the ceiling, floor(2 - x) = 2 - ceil(x).
fn _sd_gradient_spread(spread, t, frac, one): i64 {
    if (spread == SD_SPREAD_REPEAT) { return t & (one - 1); }
    if (spread == SD_SPREAD_REFLECT) {
        var v = t & (one * 2 - 1);
        var c = v + frac;
        if (c > one) { v = one * 2 - c; }
        return v;
    }
    if (t < 0) { return 0; }
    if (t > one) { return one; }
    return t;
}

# @public — the colour the paint has at parameter `t` (16.16, any value; spread applied), as
# 0xAARRGGBB — exactly what a blit paints for a pixel whose t is `t`: the ramp entry, or the stop
# evaluation in a cell that holds a stop. Byte 3 is the ACTUAL interpolated alpha, 1..255: it is
# never 0, because no stop can express 0 (legacy rule) and interpolation stays between its stops —
# so the value also reads back unchanged through sd_alpha_of. Read it with sd_color_a. Returns 0
# for g == 0 or a gradient with no stops; a caller tells that apart from a colour by
# sd_gradient_stop_count (0), never by the value.
fn sd_gradient_color_at(g, t): i64 {
    if (g == 0) { return 0; }
    if (load64(g + SD_GRADIENT_NSTOPS_OFFSET) == 0) { return 0; }
    if (load64(g + SD_GRADIENT_DIRTY_OFFSET) != 0) { _sd_gradient_build_ramp(g); }
    var u = _sd_gradient_spread(load64(g + SD_GRADIENT_SPREAD_OFFSET), t, 0, SD_ONE);
    var ramp = load64(g + SD_GRADIENT_RAMP_OFFSET);
    var e = load32(ramp + (u >> (SD_SHIFT - SD_GRADIENT_RAMP_BITS)) * 4);
    if (e == 0) { e = _sd_gradient_eval(g, u); }
    return e;
}

# floor(n * 2^k / b) for b > 0, by restoring binary long division; the remainder, in [0, b), is left
# in _sd_paint_rem. Exact, and no intermediate exceeds b (< 2^63) — a remainder is doubled only when
# that stays below b — as long as the quotient itself fits (the direct product would not).
fn _sd_paint_divq(n, b, k): i64 {
    var neg = 0;
    var rem = n;
    if (rem < 0) { rem = 0 - rem; neg = 1; }
    var q = rem / b;
    rem = rem - q * b;
    var i = 0;
    while (i < k) {
        q = q << 1;
        if (rem >= b - rem) {
            rem = rem - (b - rem);
            q = q + 1;
        } else {
            rem = rem + rem;
        }
        i = i + 1;
    }
    if (neg != 0) {
        q = 0 - q;
        if (rem != 0) {
            q = q - 1;
            rem = b - rem;
        }
    }
    _sd_paint_rem = rem;
    return q;
}

# floor(sqrt(n)) — the same value as sd_isqrt, which starts Newton at n itself (~log2(n)/2 halving
# divisions before it converges). This one starts at 2^ceil(bits/2), within 2x of the root, so it
# converges in a handful of divisions: it runs once per covered pixel of a radial blit.
fn _sd_paint_isqrt(n): i64 {
    if (n <= 0) { return 0; }
    var v = n;
    var bits = 1;
    if (v >= 4294967296) { v = v >> 32; bits = bits + 32; }
    if (v >= 65536) { v = v >> 16; bits = bits + 16; }
    if (v >= 256) { v = v >> 8; bits = bits + 8; }
    if (v >= 16) { v = v >> 4; bits = bits + 4; }
    if (v >= 4) { v = v >> 2; bits = bits + 2; }
    if (v >= 2) { bits = bits + 1; }
    var x = 1 << ((bits + 1) >> 1);   # n < 2^bits  ⇒  sqrt(n) < x
    var y = (x + n / x) >> 1;
    while (y < x) {
        x = y;
        y = (x + n / x) >> 1;
    }
    return x;
}

# floor(sqrt(d2) * 2^16 / r) for 0 <= d2 < 2^63 and r > 0 — a radial pixel's t in 16.16, EXACT.
# _sd_paint_rem is left 1 when sqrt(d2) * 2^16 / r is not an integer, else 0.
# The root is taken to 16 fraction bits, R = floor(sqrt(d2 * 2^32)), and t = R / r (a floor of a
# floor is the floor). Below 2^31, d2 * 2^32 fits and R is its root. Above it, with
# s = floor(sqrt(d2)) and m = d2 - s^2, the fraction bits are f = floor(m * 2^16 / (sqrt(d2) + s)),
# which is floor(m * 2^16 / 2s) or one less: the two quotients differ by < 2^16 / (2s + 1), under 1
# for any s >= 32,768, and here s >= 46,340. (s * 2^16 + f)^2 <= d2 * 2^32 decides it, as
# f^2 <= ((m * 2^16) mod 2s) * 2^16 — i64 throughout, where the direct square needs ~96 bits.
# (m == 2s makes the quotient 65536 with remainder 0, which that test takes down to 65535.)
fn _sd_paint_radial_t(d2, r): i64 {
    var root = 0;
    var inexact = 0;
    if (d2 < 2147483648) {
        var big = d2 << 32;
        root = _sd_paint_isqrt(big);
        if (root * root != big) { inexact = 1; }
    } else {
        var s = _sd_paint_isqrt(d2);
        var num = (d2 - s * s) << 16;
        var f = num / (2 * s);
        if (f * f > ((num - f * 2 * s) << 16)) { f = f - 1; }
        root = (s << 16) + f;
        if (num != 0) { inexact = 1; }
    }
    var t = root / r;
    if (t * r != root) { inexact = 1; }
    _sd_paint_rem = inexact;
    return t;
}

# ================================================================
# sd_canvas_blit_paint_at — composite the canvas coverage onto `surface` with the canvas's (0,0) at
# surface pixel (dx, dy), the source colour of each pixel coming from gradient `g` sampled at the
# pixel's centre in CANVAS space. Source alpha = coverage * paint_alpha / 255; src-over as
# sd_canvas_blit_at: every pixel with coverage != 0 is written, dst alpha byte 255. Clipped to the
# surface on every side; rows addressed by sd_surface_stride. Returns SADISH_OK (also for a gradient
# with no stops, which paints nothing), or SADISH_ERR_BOUNDS for a null cv / surface / g.
# ================================================================
# @public
fn sd_canvas_blit_paint_at(cv, surface, g, dx, dy): i64 {
    if (cv == 0) { return SADISH_ERR_BOUNDS; }
    if (surface == 0) { return SADISH_ERR_BOUNDS; }
    if (g == 0) { return SADISH_ERR_BOUNDS; }
    if (load64(g + SD_GRADIENT_NSTOPS_OFFSET) == 0) { return SADISH_OK; }
    if (load64(g + SD_GRADIENT_DIRTY_OFFSET) != 0) { _sd_gradient_build_ramp(g); }
    var ramp = load64(g + SD_GRADIENT_RAMP_OFFSET);
    var spread = load64(g + SD_GRADIENT_SPREAD_OFFSET);
    var cw = sd_canvas_width(cv);
    var ch = sd_canvas_height(cv);
    var covbuf = sd_canvas_coverage(cv);
    var covstride = sd_canvas_stride(cv);
    var sw = sd_surface_width(surface);
    var sh = sd_surface_height(surface);
    var spx = sd_surface_pixels(surface);
    var pitch = sd_surface_stride(surface);

    # Clip the canvas rect [dx, dx+cw) x [dy, dy+ch) to the surface (canvas coordinates).
    var x0 = 0;
    if (dx < 0) { x0 = 0 - dx; }
    var y0 = 0;
    if (dy < 0) { y0 = 0 - dy; }
    var x1 = cw;
    if (dx + x1 > sw) { x1 = sw - dx; }
    var y1 = ch;
    if (dy + y1 > sh) { y1 = sh - dy; }

    # mode: 0 linear, 1 radial, 2 solid (the degenerate cases: the colour at t = 1, the last stop).
    var mode = 2;
    var one32 = 1 << 32;
    var gx = load64(g + SD_GRADIENT_A_OFFSET);
    var gy = load64(g + SD_GRADIENT_B_OFFSET);
    var rad = load64(g + SD_GRADIENT_C_OFFSET);
    # Linear DDA, all in t * 2^32 = quotient + remainder / |d|^2: (qx, rx) per pixel step, (qy, ry)
    # per row, (rq, rr) at the row's first pixel; cx / cy = l2 - rx / l2 - ry, so carrying a
    # remainder never forms a sum >= l2.
    var l2 = 0;
    var qx = 0;
    var rx = 0;
    var cx = 0;
    var qy = 0;
    var ry = 0;
    var cy = 0;
    var rq = 0;
    var rr = 0;
    if (load64(g + SD_GRADIENT_KIND_OFFSET) == SD_GRADIENT_LINEAR) {
        var ddx = load64(g + SD_GRADIENT_C_OFFSET) - gx;
        var ddy = load64(g + SD_GRADIENT_D_OFFSET) - gy;
        l2 = ddx * ddx + ddy * ddy;
        if (l2 >= 65536) {
            mode = 0;
            qx = _sd_paint_divq(ddx, l2, 48);
            rx = _sd_paint_rem;
            cx = l2 - rx;
            qy = _sd_paint_divq(ddy, l2, 48);
            ry = _sd_paint_rem;
            cy = l2 - ry;
            var ex = (x0 << SD_SHIFT) + (SD_ONE >> 1) - gx;
            var ey = (y0 << SD_SHIFT) + (SD_ONE >> 1) - gy;
            rq = _sd_paint_divq(ex * ddx + ey * ddy, l2, 32);
            rr = _sd_paint_rem;
        }
    } else {
        if (rad > 0) { mode = 1; }
    }
    var solid = load32(ramp + SD_GRADIENT_RAMP_N * 4);

    var y = y0;
    while (y < y1) {
        var tq = rq;
        var tr = rr;
        var ey2 = 0;
        if (mode == 1) {
            var eyr = (y << SD_SHIFT) + (SD_ONE >> 1) - gy;
            ey2 = eyr * eyr;
        }
        var x = x0;
        while (x < x1) {
            var a = load8(covbuf + y * covstride + x);
            if (a != 0) {
                var e = solid;
                if (mode == 0) {
                    var u = tq;
                    if (spread == SD_SPREAD_PAD) {
                        if (u < 0) { u = 0; }
                        if (u > one32) { u = one32; }
                    } else {
                        var fr = 0;
                        if (tr != 0) { fr = 1; }
                        u = _sd_gradient_spread(spread, tq, fr, one32);
                    }
                    e = load32(ramp + (u >> 22) * 4);
                    if (e == 0) { e = _sd_gradient_eval(g, u >> 16); }
                }
                if (mode == 1) {
                    var exr = (x << SD_SHIFT) + (SD_ONE >> 1) - gx;
                    var t16 = _sd_paint_radial_t(exr * exr + ey2, rad);
                    var u16 = _sd_gradient_spread(spread, t16, _sd_paint_rem, SD_ONE);
                    e = load32(ramp + (u16 >> 6) * 4);
                    if (e == 0) { e = _sd_gradient_eval(g, u16); }
                }
                var sa = a;
                var pa = (e >> 24) & 255;
                if (pa != 255) { sa = (a * pa) / 255; }
                var sr = (e >> 16) & 255;
                var sg = (e >> 8) & 255;
                var sb = e & 255;
                var off = (y + dy) * pitch + (x + dx) * 4;
                if (sa == 255) {
                    store8(spx + off, sb);
                    store8(spx + off + 1, sg);
                    store8(spx + off + 2, sr);
                    store8(spx + off + 3, 255);
                } else {
                    var ia = 255 - sa;
                    store8(spx + off, (sb * sa + load8(spx + off) * ia) / 255);
                    store8(spx + off + 1, (sg * sa + load8(spx + off + 1) * ia) / 255);
                    store8(spx + off + 2, (sr * sa + load8(spx + off + 2) * ia) / 255);
                    store8(spx + off + 3, 255);
                }
            }
            if (tr >= cx) {
                tr = tr - cx;
                tq = tq + qx + 1;
            } else {
                tr = tr + rx;
                tq = tq + qx;
            }
            x = x + 1;
        }
        if (rr >= cy) {
            rr = rr - cy;
            rq = rq + qy + 1;
        } else {
            rr = rr + ry;
            rq = rq + qy;
        }
        y = y + 1;
    }
    return SADISH_OK;
}

# @public — sd_canvas_blit_paint_at with the canvas at the surface origin.
fn sd_canvas_blit_paint(cv, surface, g): i64 {
    return sd_canvas_blit_paint_at(cv, surface, g, 0, 0);
}
